<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SPEAK GATE AUDIT: nightly at 01:50, an Opus session re-checks every live
  gate decision of the day that ended and leaves lessons for the gate
  (plugins/speak-gate/bin/speak-gate-audit.mjs). Runs for one week, then
  exits at once each night and can be removed.
  launchd, not cron: it forks `claude -p` (GUI keychain's Max login).
  Installed by `jori plugin sync` with the speak-gate plugin.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.claude.speak-gate-audit</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__JORI_TOOLS__/plugins/speak-gate/bin/speak-gate-audit-trigger</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.local/node/bin:__HOME__/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__JORI_TOOLS__/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__JORI_TOOLS__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>50</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__JORI_TOOLS__/agent/logs/speak-gate-audit-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__JORI_TOOLS__/agent/logs/speak-gate-audit-launchd.log</string>
</dict>
</plist>
