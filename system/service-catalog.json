{
  "_comment": "Outside services the kernel knows how to use, for the control room's Services & keys page (lib/control/state.mjs). `env` is a list of .env key-name prefixes; the page shows which of those keys are set, never their values. `config` names the agent/local/config/<name>.json files that hold the service's non-secret settings. An installation adds its own services with `extend_services` in agent/local/config/service-catalog.json.",
  "services": [
    {
      "name": "Supabase",
      "does": "Database, messages and the memory mirror",
      "group": "Core",
      "env": [
        "SUPABASE_"
      ],
      "config": [
        "supabase"
      ]
    },
    {
      "name": "Gmail",
      "does": "Reading and sending mail through gog",
      "group": "Core",
      "env": [
        "GMAIL_",
        "GOG_"
      ],
      "config": [
        "gmail-auth",
        "gmail-intake"
      ]
    },
    {
      "name": "1Password",
      "does": "Secrets and saved logins",
      "group": "Core",
      "env": [
        "OP_"
      ]
    },
    {
      "name": "Cloudflare Access",
      "does": "Sign-in in front of the memory site and private pages",
