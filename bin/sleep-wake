#!/usr/bin/env node
// sleep-wake — print the user's inferred wake/sleep snapshot for today.
//
// Usage:
//   sleep-wake             human-readable
//   sleep-wake --json      machine-readable
//
// Library: lib/sleep-wake.js — also called from jori-context.js
// for the agents' situation context.

const { inferToday } = require("../lib/sleep-wake.js");

(async () => {
  const argv = process.argv.slice(2);
  const json = argv.includes("--json");
  const snap = await inferToday();
  if (json) {
    console.log(JSON.stringify(snap, null, 2));
    return;
  }
  console.log(`Sleep/Wake Snapshot — ${snap.today} (${snap.tz})\n`);
  if (snap.wake_time_today) {
    console.log(`  Woke today:        ${snap.wake_time_today.hm}  (source: ${snap.wake_time_today.source})`);
  } else {
    console.log(`  Woke today:        — (no signal yet)`);
  }
  if (snap.sleep_time_yesterday) {
    console.log(`  Last active y'day: ${snap.sleep_time_yesterday.hm}  (source: ${snap.sleep_time_yesterday.source})`);
  } else {
    console.log(`  Last active y'day: —`);
  }
  console.log(`  Asleep now?        ${snap.asleep_now ? "yes (no wake signal yet today)" : "no"}`);
  console.log(`  Adaptive window:   sleep after ${snap.adaptive_window.sleep_after_hm}, wake before ${snap.adaptive_window.wake_before_hm}`);
})();
