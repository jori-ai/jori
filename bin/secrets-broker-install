#!/bin/bash
# secrets-broker-install — set up the secrets broker on this Mac (run as root).
# docs/secrets-broker.md § Install.
#
# Root must never run or copy anything the agents can change, so this is NOT
# run from the checkout. The user copies three files into a root-owned staging
# directory, checks their SHA-256 against the hashes they were given, and runs
# this script from there:
#
#   /Library/JoriSecrets/staging/{secrets-broker-install, broker.cjs, policy.json}
#
# It then:
#   - creates the hidden user and group _jorisecrets (no login, no home);
#   - copies node and op into /Library/JoriSecrets/bin, after checking each
#     copy's code signature (Node.js Foundation HX7739G8FX, AgileBits 2BUA8C4S2C);
#   - copies broker.cjs and policy.json from staging;
#   - imports the named keys from an .env file, read as data (never sourced);
#   - installs and starts the LaunchDaemon com.jori.secrets-broker as _jorisecrets.
#
# Usage (as root, from the staging directory):
#   secrets-broker-install --check [--node PATH] [--op PATH]      what it would do; needs no root
#   secrets-broker-install --install [--env FILE --import NAME[,NAME…]] [--node PATH] [--op PATH]
#   secrets-broker-install --update                                re-copy broker.cjs + policy.json from staging, restart
#   secrets-broker-install --set NAME                              add or replace one key (prompted, hidden; or on stdin)
#   secrets-broker-install --remove NAME                           forget one key
#   secrets-broker-install --uninstall                             stop it and delete everything, keys included

set -euo pipefail
umask 022
cd / # the _jorisecrets steps must not inherit a directory that user cannot enter

ROOT=/Library/JoriSecrets
LABEL=com.jori.secrets-broker
PLIST=/Library/LaunchDaemons/$LABEL.plist
SVC=_jorisecrets
NODE_TEAM=HX7739G8FX
OP_TEAM=2BUA8C4S2C
HERE="$(cd "$(dirname "$0")" && pwd -P)"
SUDO_HOME="$(eval echo "~${SUDO_USER:-$(id -un)}")"
NODE_SRC="$SUDO_HOME/.local/node/bin/node"
OP_SRC="/opt/homebrew/bin/op"
ENV_FILE=""
IMPORT=""
MODE=""
NAME=""

die() { echo "secrets-broker-install: $*" >&2; exit 1; }
say() { echo "secrets-broker-install: $*"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check|--install|--update|--uninstall) MODE="${1#--}"; shift ;;
    --set|--remove) MODE="${1#--}"; NAME="${2:-}"; shift 2 ;;
    --env) ENV_FILE="${2:-}"; shift 2 ;;
    --import) IMPORT="${2:-}"; shift 2 ;;
    --node) NODE_SRC="${2:-}"; shift 2 ;;
    --op) OP_SRC="${2:-}"; shift 2 ;;
    *) die "unknown argument $1" ;;
  esac
done
[[ -n "$MODE" ]] || die "usage: --check | --install --env FILE --import NAMES | --update | --set NAME | --remove NAME | --uninstall"

need_root() { [[ "$(id -u)" == 0 ]] || die "run with sudo"; }

# Every file root reads from staging must be root-owned and writable by root only.
check_staging() {
  local f
  for f in "$HERE" "$HERE/secrets-broker-install" "$HERE/broker.cjs" "$HERE/policy.json"; do
    [[ -e "$f" ]] || die "missing $f"
    [[ "$(stat -f %Su "$f")" == root ]] || die "$f is not owned by root; copy the files with sudo first"
    [[ "$(stat -f %Lp "$f")" =~ ^[0-7][0145][0145]$ ]] || die "$f is writable by someone other than root"
  done
  case "$HERE" in "$ROOT/staging") ;; *) die "run this from $ROOT/staging, not $HERE" ;; esac
}

# A copy of a signed binary, checked after copying so nothing can swap it in between.
copy_signed() { # src dst team
  local src dst team real got
  src="$1"; dst="$2"; team="$3"
  real="$(/usr/bin/python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$src")"
  [[ -f "$real" ]] || die "no binary at $src"
  /usr/bin/ditto "$real" "$dst.new"
  /usr/sbin/chown root:wheel "$dst.new"; /bin/chmod 755 "$dst.new"
  /usr/bin/codesign --verify --strict "$dst.new" || { rm -f "$dst.new"; die "$src: code signature does not verify"; }
  got="$(/usr/bin/codesign -dv "$dst.new" 2>&1 | sed -n 's/^TeamIdentifier=//p')"
  [[ "$got" == "$team" ]] || { rm -f "$dst.new"; die "$src: signed by team '$got', expected $team"; }
  /bin/mv -f "$dst.new" "$dst"
  say "copied $(basename "$dst") from $real (team $team)"
}

ensure_user() {
  if /usr/bin/dscl . -read "/Users/$SVC" >/dev/null 2>&1; then say "user $SVC exists"; return; fi
  local id
  for id in $(seq 450 499); do
    if ! /usr/bin/dscl . -list /Users UniqueID | awk '{print $2}' | grep -qx "$id" &&
       ! /usr/bin/dscl . -list /Groups PrimaryGroupID | awk '{print $2}' | grep -qx "$id"; then break; fi
  done
  /usr/bin/dscl . -create "/Groups/$SVC"
  /usr/bin/dscl . -create "/Groups/$SVC" PrimaryGroupID "$id"
  /usr/bin/dscl . -create "/Groups/$SVC" RealName "Jori secrets broker"
  /usr/bin/dscl . -create "/Groups/$SVC" Password "*"
  /usr/bin/dscl . -create "/Users/$SVC"
  /usr/bin/dscl . -create "/Users/$SVC" UniqueID "$id"
  /usr/bin/dscl . -create "/Users/$SVC" PrimaryGroupID "$id"
  /usr/bin/dscl . -create "/Users/$SVC" UserShell /usr/bin/false
  /usr/bin/dscl . -create "/Users/$SVC" NFSHomeDirectory /var/empty
  /usr/bin/dscl . -create "/Users/$SVC" RealName "Jori secrets broker"
  /usr/bin/dscl . -create "/Users/$SVC" Password "*"
  /usr/bin/dscl . -create "/Users/$SVC" IsHidden 1
  say "created user and group $SVC (id $id)"
}

layout() {
  /bin/mkdir -p "$ROOT"/{bin,lib,etc,store,home,run,log}
  /usr/sbin/chown root:wheel "$ROOT" "$ROOT"/{bin,lib,etc}; /bin/chmod 755 "$ROOT" "$ROOT"/{bin,lib,etc}
  /usr/sbin/chown "$SVC:$SVC" "$ROOT"/{store,home}; /bin/chmod 700 "$ROOT"/{store,home}
  /usr/sbin/chown "$SVC:$SVC" "$ROOT"/{run,log}; /bin/chmod 755 "$ROOT"/{run,log}
}

copy_code() {
  /usr/bin/install -o root -g wheel -m 644 "$HERE/broker.cjs" "$ROOT/lib/broker.cjs"
  /usr/bin/install -o root -g wheel -m 644 "$HERE/policy.json" "$ROOT/etc/policy.json"
  say "copied broker.cjs $(shasum -a 256 "$ROOT/lib/broker.cjs" | cut -c1-12)… and policy.json $(shasum -a 256 "$ROOT/etc/policy.json" | cut -c1-12)…"
}

store_set() { # name; value on stdin
  [[ "$1" =~ ^[A-Z][A-Z0-9_]{1,63}$ ]] || die "bad key name $1"
  /usr/bin/sudo -u "$SVC" "$ROOT/bin/node" "$ROOT/lib/broker.cjs" --root "$ROOT" --store-set "$1"
}

import_env() {
  [[ -f "$ENV_FILE" ]] || die "no env file $ENV_FILE"
  local n v
  IFS=',' read -r -a names <<<"$IMPORT"
  for n in "${names[@]}"; do
    [[ "$n" =~ ^[A-Z][A-Z0-9_]{1,63}$ ]] || die "bad key name $n"
    # The value after the first '=', one layer of quotes off; the file is data, never sourced.
    v="$(/usr/bin/awk -v k="$n" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$ENV_FILE")"
    v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
    [[ -n "$v" ]] || die "$n is not in $ENV_FILE"
    printf '%s' "$v" | store_set "$n"
  done
  unset v
}

write_plist() {
  /bin/cat > "$PLIST.new" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$ROOT/bin/node</string><string>$ROOT/lib/broker.cjs</string><string>--root</string><string>$ROOT</string></array>
  <key>UserName</key><string>$SVC</string>
  <key>GroupName</key><string>$SVC</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string><key>HOME</key><string>$ROOT/home</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>$ROOT/log/broker.log</string>
  <key>StandardErrorPath</key><string>$ROOT/log/broker.log</string>
</dict>
</plist>
PLIST
  /usr/sbin/chown root:wheel "$PLIST.new"; /bin/chmod 644 "$PLIST.new"; /bin/mv -f "$PLIST.new" "$PLIST"
}

restart() {
  /bin/launchctl bootout "system/$LABEL" 2>/dev/null || true
  /bin/launchctl bootstrap system "$PLIST"
  local i
  for i in $(seq 1 20); do [[ -S "$ROOT/run/broker.sock" ]] && break; sleep 0.5; done
  [[ -S "$ROOT/run/broker.sock" ]] || die "the broker did not start; see $ROOT/log/broker.log"
  say "health: $(ask '{"op":"health"}')"
}

ask() { /usr/bin/curl -s --max-time 60 --unix-socket "$ROOT/run/broker.sock" -X POST -H 'content-type: application/json' -d "$1" http://broker/v1; }

# A value-free read through op as _jorisecrets for each token the broker
# holds. A helper uses the broker only for a token it holds
# (`secrets-broker available <token>`), so a token whose read fails is removed
# again and that helper keeps using .env.
self_test() {
  local health r
  health="$(ask '{"op":"health"}')"
  if [[ "$health" == *'"logins":true'* ]]; then
    r="$(ask '{"op":"logins.list","category":"Credit Card"}')"
    if [[ "$r" == '{"ok":true,'* ]]; then say "self-test: the Logins token lists the purchase cards"
    else
      /usr/bin/sudo -u "$SVC" "$ROOT/bin/node" "$ROOT/lib/broker.cjs" --root "$ROOT" --store-rm OP_LOGINS_SERVICE_ACCOUNT_TOKEN
      die "self-test FAILED for the Logins token, removed it again ($(printf '%s' "$r" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p' | cut -c1-160)). See $ROOT/log/broker.log"
    fi
  fi
  if [[ "$health" == *'"dev":true'* ]]; then
    r="$(ask '{"op":"dev.site","domain":"broker-selftest.invalid","field":"password"}')"
    if [[ "$r" == *'"code":"not_found"'* ]]; then say "self-test: the Dev token reaches its vault"
    else
      /usr/bin/sudo -u "$SVC" "$ROOT/bin/node" "$ROOT/lib/broker.cjs" --root "$ROOT" --store-rm OP_SERVICE_ACCOUNT_TOKEN
      die "self-test FAILED for the Dev token, removed it again ($(printf '%s' "$r" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p' | cut -c1-160)). See $ROOT/log/broker.log"
    fi
  fi
  [[ "$health" == *':true'* ]] || say "the broker holds no token yet: give it one with --set"
}

case "$MODE" in
  check)
    say "staging: $HERE"
    for f in secrets-broker-install broker.cjs policy.json; do [[ -f "$HERE/$f" ]] && shasum -a 256 "$HERE/$f"; done
    for pair in "$NODE_SRC:$NODE_TEAM" "$OP_SRC:$OP_TEAM"; do
      b="${pair%:*}"; t="${pair##*:}"
      if /usr/bin/codesign --verify --strict "$b" 2>/dev/null && [[ "$(/usr/bin/codesign -dv "$b" 2>&1 | sed -n 's/^TeamIdentifier=//p')" == "$t" ]]; then say "$b: signed by $t"; else say "$b: signature check FAILED (expected $t)"; fi
    done
    /usr/bin/dscl . -read "/Users/$SVC" UniqueID 2>/dev/null || say "user $SVC: would be created"
    [[ -f "$PLIST" ]] && say "installed: $PLIST" || say "not installed yet"
    ;;
  install)
    need_root; check_staging
    [[ -z "$IMPORT" || -n "$ENV_FILE" ]] || die "--import needs --env FILE"
    ensure_user; layout
    copy_signed "$NODE_SRC" "$ROOT/bin/node" "$NODE_TEAM"
    copy_signed "$OP_SRC" "$ROOT/bin/op" "$OP_TEAM"
    copy_code
    [[ -f "$ROOT/log/audit.jsonl" ]] || { /usr/bin/touch "$ROOT/log/audit.jsonl"; /usr/sbin/chown "$SVC:$SVC" "$ROOT/log/audit.jsonl"; /bin/chmod 644 "$ROOT/log/audit.jsonl"; }
    [[ -z "$IMPORT" ]] || import_env
    write_plist; restart; self_test
    ;;
  update)
    need_root; check_staging; copy_code; restart; self_test ;;
  set)
    need_root; [[ -n "$NAME" ]] || die "--set NAME"
    if [[ -t 0 ]]; then
      # Typed or pasted at a terminal: not echoed, never in the shell history.
      IFS= read -rsp "Paste the value for $NAME (hidden), then Return: " VALUE; echo
      [[ -n "$VALUE" ]] || die "empty value"
      printf '%s' "$VALUE" | store_set "$NAME"; unset VALUE
    else
      store_set "$NAME"
    fi
    say "stored $NAME"; self_test ;;
  remove)
    need_root; [[ -n "$NAME" ]] || die "--remove NAME"
    /usr/bin/sudo -u "$SVC" "$ROOT/bin/node" "$ROOT/lib/broker.cjs" --root "$ROOT" --store-rm "$NAME"; say "removed $NAME" ;;
  uninstall)
    need_root
    /bin/launchctl bootout "system/$LABEL" 2>/dev/null || true
    /bin/rm -f "$PLIST"
    /bin/rm -rf "$ROOT"
    /usr/bin/dscl . -delete "/Users/$SVC" 2>/dev/null || true
    /usr/bin/dscl . -delete "/Groups/$SVC" 2>/dev/null || true
    say "removed the broker, its keys and the $SVC user" ;;
esac
