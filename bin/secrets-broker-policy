#!/usr/bin/env node
// secrets-broker-policy — write the secrets broker's policy for this
// installation (docs/secrets-broker.md § Policy).
//
// The broker reads only root-owned files, so its policy is generated here, in
// the agents' checkout, reviewed, hash-checked by the user and copied in by the
// installer. Sources, all the same ones the helpers read today:
//   - the money-movement denylist: agent/scripts/lib/credential-denylist.sh
//     plus agent/local/config/credentials.json deny_domains
//   - the vault names: JORI_OP_LOGINS_VAULT / JORI_OP_DEV_VAULT (Logins, Dev)
//   - the card tag: agent/local/config/purchase.json card_tag (jori-purchase)
//   - named items: agent/local/config/sms-send.json onepassword (sms-send)
//   - bundles: agent/local/config/secrets-broker.json `bundles`, each an
//     `op run` template whose 1Password references the broker resolves for a job
//
// Usage: secrets-broker-policy [--out FILE]

"use strict";
const fs = require("node:fs");
const path = require("node:path");
const { installTools } = require("../lib/root.cjs");
const os = require("node:os");
const { localConfig } = require("../lib/instance.cjs");

/** { name: { token, vars: { VAR: reference } } } from each bundle's template. */
function bundles() {
  const out = {};
  const cfg = localConfig("secrets-broker", { bundles: {} }).bundles || {};
  for (const [name, b] of Object.entries(cfg)) {
    const file = String(b.env_file || "").replace(/^~(?=\/)/, os.homedir());
    const fill = (s) => s.replace(/\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)/g, (m, a, c) => {
      const k = a || c;
      if (!(b.vars && k in b.vars)) throw new Error(`bundle ${name}: \${${k}} has no value in secrets-broker.json vars`);
      return String(b.vars[k]);
    });
    const vars = {};
    for (const raw of fs.readFileSync(file, "utf8").split("\n")) {
      const line = raw.trim();
      const m = /^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/.exec(line); // lang-regex-ok: dotenv syntax, not language
      if (!m || line.startsWith("#")) continue;
      let v = m[2];
      if ((v.startsWith('"') && v.endsWith('"')) || (v.startsWith("'") && v.endsWith("'"))) v = v.slice(1, -1);
      if (v.includes("op://")) vars[m[1]] = fill(v); // kernel-guard-ok: the 1Password reference scheme, not a reference
    }
    if (!Object.keys(vars).length) throw new Error(`bundle ${name}: no 1Password references in ${file}`);
    out[name] = { token: String(b.token || "dev"), vars };
  }
  return out;
}

function denylist() {
  const text = fs.readFileSync(installTools("agent/scripts/lib/credential-denylist.sh"), "utf8");
  const m = text.match(/JORI_FINANCIAL_DENY=\(([\s\S]*?)\n\)/);
  const base = m ? m[1].split("\n").map((l) => l.replace(/#.*$/, "")).join(" ").split(/\s+/).filter(Boolean) : [];
  const extra = localConfig("credentials", { deny_domains: [] }).deny_domains;
  const all = [...base, ...(Array.isArray(extra) ? extra : [])].map((s) => String(s).toLowerCase()).filter((s) => /^[a-z0-9.-]+\.[a-z]{2,}$/.test(s));
  if (base.length < 10) throw new Error("could not read the financial denylist from credential-denylist.sh");
  return [...new Set(all)].sort();
}

function policy() {
  const items = {};
  const sms = localConfig("sms-send", {}).onepassword;
  if (sms && sms.item) {
    const names = { account_sid: "account sid", auth_token: "auth token", from: "from number", ...(sms.fields || {}) };
    items["sms-send"] = { vault: String(sms.vault || ""), item: String(sms.item), fields: [...new Set(Object.values(names).map(String))] };
  }
  return {
    _comment: "The secrets broker's policy (docs/secrets-broker.md). Generated by bin/secrets-broker-policy; copied to /Library/JoriSecrets/etc/policy.json by bin/secrets-broker-install, after the user checks its hash. Never edited by hand on the host.",
    version: 1,
    vaults: { logins: process.env.JORI_OP_LOGINS_VAULT || "Logins", dev: process.env.JORI_OP_DEV_VAULT || "Dev" },
    tokens: { logins: "OP_LOGINS_SERVICE_ACCOUNT_TOKEN", dev: "OP_SERVICE_ACCOUNT_TOKEN" },
    card_tag: String(process.env.JORI_OP_CARD_TAG || localConfig("purchase", { card_tag: "" }).card_tag || "jori-purchase"),
    dev_site_prefix: "site:",
    deny_domains: denylist(),
    dev_items: items,
    dev_envs: bundles(),
    rate: { per_hour: 120 },
  };
}

const i = process.argv.indexOf("--out");
const out = JSON.stringify(policy(), null, 2) + "\n";
if (i >= 0) { fs.mkdirSync(path.dirname(path.resolve(process.argv[i + 1])), { recursive: true }); fs.writeFileSync(process.argv[i + 1], out); }
else process.stdout.write(out);
