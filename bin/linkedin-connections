#!/usr/bin/env node
// linkedin-connections — look up the owner's LinkedIn connections (local DB,
// built from a LinkedIn data export). Read-only apart from `import`.
//
// Usage:
//   linkedin-connections import <export-folder>     (Connections.csv + optional messages/recs/endorsements)
//   linkedin-connections find "<name or words>" [--company X] [--limit N] [--json]
//   linkedin-connections company "<company>" [--limit N] [--json]
//   linkedin-connections get <profile-url-or-slug> [--json]
//   linkedin-connections stats [--json]
//   linkedin-connections link [--no-model] [--dry-run]   tie connections to wiki person pages (both ways)
//   linkedin-connections link --pending [--json]          name matches still waiting for a same-person decision
//   linkedin-connections link --decide <page_id> <slug|none>
//   linkedin-connections link --show <page_id>
//
// "tie" says how well the owner actually knows someone, from LinkedIn messages,
// recommendations and endorsements: strong | some | weak | connection only.
// For live profile data (current role today) use bin/linkedin-lookup instead.

"use strict";

// node:sqlite prints an ExperimentalWarning on load; keep CLI output clean.
const _emit = process.emitWarning;
process.emitWarning = (w, ...a) => (String(w?.name || a[0] || "").includes("ExperimentalWarning") || /SQLite/.test(String(w)) ? undefined : _emit.call(process, w, ...a)); // lang-regex-ok: node warning text

const li = require("../lib/linkedin-connections");

const args = process.argv.slice(2);
const cmd = args[0];
const flag = (n) => { const i = args.indexOf(`--${n}`); return i === -1 ? undefined : (args[i + 1] && !args[i + 1].startsWith("--") ? args[i + 1] : true); };
const pos = args.slice(1).filter((a, i, all) => !a.startsWith("--") && !(i > 0 && all[i - 1].startsWith("--") && all[i - 1] !== "--json"));
const json = args.includes("--json");
const limit = Number(flag("limit")) || 20;

function out(rows, empty) {
  if (json) return console.log(JSON.stringify(rows, null, 2));
  if (!rows.length) return console.log(empty);
  console.log(rows.map(li.format).join("\n\n"));
}

let asyncRun = false;
try {
  switch (cmd) {
    case "import": {
      if (!pos[0]) throw new Error("usage: linkedin-connections import <export-folder>");
      const s = li.importExport(pos[0]);
      // Decisions about who has a wiki page survive the re-import: re-stamp rows and refresh page blocks.
      try { s.pages = require("../lib/linkedin-people").apply(); } catch (e) { s.pages = { error: e.message }; }
      console.log(json ? JSON.stringify(s) : `imported ${s.connections} connections (matched ${s.messages} messages, ${s.recommendations} recommendations, ${s.endorsements} endorsements) → ${li.DB_PATH}`);
      break;
    }
    case "find": {
      const q = pos.join(" ");
      const company = flag("company");
      if (!q && !company) throw new Error("usage: linkedin-connections find \"<name>\" [--company X]");
      out(li.find(q, { company: typeof company === "string" ? company : undefined, limit }), `No LinkedIn connection matches "${q || company}".`);
      break;
    }
    case "company": {
      if (!pos[0]) throw new Error("usage: linkedin-connections company \"<company>\"");
      out(li.find("", { company: pos.join(" "), limit }), `No LinkedIn connection at "${pos.join(" ")}".`);
      break;
    }
    case "get": {
      const r = li.get(pos[0]);
      out(r ? [r] : [], `No LinkedIn connection with profile ${pos[0]}.`);
      break;
    }
    case "link": {
      const lp = require("../lib/linkedin-people");
      if (args.includes("--decide")) {
        const i = args.indexOf("--decide");
        const [pageId, slug] = [args[i + 1], args[i + 2]];
        if (!pageId || !slug) throw new Error("usage: link --decide <page_id> <slug|none>");
        lp.decide(pageId, slug, { method: "manual" });
        const r = lp.apply();
        console.log(`${pageId} → ${slug === "none" ? "no LinkedIn connection" : slug}; pages written ${r.pages_written}`);
        break;
      }
      if (args.includes("--show")) {
        const id = flag("show");
        console.log(JSON.stringify(lp.linkedFor(id), null, 2));
        break;
      }
      const sc = lp.scan();
      if (args.includes("--pending")) {
        if (json) { console.log(JSON.stringify(sc.pending, null, 2)); break; }
        if (!sc.pending.length) { console.log("Nothing pending."); break; }
        for (const p of sc.pending) {
          console.log(`${p.page_id} (${p.title})`);
          for (const c of p.candidates) console.log(`  ${c.slug}: ${c.name} — ${[c.position, c.company].filter(Boolean).join(" @ ")} · connected ${c.connected_on} · tie ${c.tie}`);
        }
        break;
      }
      const dryRun = args.includes("--dry-run");
      (async () => {
        let auto = null;
        if (!dryRun && !args.includes("--no-model") && sc.pending.length) auto = await lp.autoDecide(sc.pending);
        const r = lp.apply({ dryRun });
        const out = { url_linked: sc.url_linked, pending_before_model: sc.pending.length, model: auto, ...r };
        console.log(json ? JSON.stringify(out, null, 2) : `linked by URL ${sc.url_linked}; name matches ${sc.pending.length}${auto ? ` (model: ${auto.linked} same person, ${auto.none} not, ${auto.left} left pending${auto.errors.length ? `; first error: ${auto.errors[0]}` : ""})` : ""}\npages linked ${r.linked}: ${r.pages_written} written, ${r.pages_unchanged} unchanged, ${r.unlinked_pages} unlinked${r.missing.length ? `; missing ${r.missing.join(", ")}` : ""}${dryRun ? " (dry run)" : ""}`);
        li.close();
      })().catch((e) => { console.error(`linkedin-connections: ${e.message}`); process.exit(1); });
      asyncRun = true;
      break;
    }
    case "stats": {
      const s = li.stats();
      console.log(json ? JSON.stringify(s, null, 2) : `${s.connections} connections, imported ${s.imported_at || "never"} from ${s.source || "-"}\nmatched: ${JSON.stringify(s.matched)}\ntop companies: ${s.top_companies.map((c) => `${c.company} (${c.n})`).join(", ")}`);
      break;
    }
    default:
      console.log(require("node:fs").readFileSync(__filename, "utf8").split("\n").slice(1, 20).map((l) => l.replace(/^\/\/ ?/, "")).join("\n"));
      process.exit(cmd ? 1 : 0);
  }
} catch (e) {
  console.error(`linkedin-connections: ${e.message}`);
  process.exit(1);
} finally {
  if (!asyncRun) li.close();
}
