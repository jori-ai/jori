#!/usr/bin/env node
// embed-daily-summaries — fills daily_summaries.embedding via local Ollama
// (nomic-embed-text, 768 dims). Processes all rows where embedding IS NULL,
// default 50 rows per run (matches jori_messages embedder pacing). Reuses
// lib/local-llm.mjs so the Max-only-for-agents + local-for-non-agent-
// work invariant is preserved — no Anthropic/OpenAI API calls.
//
// Usage:
//   embed-daily-summaries                    embed up to 50 unembedded rows
//   embed-daily-summaries --all              embed every unembedded row
//   embed-daily-summaries --force            re-embed every row
//   embed-daily-summaries --date 2026-04-17  embed one specific row

import { createRequire } from "node:module";
const require = createRequire(import.meta.url);
const { request } = require("../lib/supabase-rest.js");
const { localLlmEmbed } = await import("../lib/local-llm.mjs");

const EMBED_MODEL = "nomic-embed-text";
const DEFAULT_LIMIT = 50;
const PATCH_CONCURRENCY = 3;

function die(msg, code = 1) {
  console.error(`embed-daily-summaries: ${msg}`);
  process.exit(code);
}

async function fetchRows({ force, date, limit }) {
  let q;
  if (date) q = `/rest/v1/daily_summaries?date=eq.${date}&select=date,narrative`;
  else if (force) q = `/rest/v1/daily_summaries?select=date,narrative&order=date.asc&limit=${limit}`;
  else q = `/rest/v1/daily_summaries?embedding=is.null&narrative=not.is.null&select=date,narrative&order=date.asc&limit=${limit}`;
  return request(q);
}

async function patchRow(date, embedding) {
  await request(`/rest/v1/daily_summaries?date=eq.${date}`, {
    method: "PATCH",
    body: {
      embedding,
      embedding_model: EMBED_MODEL,
      embedded_at: new Date().toISOString(),
    },
  });
}

// nomic-embed-text caps at 8192 tokens; keep narratives safely inside.
const MAX_CHARS = 5000;

// daily_summaries.narrative is stored as rendered HTML. Char-truncating the
// HTML cuts mid-tag and mid-entity, which inflates the tokenization and blew
// past Ollama's 8192-token context on 2026-04-18 (s-20260419-07). Strip tags
// to plain text first so the char cap corresponds to real semantic content —
// and so the embedding reflects meaning, not markup.
function htmlToPlainText(html) {
  return html
    .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "")
    .replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, "")
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<\/(p|div|h[1-6]|li|tr)>/gi, "\n")
    .replace(/<[^>]+>/g, "")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/[ \t]+/g, " ")
    .replace(/\n{3,}/g, "\n\n")
    .trim();
}

async function embedOne(row) {
  let text = htmlToPlainText(row.narrative || "");
  if (!text) return { date: row.date, status: "skipped" };
  const truncated = text.length > MAX_CHARS;
  if (truncated) text = text.slice(0, MAX_CHARS);
  try {
    const embedding = await localLlmEmbed(text);
    if (!Array.isArray(embedding) || embedding.length !== 768) {
      throw new Error(`bad embedding shape: length=${embedding?.length}`);
    }
    await patchRow(row.date, embedding);
    return { date: row.date, status: "embedded", truncated };
  } catch (err) {
    return { date: row.date, status: "failed", error: err.message };
  }
}

async function main() {
  const args = process.argv.slice(2);
  const force = args.includes("--force");
  const all = args.includes("--all");
  const dateIdx = args.indexOf("--date");
  const date = dateIdx >= 0 ? args[dateIdx + 1] : null;
  const limit = date ? 1 : (all || force ? 10000 : DEFAULT_LIMIT);

  const rows = await fetchRows({ force, date, limit });
  if (!rows.length) {
    console.log("nothing to embed (no unembedded rows; add --force to re-embed)");
    return;
  }

  const results = [];
  for (let i = 0; i < rows.length; i += PATCH_CONCURRENCY) {
    const chunk = rows.slice(i, i + PATCH_CONCURRENCY);
    const chunkResults = await Promise.all(chunk.map(embedOne));
    for (const r of chunkResults) {
      if (r.status === "embedded") console.log(`embedded ${r.date}${r.truncated ? " (truncated)" : ""}`);
      else if (r.status === "failed") console.error(`failed ${r.date}: ${r.error}`);
    }
    results.push(...chunkResults);
  }

  const done = results.filter(r => r.status === "embedded").length;
  const skipped = results.filter(r => r.status === "skipped").length;
  const failed = results.filter(r => r.status === "failed").length;
  const truncated = results.filter(r => r.truncated).length;
  console.log(`\nsummary: ${done} embedded, ${skipped} skipped (empty narrative), ${failed} failed, ${truncated} truncated to fit context. total scanned: ${rows.length}`);
}

main().catch(err => die(err.message));
