#!/usr/bin/env node
// app-build — start a companion app build where this installation builds it.
//
// Where builds run is configuration, not knowledge an agent has to have:
// agent/local/config/app-builds.json names the repo, workflow and ref per
// platform (lib/app-builds.cjs; kernel default = this repo's own workflows).
//
//   bin/app-build where               print the configured target per platform
//   bin/app-build ios|macos|all       dispatch; prints one line per run
//         [--watch]                   wait for each run, exit non-zero if any fails
//         [--input k=v ...]           extra workflow_dispatch inputs (e.g. kernel_ref=my-branch)
//         [--dry-run]                 print the gh commands, run nothing
//
// Needs `gh` signed in with access to the target repo (sandbox disabled).

const { execFileSync, spawnSync } = require("node:child_process");
const { PLATFORMS, buildTargets, dispatchArgs, runIdFrom } = require("../lib/app-builds.cjs");

const argv = process.argv.slice(2);
const cmd = argv[0];
const flag = (f) => argv.includes(f);
const inputs = {};
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === "--input" && argv[i + 1]) {
    const [k, ...rest] = argv[++i].split("=");
    inputs[k] = rest.join("=");
  }
}

const usage = () => {
  process.stderr.write(`usage: app-build where | app-build <${PLATFORMS.join("|")}|all> [--watch] [--input k=v] [--dry-run]\n`);
  process.exit(2);
};

let targets;
try { targets = buildTargets(); } catch (e) { process.stderr.write(`${e.message}\n`); process.exit(2); }

if (cmd === "where") {
  for (const p of PLATFORMS) {
    const t = targets[p];
    if (!t) { console.log(`${p}: disabled`); continue; }
    const extra = Object.entries(t.inputs).map(([k, v]) => ` ${k}=${v}`).join("");
    console.log(`${p}: ${t.repo} ${t.workflow} @${t.ref}${extra}`);
  }
  process.exit(0);
}

const want = cmd === "all" ? PLATFORMS : PLATFORMS.includes(cmd) ? [cmd] : usage();
const runs = [];
for (const p of want) {
  const t = targets[p];
  if (!t) { console.log(`${p}: disabled in app-builds.json, skipped`); continue; }
  const args = dispatchArgs(t, inputs);
  if (flag("--dry-run")) { console.log(`${p}: gh ${args.join(" ")}`); continue; }
  let out;
  try { out = execFileSync("gh", args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }); }
  catch (e) { process.stderr.write(`${p}: dispatch failed: ${(e.stderr || e.message).trim()}\n`); process.exit(1); }
  const id = runIdFrom(out);
  console.log(`${p}: ${id ? `https://github.com/${t.repo}/actions/runs/${id}` : out.trim()}`);
  runs.push({ p, t, id });
}

if (flag("--watch")) {
  let failed = false;
  for (const { p, t, id } of runs) {
    if (!id) { process.stderr.write(`${p}: no run id to watch\n`); failed = true; continue; }
    const r = spawnSync("gh", ["run", "watch", id, "-R", t.repo, "--exit-status"], { stdio: ["ignore", "ignore", "inherit"] });
    console.log(`${p}: ${r.status === 0 ? "succeeded" : "FAILED"}`);
    if (r.status !== 0) failed = true;
  }
  process.exit(failed ? 1 : 0);
}
