#!/usr/bin/env node
// email-triage-run — triage ONE Gmail message in a stateless one-off `claude -p`
// with no shell, files, web or browser, instead of a turn in the ops-light
// session (agent/ops-agent/jobs/email-triage-strict.md).
//
// Tool grant — the whole of it: built-in tools OFF (--tools ""),
// --strict-mcp-config to ONE server (agent/tools-mcp/email-triage.mjs), whose
// tools are bound in code to this message (lib/email-triage-tools.mjs). The
// child runs in the locked-down agent environment (lib/agent-env.cjs, id
// "email-triage"); the tools read their own secrets.
//
// Called by agent/supervisor/triage-route.mjs when ops.gmailTriageTarget is
// "strict". Never drops an email: exit 3 (no answer, a crash, a timeout, or no
// triage action at all) tells the router to dispatch to ops-light as before,
// with what this run already did.
//
// Usage: email-triage-run --payload <file> [--dry-run]
//          payload: {"messageId","from","subject","date","content"}
//          (content = the gmail-source triage dispatch text, body included)
//        --dry-run: read tools run, nothing changes; prints what it would do.
// Output (stdout, one JSON line): { ok, text, actions, escalated, cost_usd, ms }
// Log: data/email-triage-oneshot-log.jsonl (ids, outcome, actions; no body).

import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { createRequire } from "node:module";
import { makeStatelessExecutor } from "../agent/core/stateless-executor.mjs";
import { readOptional, sliceAll } from "../agent/supervisor/dispatch-preamble.mjs";
import { TOOL_NAMES } from "../lib/email-triage-tools.mjs";

const require = createRequire(import.meta.url);
const { MODELS } = require("../lib/models.cjs");
const { TOOLS_DIR, installTools } = require("../lib/root.cjs");
const { agentEnv } = require("../lib/agent-env.cjs");

const argv = process.argv.slice(2);
const DRY = argv.includes("--dry-run");
const PAYLOAD_ARG = (() => { const i = argv.indexOf("--payload"); return i !== -1 ? argv[i + 1] : null; })();
const LOG = installTools("data/email-triage-oneshot-log.jsonl");
const COSTS = installTools("agent/logs/ephemeral-forks/job-costs.ndjson");
const PLAYBOOK = path.join(TOOLS_DIR, "agent/ops-agent/jobs/email-triage-strict.md");
const LOCAL_PLAYBOOK = path.join(process.env.JORI_LOCAL_DIR || path.join(TOOLS_DIR, "agent/local"), "jobs/email-triage-strict.md");
const TIMEOUT_MS = Number(process.env.EMAIL_TRIAGE_TIMEOUT_MS || 8 * 60 * 1000);

const append = (f, row) => { try { fs.mkdirSync(path.dirname(f), { recursive: true }); fs.appendFileSync(f, JSON.stringify(row) + "\n"); } catch {} };

export function systemPrompt() {
  const kernel = fs.readFileSync(PLAYBOOK, "utf8");
  const local = readOptional(LOCAL_PLAYBOOK);
  const md = local == null ? kernel : `${kernel}\n\n${local}`;
  const s = sliceAll(md, "<!-- oneshot:start -->", "<!-- oneshot:end -->");
  if (s == null) throw new Error("email-triage-strict.md is missing its oneshot markers");
  return s;
}

/** What the run did, from the state file the server appends to. */
export function readState(file) {
  const rows = [];
  try { for (const l of fs.readFileSync(file, "utf8").split("\n")) { if (l.trim()) try { rows.push(JSON.parse(l)); } catch {} } } catch {}
  const actions = rows.filter((r) => r.tool);
  const calls = rows.filter((r) => r.call).map((r) => r.call);
  return { actions, calls, escalated: actions.some((a) => a.tool === "escalate_to_ops") };
}

/** Did the one-shot triage the email? A run that changed nothing and escalated nothing did not. */
export function judge({ text, actions }) {
  if (!String(text || "").trim()) return { ok: false, why: "no answer (error or timeout)" };
  const triaged = actions.some((a) => a.tool === "gmail_message" || a.tool === "escalate_to_ops" || a.tool === "p1_downgrade" || a.tool === "spam_block");
  if (!triaged) return { ok: false, why: "no triage action recorded" };
  return { ok: true };
}

function lockedEnv() {
  try {
    const { env } = agentEnv("email-triage", { force: true });
    if (env && Object.keys(env).length) return env;
  } catch {}
  return { ...process.env };
}

async function main() {
  const raw = PAYLOAD_ARG ? fs.readFileSync(PAYLOAD_ARG, "utf8") : fs.readFileSync(0, "utf8");
  const p = JSON.parse(raw);
  if (!p.messageId || !p.content) throw new Error("payload needs messageId and content");
  const t0 = Date.now();
  const dateIso = (() => { const t = Date.parse(p.date || ""); return Number.isFinite(t) ? new Date(t).toISOString() : ""; })();

  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "email-triage-"));
  const stateFile = path.join(tmp, "state.jsonl");
  fs.writeFileSync(stateFile, "");
  const env = lockedEnv();
  const mcpConfig = path.join(tmp, "mcp.json");
  fs.writeFileSync(mcpConfig, JSON.stringify({
    mcpServers: {
      "email-triage": {
        command: process.execPath,
        args: [path.join(TOOLS_DIR, "agent/tools-mcp/email-triage.mjs")],
        env: {
          TRIAGE_MESSAGE_ID: String(p.messageId), TRIAGE_FROM: String(p.from || ""),
          TRIAGE_SUBJECT: String(p.subject || ""), TRIAGE_DATE: dateIso,
          TRIAGE_STATE: stateFile, TRIAGE_DRY: DRY ? "1" : "0",
          HOME: os.homedir(), PATH: env.PATH || process.env.PATH,
        },
      },
    },
  }));

  // The child (claude) gets the locked-down environment; the executor copies process.env.
  for (const k of Object.keys(process.env)) if (!(k in env)) delete process.env[k];
  Object.assign(process.env, env);

  let text = "", usage = null, costUsd = null, err = null;
  try {
    const run = makeStatelessExecutor({
      model: MODELS.sonnet,
      effort: "medium",
      cwd: tmp,
      tools: "",
      mcpConfig,
      strictMcpConfig: true,
      allowedTools: TOOL_NAMES.map((t) => `mcp__email-triage__${t}`),
      timeoutMs: TIMEOUT_MS,
    });
    ({ text, usage, cost_usd: costUsd = null } = await run({ system: systemPrompt(), messages: [{ role: "user", content: p.content }] }));
  } catch (e) { err = e; }
  const st = readState(stateFile);
  fs.rmSync(tmp, { recursive: true, force: true });

  const verdict = err ? { ok: false, why: `error: ${err.message}` } : judge({ text, actions: st.actions });
  const ms = Date.now() - t0;
  const cost = costUsd ?? usage?.total_cost_usd ?? null;
  const out = {
    ok: verdict.ok, why: verdict.why || null, text: String(text || "").trim().slice(0, 1500),
    actions: st.actions, calls: st.calls, escalated: st.escalated, cost_usd: cost, ms, dry: DRY,
  };
  append(LOG, {
    ts: new Date().toISOString(), messageId: p.messageId, outcome: verdict.ok ? (st.escalated ? "escalated" : "triaged") : "fallback",
    why: verdict.why || null, actions: st.actions.map((a) => a.tool), calls: st.calls.length, ms, cost_usd: cost, dry: DRY,
  });
  append(COSTS, {
    ts: new Date().toISOString(), dispatch_id: null, short_id: String(p.messageId).slice(0, 6),
    source: DRY ? `email-triage-replay:${p.messageId}` : `gmail:${p.messageId}`, duration_ms: ms,
    total_cost_usd: cost ?? 0, models: [MODELS.sonnet], terminal_reason: verdict.ok ? "completed" : "fallback", runner: "email-triage-oneshot",
  });
  console.log(JSON.stringify(out));
  process.exit(verdict.ok ? 0 : 3);
}

if (import.meta.url === `file://${process.argv[1]}` || process.argv[1]?.endsWith("/email-triage-run")) {
  main().catch((e) => {
    append(LOG, { ts: new Date().toISOString(), outcome: "error", error: String(e.message).slice(0, 300) });
    console.log(JSON.stringify({ ok: false, why: `runner error: ${e.message}`, actions: [] }));
    process.exit(3);
  });
}
