#!/usr/bin/env python3
"""location-confirm — record a venue confirmation against a recent ask.

Subcommands:
  save <ask_id> <venue_name>
      Looks up the pending ask, picks the matching candidate (by name match or
      1-based index), and appends to data/confirmed-stops.json. Removes
      the entry from pending-asks.json and recent-asks.json.

  save-current <venue_name>
      The direct-save path (2026-09-25): writes a confirmation for the stop
      that's open RIGHT NOW (or the one that just closed, while he is still
      near it: since 2026-10-28 a fix more than DIRECT_SAVE_MOVED_ON_M from it
      means he has left it, and nothing is written, exit 5; and a spot already
      confirmed as another place on two or more other days, his lodging, is not
      renamed without --new-place-here, exit 5), with no card and
      no ask_id required. Until this existed, the
      only way a confirmation could be written was through save's ask_id —
      so something the user stated in an ordinary message, before any card had
      gone out for that dwell, had nowhere to land and could be silently
      overwritten by a later automated guess. This synthesizes an ask-shaped
      record from `location-current-stop` (or, if nothing is dwelling right
      now, the most recently departed location_history visit row) and then
      writes through the exact same path save does — same patch to
      location_history, same entry in confirmed-stops.json — so everything
      downstream (resolve_place, location-enrich's pending cleanup, the
      silent re-render) treats it identically to a card answer. See
      agent/chat-agent/CLAUDE.md § "Location Statement Direct-Save"
      for when this should fire.

  save-at <venue> --lat --lon --start <iso> --end <iso> [--source] [--answer]
      A place he named that is NOT where he is now (2026-10-17): a Maps link,
      a past-tense "we had dinner at X". save-current binds a name to where he
      is standing, which put a café's name on the rental flat's doorstep. This
      writes the entry at the given point and window and patches no visit row
      (the overlap clause would rename an unrelated row) and re-renders nothing.

  withdraw <ask_id> --reason "<why>" [--name "<expected>" | --only-name "<name>"]
      Takes a wrong entry out (2026-10-17): anything within 30 m of a centroid
      is auto-named, so a misplaced one keeps naming the wrong place. Archived
      whole in confirmed-stops-withdrawn.json first; touches no visit row.
      --only-name takes out just the entries under that ask_id saved with
      exactly that name, and keeps the others: a stop answered twice (a bare
      first answer, then the corrected one) shares one ask_id.

  list
      Show the most recent confirmations + currently-pending asks.

  rewrite-episodes [--days N]
      For each episode markdown in the last N days (default 30), re-run
      location-segment and rewrite the file IF any stop within 30 m of a
      confirmed centroid would now resolve differently. Stub for v1.

The ask_id is generated by location-confirm-cron when it dispatches and is
embedded in the chat message the user sees, e.g.:
    "I think you're at Fruit Vanity. Or: 1) Pho Grand, 2) Lucky King.
     Reply: location-confirm save lc-20260425-1638 'Pho Grand'"

A save-current confirmation carries an ask_id of the form
`lc-direct-<timestamp>` instead, so it's easy to tell apart in
confirmed-stops.json from either a card answer (`lc-<...>`) or the
resolver's own safety-net promotion (`lc-resolve-<...>`, in
location-confirm-resolve.mjs's promoteConfirmedStop — the only other writer
that has ever touched this file, and only when the canonical save() path
here can't reach the stop at all). A save-at confirmation carries
`lc-at-<timestamp>`.
"""

from __future__ import annotations
import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.request
import urllib.parse
from datetime import datetime, timedelta, timezone

# The installation root (lib/root.cjs installRoot()): its data/, .env and secrets/
# sit directly under it since the 2026-10-28 move off ~/Dev/gandalf/tools.
INSTALL_ROOT = os.environ.get("JORI_HOME") or os.path.expanduser("~/Dev/jori")
DATA_DIR = os.path.join(INSTALL_ROOT, "data")
CONFIRMED_FILE = os.path.join(DATA_DIR, "confirmed-stops.json")
# Where `withdraw` keeps what it took out of CONFIRMED_FILE: a JSON list, each
# entry whole plus `withdrawn: {at, reason}`. Nothing reads it to name places.
WITHDRAWN_FILE = os.path.join(DATA_DIR, "confirmed-stops-withdrawn.json")
PENDING_FILE = os.path.join(DATA_DIR, "location-confirm-pending.json")
RECENT_ASKS_FILE = os.path.join(DATA_DIR, "location-confirm-recent.json")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import places_local  # noqa: E402  (kernel: instance identity + local config)


def _supabase_url() -> str:
    """SUPABASE_URL (environment), else https://<supabase_project>.supabase.co
    from agent/local/instance.json (JORI_SUPABASE_PROJECT overrides); "" when none."""
    url = os.environ.get("SUPABASE_URL")
    if url:
        return url.rstrip("/")
    project = os.environ.get("JORI_SUPABASE_PROJECT")
    if not project:
        try:
            with open(os.path.join(places_local.local_dir(), "instance.json")) as fh:
                project = (json.load(fh) or {}).get("supabase_project")
        except (OSError, ValueError):
            project = None
    return f"https://{project}.supabase.co" if project else ""


SUPABASE_URL = _supabase_url()
# The home zone (instance tz), the fallback when the phone's zone is unknown.
HOME_TZ = places_local.instance().get("tz") or "UTC"

# save-current tunables.
DIRECT_SAVE_LOOKBACK_MIN = 20.0    # how far back a "just closed" stop can still count
DIRECT_SAVE_DEDUP_RADIUS_M = 50.0  # same name within this radius...
DIRECT_SAVE_DEDUP_WINDOW_H = 2.0   # ...and this recently = don't write a second entry
# A fix this far from the stop that just closed means the user has left it (2026-10-28).
# Wider than a visit row's centroid error (the overnight row at a flat has sat
# ~100 m off it), well short of the next café over.
DIRECT_SAVE_MOVED_ON_M = 150.0
DIRECT_SAVE_FIX_ACC_M = 60.0       # a fix worse than this places nothing
# A spot the user has already named something else on other days is not renamed by
# save-current (2026-10-28): it names where the user stands, and three times a place the user
# named FROM the user's lodging (a café, a bakery, a Maps link to a shop the user had left) was
# saved onto the rental flat and renamed it, and the 30 m ring then renamed the user's
# later stays at home. The ring is resolve-day's CONFIRMED_STOP_MATCH_M.
DIRECT_SAVE_KNOWN_RADIUS_M = 30.0
DIRECT_SAVE_KNOWN_MIN_DAYS = 2

BIN_DIR = os.path.dirname(os.path.abspath(__file__))
LOCATION_CURRENT_STOP = os.path.join(BIN_DIR, "location-current-stop")


def _haversine_m(lat1, lon1, lat2, lon2):
    from math import radians, sin, cos, atan2, sqrt
    rlat1, rlat2 = radians(lat1), radians(lat2)
    dlat = radians(lat2 - lat1)
    dlon = radians(lon2 - lon1)
    a = sin(dlat / 2) ** 2 + cos(rlat1) * cos(rlat2) * sin(dlon / 2) ** 2
    return 6371000.0 * 2 * atan2(sqrt(a), sqrt(1 - a))


def _supabase_key() -> str | None:
    key = os.environ.get("SUPABASE_SERVICE_ROLE_KEY") or os.environ.get("SUPABASE_ANON_KEY")
    if key:
        return key
    env_path = os.path.join(INSTALL_ROOT, ".env")
    try:
        with open(env_path) as f:
            for line in f:
                if line.startswith("SUPABASE_SERVICE_ROLE_KEY="):
                    return line.split("=", 1)[1].strip()
    except Exception:
        return None
    return None


def _patch_location_history(ask: dict, place_name: str | None, source: str,
                            place_type: str = "user-confirmed", answer: str | None = None) -> bool:
    """Override place_name on the matching location_history row(s) so that
    resolve-day's classifyStops picks up the user's free-text confirmation.
    Without this, the resolver keeps the original candidate name (e.g.,
    "Sunday Brunch Spot") even when the user said "Corner Cafe" — drift
    documented in the 2026-04-29 self-improvement review.
    """
    key = _supabase_key()
    if not key:
        return False
    centroid = ask.get("centroid") or {}
    lat = centroid.get("lat")
    lon = centroid.get("lon")
    start_ts = ask.get("first_sample_ts")
    end_ts = ask.get("last_sample_ts")
    if lat is None or lon is None or not start_ts:
        return False
    # Window: arrived_at within first_sample_ts ± 30min covers the typical
    # visit row (visit timestamps lag the first GPS sample slightly).
    delta_minutes = 30
    try:
        start_dt = datetime.fromisoformat(start_ts.replace("Z", "+00:00"))
        stop_start = start_dt.timestamp()
        window_start = (stop_start - delta_minutes * 60)
        window_end = (stop_start + delta_minutes * 60)
        stop_end = stop_start + 600
        if end_ts:
            end_dt = datetime.fromisoformat(end_ts.replace("Z", "+00:00"))
            stop_end = end_dt.timestamp()
            window_end = max(window_end, stop_end + delta_minutes * 60)
        win_start_iso = datetime.fromtimestamp(window_start, tz=timezone.utc).isoformat()
        win_end_iso = datetime.fromtimestamp(window_end, tz=timezone.utc).isoformat()
    except Exception:
        return False
    # Fetch a WIDER slice than the ±30min arrival window so the overlap clause
    # below can see a visit row that opened well before the ask's own sample
    # window (an all-evening stay at an Airbnb, a long airport wait). The
    # arrival-window constraint is re-applied in Python for the distance clause,
    # so this widening cannot change that clause's behaviour.
    fetch_start_iso = datetime.fromtimestamp(stop_start - 12 * 3600, tz=timezone.utc).isoformat()
    fetch_end_iso = datetime.fromtimestamp(stop_end + 5400, tz=timezone.utc).isoformat()
    select_qs = (
        "select=id,latitude,longitude,arrived_at,departed_at,place_name,place_type,notes"
        f"&segment_type=eq.visit"
        f"&arrived_at=gte.{urllib.parse.quote(fetch_start_iso)}"
        f"&arrived_at=lte.{urllib.parse.quote(fetch_end_iso)}"
    )
    select_url = f"{SUPABASE_URL}/rest/v1/location_history?{select_qs}"
    req = urllib.request.Request(
        select_url,
        headers={"apikey": key, "Authorization": f"Bearer {key}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            rows = json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"location-confirm: select failed: {e}", file=sys.stderr)
        return False

    # Two independent ways a location_history visit row can BE the stop the user
    # just answered about. A row matching either one gets the user's answer written to
    # it — which is also the only signal `findme enrich` has that the stop is
    # settled (`_clean_resolved_from_pending` drops pending rows whose
    # place_type is user-confirmed). Miss here and location-enrich asks about
    # the same stop hours later; that is the 2026-08-04 Land&Monkeys duplicate.
    #
    #   (1) PROXIMITY — the original rule, unchanged: centroid within 300m and
    #       the row's arrived_at inside the ±30min ask window.
    #   (2) TIME OVERLAP — new. The ask's own sample window and the visit row's
    #       [arrived_at, departed_at] overlap by ≥5 min, within a 500m sanity
    #       bound. This is what proximity alone cannot see: `location-current-stop`
    #       builds its centroid by anchor-walking raw GPS, so a sparse sample set
    #       that straddles the walk TO a venue smears the centroid toward the
    #       origin. On 2026-08-04 that put the ask centroid 319.5m from the café
    #       the user was actually sitting in — 19.5m past the gate — and the answer
    #       never reached the DB. A person is in one place at a time, so a
    #       genuine multi-minute overlap is strong evidence of identity even
    #       when the smeared centroid is far; the distance cap keeps it honest.
    #
    # Clause 2 is strictly ADDITIVE — it can only add rows, never remove one
    # clause 1 would have matched. Replayed over the 28 confirmations in the
    # retention-window: write-back success 15/28 → 19/28, zero regressions.
    OVERLAP_MIN_S = 300
    OVERLAP_MAX_DIST_M = 500
    OVERLAP_SHARE, INNER_SHARE = 0.5, 0.25
    PROXIMITY_AFTER_END_S = 120  # arrival-time jitter between twin rows, no more
    TWIN_ARRIVAL_S = 120         # iOS twins share arrived_at to the second
    SAME_START_APART_M = 50      # ...and the same point (see `apart` below)
    matches, reasons = [], []
    for row in rows or []:
        if row.get("latitude") is None or row.get("longitude") is None:
            continue
        d = _haversine_m(lat, lon, row["latitude"], row["longitude"])
        try:
            r_start = datetime.fromisoformat(row["arrived_at"].replace("Z", "+00:00")).timestamp()
        except (KeyError, ValueError, TypeError, AttributeError):
            continue
        r_end = r_start + 900
        if row.get("departed_at"):
            try:
                r_end = datetime.fromisoformat(row["departed_at"].replace("Z", "+00:00")).timestamp()
            except (ValueError, TypeError, AttributeError):
                pass
        # A row that only BEGINS after the stop ended is the next place the user went,
        # not this one. 2026-10-07: the user's "מילק בייקרי" for the 08:39–09:23 café
        # was written onto the Airbnb rows that opened at 09:41, 250 m away,
        # because their arrival sat inside the +30 min tail of the ask window.
        by_proximity = (d <= 300 and window_start <= r_start <= window_end
                        and r_start <= stop_end + PROXIMITY_AFTER_END_S)
        overlap_s = max(0.0, min(stop_end, r_end) - max(stop_start, r_start))
        # One visit, not a stop inside a stay (2026-10-17): the user's "Café Antilia" (38 min)
        # renamed the flat's 05:39-14:20 row it sat inside, so the morning at the flat
        # became the café; answering for the flat would rename the café rows the same
        # way. A twin shares most of BOTH windows; a much shorter row wholly inside the
        # answered window is a stop within it, under either clause. Only for an exact
        # window (save-visit: the answered row's own): a card's or a live stop's window
        # is smeared by the walk in, which is what the overlap clause exists for.
        full_reach = os.environ.get("LC_OVERLAP_SHARE") == "0" or not ask.get("exact_window")
        shared = full_reach or overlap_s >= OVERLAP_SHARE * max(stop_end - stop_start, r_end - r_start)
        # Both clauses below wanted a minute between the two arrivals, because a twin
        # shares its arrival. Once, the user's name for an 08:49-08:58 bakery
        # visit renamed the 08:49-13:47 row of the morning at the flat, 206 m away,
        # which iOS opened on the very same second. A twin of one visit shares its
        # point as well as its arrival; a row that shares only the arrival, from
        # SAME_START_APART_M or more away, is another place, so it needs no minute.
        apart = d >= SAME_START_APART_M
        # (closed rows only, and a quarter of the window at most: an open row is the
        # live stop save-current is naming, inside a window smeared by the walk in)
        inner = (not full_reach and bool(row.get("departed_at"))
                 and (r_start > stop_start + 60 or (apart and r_start >= stop_start - 60))
                 and r_end < stop_end - 60
                 and (r_end - r_start) < INNER_SHARE * (stop_end - stop_start))
        # ...and the mirror (2026-10-23): the user's "Asufa" for the 14:16-14:25 visit also
        # renamed the 14:12-17:35 rows of the afternoon at the flat 34 m away, which
        # arrived four minutes before it, inside the ±30 min arrival window the
        # proximity clause trusts. A row the answered window sits wholly inside, at a
        # quarter of the row's length at most, is the stay around the stop, not it.
        outer = (not full_reach and bool(row.get("departed_at"))
                 and (stop_start > r_start + 60 or (apart and stop_start >= r_start - 60))
                 and stop_end < r_end - 60
                 and (stop_end - stop_start) < INNER_SHARE * (r_end - r_start))
        if inner or outer:
            continue
        # A row already settled as not-a-stop is renamed only when it is this visit
        # (2026-10-19). The user's "Aricha Sabich" for the 15:58-16:31 row also renamed the
        # walk in from Shomron Street, 273 m away, 11 minutes earlier, that
        # stop-passage had judged moving the whole time; the row was still open, the
        # sweeper later closed it at 19:59, and the name ran through the market and
        # into the football game. Arriving within the ±30 min ask window is nearness,
        # not identity: a twin shares its arrival or most of both windows.
        if (not full_reach and row.get("place_type") == "non-stop" and not shared
                and abs(r_start - stop_start) > TWIN_ARRIVAL_S):
            continue
        by_overlap = overlap_s >= OVERLAP_MIN_S and d <= OVERLAP_MAX_DIST_M and shared
        if by_proximity or by_overlap:
            matches.append(row)
            reasons.append("proximity" if by_proximity else f"overlap {overlap_s / 60:.0f}min @{d:.0f}m")
    if not matches:
        # A silent no-op here is indistinguishable from success in every store,
        # which is exactly why this went unnoticed. Say so.
        print(
            f"location-confirm: no location_history visit row matched ask "
            f"{ask.get('ask_id')} (centroid {lat:.5f},{lon:.5f}, {len(rows or [])} "
            f"row(s) in window) — place_name NOT written back, so location-enrich "
            f"may still ask about this stop",
            file=sys.stderr,
        )
        return False
    success = 0
    for row, why in zip(matches, reasons):
        upd = {"place_name": place_name, "place_type": place_type}
        # A name read out of the user's sentence replaces the sentence findme resolve
        # wrote as place_name; the sentence itself stays on the row, in notes
        # (where `findme note` keeps the rest of an answer), tagged as ours.
        notes = row.get("notes") or ""
        if answer and answer not in notes:
            upd["notes"] = (notes + "\n" if notes else "") + f"[his answer] {answer}"
        body = json.dumps(upd).encode("utf-8")
        patch_url = f"{SUPABASE_URL}/rest/v1/location_history?id=eq.{urllib.parse.quote(str(row['id']))}"
        req = urllib.request.Request(
            patch_url,
            data=body,
            method="PATCH",
            headers={
                "apikey": key,
                "Authorization": f"Bearer {key}",
                "Content-Type": "application/json",
                "Prefer": "return=minimal",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=8) as resp:
                if 200 <= resp.status < 300:
                    success += 1
                    print(
                        f"location-confirm: patched visit {str(row.get('id'))[:8]} "
                        f"→ {place_name!r} (matched by {why})",
                        file=sys.stderr,
                    )
        except Exception as e:
            print(f"location-confirm: patch row {row.get('id')} failed: {e}", file=sys.stderr)
    return success > 0

def _load_json(path, default):
    if not os.path.exists(path):
        return default
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default

def _save_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)

SKIP_TOKEN = "skip"


def _resolve_candidate(ask: dict, name_or_idx: str) -> dict | None:
    # "skip" is OUR protocol token (chat-agent procedures/location-confirm-reply.md
    # passes it for "no" / "not a stop"), never a place. It was documented as
    # special-cased here and never was: on 2026-10-05 "no stop last night" was
    # saved as a place CALLED "skip" on five rows of the user's own flat, and
    # day-segments' confirmed rung then named the next night there "skip".
    if name_or_idx.strip() == SKIP_TOKEN:
        return {"name": None, "source": "user_skipped", "address": None,
                "place_id": None, "primary_type": None}
    candidates = [ask.get("primary")] + (ask.get("alternatives") or [])
    candidates = [c for c in candidates if c]
    # Allow 1-based index ("1" / "2" / "3")
    if name_or_idx.isdigit():
        i = int(name_or_idx) - 1
        if 0 <= i < len(candidates):
            return candidates[i]
        return None
    # Otherwise match by case-insensitive substring against the name.
    needle = name_or_idx.strip().lower()
    for c in candidates:
        if needle == c["name"].lower():
            return c
    for c in candidates:
        if needle in c["name"].lower():
            return c
    # Last resort: caller may have typed a wholly new name. Accept it as a free-text
    # confirmation — sometimes the user corrects a wrong candidate list.
    return {"name": name_or_idx.strip(), "source": "user_freeform",
            "address": None, "place_id": None, "primary_type": None}


def _write_confirmation(ask: dict, chosen: dict, ask_id: str, remove_pending: bool = True,
                        patch_history: bool = True) -> dict | None:
    """Shared write path for both save and save-current: append to
    CONFIRMED_FILE, patch location_history, optionally drop the ask from
    pending, and dispatch a silent re-render for any already-shipped day.
    Returns the stored entry, or None if the centroid guard refused the
    write.

    patch_history=False (save-at, 2026-10-17): no location_history patch, so no
    re-render; the overlap clause would hand his name to an unrelated row.

    This is the ONE place confirmed-stops.json is written from (per
    agent/ops-agent/jobs/location-confirm-ask.md's "Don't write to
    confirmed-stops.json from anywhere except location-confirm" rule) — every
    subcommand that can produce a confirmation routes through here, so a
    confirmation written from an ordinary chat message is indistinguishable
    downstream from one written by answering a card.
    """
    confirmed = _load_json(CONFIRMED_FILE, [])
    if isinstance(confirmed, dict):
        # Tolerate either shape on read; normalise to list for write.
        confirmed = confirmed.get("entries", [])

    # Guard: never persist a centroid with lat=0 or lon=0 (or missing). The
    # null-island shape signals an upstream resolver bug — better to surface
    # the error than poison the dataset.
    centroid = ask.get("centroid") or {}
    c_lat = centroid.get("lat") if isinstance(centroid, dict) else None
    c_lon = centroid.get("lon") if isinstance(centroid, dict) else None
    if (c_lat in (None, 0, 0.0)) or (c_lon in (None, 0, 0.0)):
        print(
            f"ERROR: ask {ask_id} has invalid centroid {centroid!r} — refusing to save",
            file=sys.stderr,
        )
        return None

    entry = {
        "ts": datetime.now(tz=timezone.utc).isoformat(),
        "ask_id": ask_id,
        "centroid": ask["centroid"],
        "name": chosen["name"],
        "address": chosen.get("address"),
        "place_id": chosen.get("place_id"),
        "primary_type": chosen.get("primary_type"),
        "source": chosen.get("source"),
        **({"answer": chosen["answer"]} if chosen.get("answer") else {}),
        **({"companions": chosen["companions"]} if chosen.get("companions") else {}),
        "stop_window": {
            "start": ask.get("first_sample_ts"),
            "end": ask.get("last_sample_ts"),
            "duration_min": ask.get("duration_min"),
        },
    }
    # Override place_name on the matching location_history row(s) so the
    # resolver picks it up. Free-text confirmations ("12 Chairs Cafe" outside
    # the candidate list) and same-list reorderings both flow through this.
    # This write-back is ALSO the only channel by which location-enrich learns
    # the stop is settled, so its outcome has to be recorded — it is stamped on
    # `entry` BEFORE the file write. It used to be assigned afterwards, which
    # mutated an already-serialised dict: 0 of 47 stored confirmations carried
    # the field, so months of silent write-back failures left no trace anywhere.
    skipped = chosen.get("source") == "user_skipped"
    # A skip withdraws the stop (`non-stop`, the same verdict `findme resolve`
    # writes for "no"), and is NOT appended to confirmed-stops.json: that file
    # auto-names anything within 30 m, and a non-answer must never name a place.
    if patch_history:
        patched = _patch_location_history(ask, None if skipped else chosen["name"],
                                          chosen.get("source") or "user",
                                          place_type="non-stop" if skipped else "user-confirmed",
                                          answer=chosen.get("answer"))
    else:
        patched = False  # also keeps the re-render block below from firing
        entry["patch_skipped"] = "save-at writes no visit row"
    entry["patched_location_history"] = patched

    if not skipped:
        confirmed.append(entry)
        _save_json(CONFIRMED_FILE, confirmed)

    if remove_pending:
        # Drop the ask from pending so it doesn't get re-fired.
        pending = [a for a in _load_json(PENDING_FILE, []) if a.get("ask_id") != ask_id]
        _save_json(PENDING_FILE, pending)

    # If the patch landed on a date whose daily-summary already shipped (i.e.,
    # any date strictly before today in the home zone), dispatch a SILENT re-render so
    # yesterday's email-frozen narrative gets corrected in place — DB row +
    # episode file are rewritten; no email, no push (the original phone
    # pointer already fired). Best-effort; failure here doesn't undo the save.
    if patched:
        rerender_dates = _ask_dates_to_rerender(ask)
        if rerender_dates:
            entry["silent_rerender_dispatched"] = _dispatch_silent_rerender(rerender_dates)
            entry["silent_rerender_dates"] = rerender_dates

    return entry


def cmd_save(args) -> int:
    pending = _load_json(PENDING_FILE, [])
    ask = next((a for a in pending if a.get("ask_id") == args.ask_id), None)
    if ask is None:
        # Fallback: also check recent-asks (the de-duplication store) since the
        # cron moves entries from pending → recent after dispatch.
        recent = _load_json(RECENT_ASKS_FILE, [])
        ask = next((a for a in recent if a.get("ask_id") == args.ask_id), None)
    if ask is None:
        print(f"ERROR: no pending ask with id={args.ask_id}", file=sys.stderr)
        return 2

    chosen = _resolve_candidate(ask, args.venue)
    if chosen is None:
        cand_names = [c["name"] for c in ([ask.get("primary")] + (ask.get("alternatives") or [])) if c]
        print(f"ERROR: no candidate matches '{args.venue}'. Options: {cand_names}",
              file=sys.stderr)
        return 3

    entry = _write_confirmation(ask, chosen, args.ask_id)
    if entry is None:
        return 4

    # The user picked something other than our lead guess → that is a correction.
    # Identity, not string comparison: `chosen` IS the primary dict when the user
    # took it (by index or by name), and a different object otherwise.
    primary = ask.get("primary")
    if (primary and chosen is not primary and chosen.get("source") != "user_skipped"
            and chosen.get("name") and primary.get("name")):
        entry["drift_recorded"] = _record_drift(
            centroid=ask.get("centroid"), stop_start=ask.get("first_sample_ts"),
            expected_name=chosen["name"], actual_name=primary["name"],
            signal="chat_correction", source="location-confirm card",
            promoted=True, visit_id=None, ref=args.ask_id,
        )

    print(json.dumps({"saved": entry}, indent=2))
    return 0


def _current_stop_ask() -> dict | None:
    """Ask location-current-stop for the live dwell. Returns an ask-shaped
    dict (centroid/first_sample_ts/last_sample_ts/duration_min), or None if
    nothing is currently open — either because the user is moving, or because
    he's already left (see _recently_closed_stop_ask for that case)."""
    try:
        out = subprocess.run(
            [sys.executable, LOCATION_CURRENT_STOP],
            capture_output=True, text=True, timeout=20,
        )
        payload = json.loads(out.stdout)
    except Exception as e:
        print(f"location-confirm: location-current-stop failed: {e}", file=sys.stderr)
        return None
    if not payload.get("is_stop"):
        return None
    centroid = payload.get("centroid")
    if not isinstance(centroid, dict) or centroid.get("lat") is None or centroid.get("lon") is None:
        return None
    return {
        "centroid": centroid,
        "first_sample_ts": payload.get("first_sample_ts"),
        "last_sample_ts": payload.get("last_sample_ts"),
        "duration_min": payload.get("duration_min"),
    }


def _recently_closed_stop_ask(lookback_min: float) -> dict | None:
    """The 'or just closed, if you'd already left' half: the most recently
    DEPARTED location_history visit row within lookback_min. location-current-
    stop only sees an ongoing dwell — once the user has walked away there is
    nothing 'current' for it to report, but a message like 'just left Pho
    Grand' still needs somewhere to attach the confirmation."""
    key = _supabase_key()
    if not key:
        return None
    now = datetime.now(tz=timezone.utc)
    fetch_start_iso = (now - timedelta(minutes=lookback_min + 15)).isoformat()
    select_qs = (
        "select=latitude,longitude,arrived_at,departed_at"
        "&segment_type=eq.visit&departed_at=not.is.null"
        f"&departed_at=gte.{urllib.parse.quote(fetch_start_iso)}"
        "&order=departed_at.desc&limit=1"
    )
    req = urllib.request.Request(
        f"{SUPABASE_URL}/rest/v1/location_history?{select_qs}",
        headers={"apikey": key, "Authorization": f"Bearer {key}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            rows = json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"location-confirm: recently-closed lookup failed: {e}", file=sys.stderr)
        return None
    if not rows:
        return None
    row = rows[0]
    if row.get("latitude") is None or row.get("longitude") is None:
        return None
    try:
        departed = datetime.fromisoformat(row["departed_at"].replace("Z", "+00:00"))
    except Exception:
        return None
    if (now - departed).total_seconds() > lookback_min * 60:
        return None
    arrived_iso = row.get("arrived_at")
    duration_min = None
    try:
        arrived = datetime.fromisoformat(arrived_iso.replace("Z", "+00:00"))
        duration_min = round((departed - arrived).total_seconds() / 60.0, 1)
    except Exception:
        pass
    return {
        "centroid": {"lat": row["latitude"], "lon": row["longitude"]},
        "first_sample_ts": arrived_iso,
        "last_sample_ts": row.get("departed_at"),
        "duration_min": duration_min,
    }


def _latest_fix_since(since_iso: str | None) -> dict | None:
    """His newest usable GPS fix at or after `since_iso` (the closed stop's
    departure), or None when there is none or the lookup fails."""
    key = _supabase_key()
    if not key or not since_iso:
        return None
    select_qs = (
        "select=latitude,longitude,accuracy_m,arrived_at"
        "&segment_type=eq.transit"
        f"&arrived_at=gte.{urllib.parse.quote(since_iso)}"
        "&order=arrived_at.desc&limit=20"
    )
    req = urllib.request.Request(
        f"{SUPABASE_URL}/rest/v1/location_history?{select_qs}",
        headers={"apikey": key, "Authorization": f"Bearer {key}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            rows = json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"location-confirm: latest-fix lookup failed: {e}", file=sys.stderr)
        return None
    for r in rows or []:
        acc = r.get("accuracy_m")
        if r.get("latitude") is None or r.get("longitude") is None:
            continue
        if isinstance(acc, (int, float)) and acc > DIRECT_SAVE_FIX_ACC_M:
            continue
        return r
    return None


def _moved_on_from(ask: dict) -> float | None:
    """How far he is from a stop that has already CLOSED, when that is far enough
    that he has left it (2026-10-28). save-current names where he is standing; the
    closed-stop fallback exists for a visit iOS closed while he was still there.
    "Back at the cafe for coffee", typed minutes after leaving the flat, was saved
    onto the flat's overnight rows and its centroid, and named the night and a later
    evening at the flat after the cafe. None when he is still near it, or when no
    fix since its departure can tell (the old behaviour)."""
    c = ask.get("centroid") or {}
    lat, lon = c.get("lat"), c.get("lon")
    if not isinstance(lat, (int, float)) or not isinstance(lon, (int, float)):
        return None
    fix = _latest_fix_since(ask.get("last_sample_ts"))
    if fix is None:
        return None
    d = _haversine_m(lat, lon, float(fix["latitude"]), float(fix["longitude"]))
    return d if d > DIRECT_SAVE_MOVED_ON_M else None


def _recent_duplicate_confirmation(name: str, lat: float, lon: float) -> bool:
    """A save-current-specific guard: the same place stated twice in quick
    succession (a repeated message, a duplicate trigger) shouldn't pile up
    duplicate confirmations. A LATER, genuinely different visit to the same
    place is still allowed through — this only catches the same stop being
    written twice. `save` doesn't need this: its ask_id-based idempotency
    already prevents the same ask being saved twice, and a fresh ask_id per
    dwell means a second real visit gets its own row regardless."""
    confirmed = _load_json(CONFIRMED_FILE, [])
    if isinstance(confirmed, dict):
        confirmed = confirmed.get("entries", [])
    cutoff = datetime.now(tz=timezone.utc) - timedelta(hours=DIRECT_SAVE_DEDUP_WINDOW_H)
    for e in confirmed:
        if str(e.get("name", "")).strip().lower() != name.strip().lower():
            continue
        ec = e.get("centroid") or {}
        elat, elon = ec.get("lat"), ec.get("lon")
        if not isinstance(elat, (int, float)) or not isinstance(elon, (int, float)):
            continue
        ets = _parse_iso(e.get("ts"))
        if ets and ets < cutoff:
            continue
        if _haversine_m(lat, lon, elat, elon) <= DIRECT_SAVE_DEDUP_RADIUS_M:
            return True
    return False


def _entry_day(e: dict) -> str:
    w = e.get("stop_window") or {}
    return str(w.get("start") or e.get("ts") or "")[:10]


def _known_here_as_other(venue: str, lat: float, lon: float, day: str):
    """(name, days) when the spot within DIRECT_SAVE_KNOWN_RADIUS_M is confirmed
    under another name on at least DIRECT_SAVE_KNOWN_MIN_DAYS days other than
    `day`, and never under `venue` itself on another day; else None."""
    confirmed = _load_json(CONFIRMED_FILE, [])
    if isinstance(confirmed, dict):
        confirmed = confirmed.get("entries", [])
    needle = venue.strip().casefold()
    days: dict = {}
    for e in confirmed:
        name = str(e.get("name") or "").strip()
        c = e.get("centroid") or {}
        elat, elon = c.get("lat"), c.get("lon")
        if not name or not isinstance(elat, (int, float)) or not isinstance(elon, (int, float)):
            continue
        d = _entry_day(e)
        if not d or d == day or _haversine_m(lat, lon, elat, elon) > DIRECT_SAVE_KNOWN_RADIUS_M:
            continue
        days.setdefault(name.casefold(), (name, set()))[1].add(d)
    if needle in days:
        return None
    best = max(days.values(), key=lambda v: len(v[1]), default=None)
    if best and len(best[1]) >= DIRECT_SAVE_KNOWN_MIN_DAYS:
        return best[0], len(best[1])
    return None


def cmd_save_current(args) -> int:
    venue = (args.venue or "").strip()
    if not venue:
        print("ERROR: empty venue name", file=sys.stderr)
        return 2

    ask = _current_stop_ask()
    if ask is None:
        ask = _recently_closed_stop_ask(args.lookback_min)
        moved = _moved_on_from(ask) if ask is not None else None
        if moved is not None:
            print(
                f"ERROR: the user has left the stop that just closed (the latest fix is "
                f"{moved:.0f} m from it), so this name is not that stop's; nothing "
                f"written. A place named elsewhere goes through save-at.",
                file=sys.stderr,
            )
            return 5
    if ask is None:
        print(
            "ERROR: no currently-open or recently-closed stop to attach this "
            "confirmation to — nothing written",
            file=sys.stderr,
        )
        return 5

    centroid = ask.get("centroid") or {}
    lat, lon = centroid.get("lat"), centroid.get("lon")
    if isinstance(lat, (int, float)) and isinstance(lon, (int, float)) and not getattr(args, "new_place_here", False):
        known = _known_here_as_other(venue, lat, lon, str(ask.get("first_sample_ts") or "")[:10])
        if known is not None:
            print(
                f"ERROR: where the user is now is already confirmed as \"{known[0]}\" on {known[1]} other "
                f"days, so \"{venue}\" is most likely a place named from here (an earlier stop, a "
                f"Maps link), not this spot; nothing written. For a stop the user was asked about use "
                f"findme resolve <visit_id>; for a place elsewhere use save-at. Only if the user really is "
                f"at a new place on this spot, re-run with --new-place-here.",
                file=sys.stderr,
            )
            return 5
    if isinstance(lat, (int, float)) and isinstance(lon, (int, float)):
        if _recent_duplicate_confirmation(venue, lat, lon):
            print(json.dumps({"saved": None, "reason": "duplicate_recent_confirmation"}))
            return 0

    ask_id = f"lc-direct-{datetime.now(tz=timezone.utc).strftime('%Y%m%d-%H%M%S')}"
    chosen = {
        "name": venue,
        "source": "user_stated_direct",
        "address": None,
        "place_id": None,
        "primary_type": None,
    }
    entry = _write_confirmation(ask, chosen, ask_id, remove_pending=False)
    if entry is None:
        return 4

    print(json.dumps({"saved": entry}, indent=2))
    return 0


# ── save-at and withdraw — see the module docstring. Over three days
# save-current saved a café's name on the flat's doorstep, a restaurant's on a
# street fix 166 m from it, and the lodging's on a bakery.


def _saved_at_already(name: str, lat: float, lon: float, start_dt, end_dt, confirmed) -> bool:
    """Same name within DIRECT_SAVE_DEDUP_RADIUS_M over an overlapping window:
    already saved (a re-run fix loop must not pile up copies)."""
    needle = name.strip().lower()
    for e in confirmed:
        if str(e.get("name") or "").strip().lower() != needle:
            continue
        ec = e.get("centroid") or {}
        elat, elon = (ec.get("lat"), ec.get("lon")) if isinstance(ec, dict) else (None, None)
        if not isinstance(elat, (int, float)) or not isinstance(elon, (int, float)):
            continue
        if _haversine_m(lat, lon, elat, elon) > DIRECT_SAVE_DEDUP_RADIUS_M:
            continue
        w = e.get("stop_window") or {}
        ws = _parse_iso(w.get("start"))
        we = _parse_iso(w.get("end")) or ws
        if ws is None or ws.tzinfo is None or we.tzinfo is None:
            continue
        if ws <= end_dt and start_dt <= we:
            return True
    return False


def cmd_save_at(args) -> int:
    venue = (args.venue or "").strip()
    if not venue or venue.lower() in (SKIP_TOKEN, "unknown", "__other__"):
        # Same protocol-token lock as save-visit: these are never places.
        print("ERROR: not a place name — nothing written", file=sys.stderr)
        return 2
    try:
        lat, lon = float(args.lat), float(args.lon)
    except (TypeError, ValueError):
        print(f"ERROR: --lat/--lon must be numbers (got {args.lat!r}, {args.lon!r}) — nothing written",
              file=sys.stderr)
        return 2
    # 0 is null island (refused downstream too); NaN fails the range test.
    if lat == 0 or lon == 0 or not (-90 <= lat <= 90) or not (-180 <= lon <= 180):
        print(f"ERROR: --lat/--lon out of range ({lat}, {lon}) — nothing written", file=sys.stderr)
        return 2
    start_dt, end_dt = _parse_iso(args.start), _parse_iso(args.end)
    if start_dt is None or end_dt is None:
        print("ERROR: --start/--end must be ISO timestamps — nothing written", file=sys.stderr)
        return 2
    # A zoneless time abroad can be off by the whole dinner; stored windows are zoned.
    if start_dt.tzinfo is None or end_dt.tzinfo is None:
        print("ERROR: --start/--end need a UTC offset — nothing written", file=sys.stderr)
        return 2
    if start_dt > end_dt:
        print("ERROR: --start is after --end — nothing written", file=sys.stderr)
        return 2
    start_dt, end_dt = start_dt.astimezone(timezone.utc), end_dt.astimezone(timezone.utc)

    confirmed = _load_json(CONFIRMED_FILE, [])
    if isinstance(confirmed, dict):
        confirmed = confirmed.get("entries", [])
    if _saved_at_already(venue, lat, lon, start_dt, end_dt, confirmed):
        print(json.dumps({"saved": None, "reason": "already saved"}))
        return 0

    ask = {
        "centroid": {"lat": lat, "lon": lon},
        "first_sample_ts": start_dt.isoformat(),
        "last_sample_ts": end_dt.isoformat(),
        "duration_min": round((end_dt - start_dt).total_seconds() / 60.0, 1),
    }
    # withdraw selects by ask_id: two saves in one second must not share one.
    base = f"lc-at-{datetime.now(tz=timezone.utc).strftime('%Y%m%d-%H%M%S')}"
    taken = {e.get("ask_id") for e in confirmed}
    ask_id, n = base, 1
    while ask_id in taken:
        n += 1
        ask_id = f"{base}-{n}"
    chosen = {
        "name": venue,
        "source": args.source or "user_stated_at",
        "address": None,
        "place_id": None,
        "primary_type": None,
    }
    if (args.answer or "").strip():
        chosen["answer"] = args.answer.strip()
    # Who the user's words put there too ("<a friend>'s pickup at the airport"), carried onto
    # the stop resolve-day builds from this entry. A comma list we were handed, not prose.
    comps = []
    for c in (getattr(args, "companions", None) or "").split(","):
        if c.strip() and c.strip() not in comps:
            comps.append(c.strip())
    if comps:
        chosen["companions"] = comps
    entry = _write_confirmation(ask, chosen, ask_id, remove_pending=False, patch_history=False)
    if entry is None:
        return 4

    print(json.dumps({"saved": entry}, indent=2))
    return 0


def cmd_withdraw(args) -> int:
    reason = (args.reason or "").strip()
    if not reason:
        print("ERROR: --reason is required — nothing written", file=sys.stderr)
        return 2
    confirmed = _load_json(CONFIRMED_FILE, [])
    if isinstance(confirmed, dict):
        confirmed = confirmed.get("entries", [])
    only_name = getattr(args, "only_name", None)
    if only_name is not None and args.name is not None:
        print("ERROR: give --name or --only-name, not both — nothing written", file=sys.stderr)
        return 2

    def selected(e):
        return e.get("ask_id") == args.ask_id and (only_name is None or e.get("name") == only_name)

    matched = [e for e in confirmed if selected(e)]
    if not matched:
        which = f" named {only_name!r}" if only_name is not None else ""
        print(f"ERROR: no confirmed stop with ask_id={args.ask_id}{which} — nothing written", file=sys.stderr)
        return 2
    # ask_ids are not unique (a card answered twice, a resolver promotion on
    # top), so --name guards against taking out a different place than meant.
    if args.name is not None and any(e.get("name") != args.name for e in matched):
        print(f"ERROR: ask_id={args.ask_id} holds {[e.get('name') for e in matched]!r}, "
              f"not only {args.name!r} — nothing written", file=sys.stderr)
        return 3
    archive = _load_json(WITHDRAWN_FILE, None)
    if (archive is None and os.path.exists(WITHDRAWN_FILE)) or (
            archive is not None and not isinstance(archive, list)):
        # Rewriting an unreadable archive would keep only this withdrawal and
        # lose every earlier one.
        print(f"ERROR: {WITHDRAWN_FILE} is unreadable or not a list — nothing written",
              file=sys.stderr)
        return 4
    at = datetime.now(tz=timezone.utc).isoformat()
    moved = [{**e, "withdrawn": {"at": at, "reason": reason}} for e in matched]
    # Archive FIRST: a crash between the two writes leaves the entry in both
    # files (re-running withdraw finishes the job), never in neither.
    _save_json(WITHDRAWN_FILE, (archive or []) + moved)
    remaining = [e for e in confirmed if not selected(e)]
    _save_json(CONFIRMED_FILE, remaining)
    print(json.dumps({"withdrawn": moved, "remaining": len(remaining)}, indent=2))
    return 0


# ── Every answer reaches the durable stores (2026-10-06) ───────────────────
#
# Until today only answers to a location-confirm CARD reached
# confirmed-stops.json. An answer to a hum ask, a typed chat correction, or a
# tapped segment-ask button all went through `findme resolve`, which patches
# the one location_history row and stops — so the fast lane never learned the
# place, and the next stop there was asked about again. Asked "18m near
# <café> … a bite there?", the user answered "Ate breakfast at <another
# café>"; the row took it, confirmed-stops.json never did (three
# entries landed all week, every one from a card).
#
# The drift ledger had the same hole one level up: `daily_log_drift[]` in
# nightly-review-state.json was written ONLY by the weekly review agent, when
# it happened to notice a correction in a week of chat. Nothing in code wrote
# it, which is why it went silent after 2026-09-18 while corrections kept
# arriving. Now the correction writes its own drift row at the moment it
# lands: what Jori guessed, what the user said, and whether it was promoted.
#
# `save-visit` is the entry point findme resolve calls; it keeps this file the
# ONE writer of confirmed-stops.json (location-confirm-ask.md's rule).
NIGHTLY_STATE_FILE = os.path.join(DATA_DIR, "nightly-review-state.json")
USER_TZ_FILE = os.path.join(DATA_DIR, "user-timezone.json")
# A confirmed stop auto-names everything within 30 m, so its name has to read
# as a place. An answer longer than this is a sentence the user typed
# ("Breakfast at <café> in the flea market, not <the café you guessed>") —
# right for the user's own row and the drift ledger, wrong as the label for every future visit.
# The length test is a property of the field (the stop-identify `_context`
# precedent), never a reading of the words. Since 2026-10-13 a longer answer is
# promoted under the confident place name a model reads out of it (_place_label).
PROMOTE_MAX_NAME_CHARS = 60
LABEL_READER = os.path.join(os.path.dirname(BIN_DIR), "lib", "location-answer-name.mjs")


def _place_label(answer: str, stop: str | None = None, guess: str | None = None) -> str | None:
    """The confident place name in a sentence answer (lib/location-answer-
    name.mjs, Rule #0b). `stop` ("Mon 12 Oct, 09:02–09:18") and `guess` only let
    the model tell which of several places he named was this stop. None if he
    hedged, asked, named another or an unclear stop, or the model failed or timed
    out: the answer then stays row-only, as before."""
    node = shutil.which("node") or "/opt/homebrew/bin/node"
    try:
        r = subprocess.run([node, LABEL_READER],
                           input=json.dumps({"text": answer, "stop": stop, "guess": guess}),
                           capture_output=True, text=True, timeout=30)
        out = json.loads((r.stdout or "").strip().splitlines()[-1])
    except Exception as e:
        print(f"location-confirm: place-name reader failed: {e}", file=sys.stderr)
        return None
    name = str(out.get("place_name") or "").strip()
    if out.get("answer") != "place" or not 2 <= len(name) <= PROMOTE_MAX_NAME_CHARS:
        return None
    return name


def _user_tz():
    from zoneinfo import ZoneInfo
    try:
        return ZoneInfo((_load_json(USER_TZ_FILE, {}) or {}).get("timezone") or HOME_TZ)
    except Exception:
        return ZoneInfo(HOME_TZ)


def _stop_local_date(ts_iso):
    dt = _parse_iso(ts_iso) or datetime.now(tz=timezone.utc)
    return dt.astimezone(_user_tz()).date().isoformat()


def _stop_window_label(arrived, departed):
    """'Mon 12 Oct, 09:02–09:18' in his timezone — time formatting, not language."""
    a, d = _parse_iso(arrived), _parse_iso(departed)
    if not a:
        return None
    a = a.astimezone(_user_tz())
    return f"{a:%a %d %b}, {a:%H:%M}" + (f"–{d.astimezone(_user_tz()):%H:%M}" if d else "")


def _record_drift(*, centroid, stop_start, expected_name, actual_name, signal,
                  source, promoted, visit_id=None, ref=None, promoted_name=None) -> bool:
    """Append one correction to nightly-review-state.json `daily_log_drift[]`
    (the shape jobs/nightly-review.md documents). Never creates or clobbers the
    review's state: a missing or unreadable file is left alone. Idempotent per
    (ref, expected_name) — ref is the visit id, or the card's ask_id. A repeat
    that CAN now be promoted closes the row this file left open."""
    ref = ref or visit_id
    if not expected_name or not actual_name:
        return False
    state = _load_json(NIGHTLY_STATE_FILE, None)
    if not isinstance(state, dict):
        print("location-confirm: nightly-review-state.json unreadable — drift not recorded",
              file=sys.stderr)
        return False
    ledger = state.setdefault("daily_log_drift", [])
    if not isinstance(ledger, list):
        return False
    now_iso = datetime.now(tz=timezone.utc).isoformat()
    # A name a MODEL read out of the user's sentence is flagged, so the weekly roundup
    # can show it as such instead of folding it into "fixed".
    extra = ({"promoted_name": promoted_name, "promoted_from_sentence_at": now_iso}
             if promoted and promoted_name and promoted_name != expected_name else {})
    for e in ledger:
        if ref and e.get("ref") == ref and e.get("expected_name") == expected_name:
            if not (promoted and e.get("fix_status") == "open"
                    and e.get("recorded_by") == "location-confirm"):
                return False
            e.update({"fix_status": "auto_resolved", "resolved_at": now_iso, **extra})
            _save_json(NIGHTLY_STATE_FILE, state)
            return True
    ledger.append({
        "date": _stop_local_date(stop_start),
        "centroid": centroid,
        "expected_name": expected_name,
        "actual_name": actual_name,
        "source": source,
        "signal": signal,
        # Promoted to confirmed-stops.json at write time = already fixed; the
        # nightly auto-promote rule has nothing left to do for it.
        "fix_status": "auto_resolved" if promoted else "open",
        "visit_id": visit_id,
        "ref": ref,
        "recorded_at": now_iso,
        "recorded_by": "location-confirm",
        **extra,
    })
    _save_json(NIGHTLY_STATE_FILE, state)
    return True


def _fetch_visit(visit_id: str) -> dict | None:
    key = _supabase_key()
    if not key:
        return None
    qs = (f"id=eq.{urllib.parse.quote(visit_id)}"
          "&select=id,latitude,longitude,arrived_at,departed_at&limit=1")
    req = urllib.request.Request(
        f"{SUPABASE_URL}/rest/v1/location_history?{qs}",
        headers={"apikey": key, "Authorization": f"Bearer {key}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            rows = json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"location-confirm: visit lookup failed: {e}", file=sys.stderr)
        return None
    return rows[0] if rows else None


def cmd_save_visit(args) -> int:
    venue = (args.venue or "").strip()
    if not venue or venue.lower() in (SKIP_TOKEN, "unknown", "__other__"):
        # Protocol tokens are never places (findme resolve handles them before
        # it ever calls here; this is the second lock on the same door).
        print("ERROR: not a place name — nothing written", file=sys.stderr)
        return 2
    row = _fetch_visit(args.visit_id)
    if not row or row.get("latitude") is None or row.get("longitude") is None:
        print(f"ERROR: no visit row {args.visit_id} with a position — nothing written",
              file=sys.stderr)
        return 5
    arrived, departed = row.get("arrived_at"), row.get("departed_at") or row.get("arrived_at")
    duration = None
    a_dt, d_dt = _parse_iso(arrived), _parse_iso(departed)
    if a_dt and d_dt:
        duration = round((d_dt - a_dt).total_seconds() / 60.0, 1)
    ask = {
        "centroid": {"lat": row["latitude"], "lon": row["longitude"]},
        "first_sample_ts": arrived,
        "last_sample_ts": departed,
        "duration_min": duration,
        "exact_window": True,   # the row's own window (see _patch_location_history)
    }
    ask_id = f"lc-visit-{args.visit_id}"
    confirmed = _load_json(CONFIRMED_FILE, [])
    if isinstance(confirmed, dict):
        confirmed = confirmed.get("entries", [])
    # `answer`: a sentence promoted under the name read out of it (below).
    already = any(e.get("ask_id") == ask_id and venue in (e.get("name"), e.get("answer"))
                  for e in confirmed)
    label = venue
    if not already and len(venue) > PROMOTE_MAX_NAME_CHARS:
        # Before any write: a failed read writes nothing.
        label = _place_label(venue, _stop_window_label(arrived, departed),
                             (args.guess or "").strip() or None)

    promoted, entry, why = False, None, None
    if already:
        why = "already promoted"
        promoted = True
    elif not label:
        why = f"answer is {len(venue)} chars, no confident place name read from it; row only"
    else:
        chosen = {"name": label, "source": args.source or "user_answer",
                  "address": None, "place_id": None, "primary_type": None}
        if label != venue:
            chosen["answer"] = venue
        entry = _write_confirmation(ask, chosen, ask_id, remove_pending=False)
        promoted = entry is not None
        if entry is None:
            why = "centroid guard refused"

    drifted = False
    if args.guess and args.guess.strip():
        drifted = _record_drift(
            centroid=ask["centroid"], stop_start=arrived,
            expected_name=venue, actual_name=args.guess.strip(),
            signal=args.signal or "chat_correction", source=args.source or "findme_resolve",
            promoted=promoted, visit_id=args.visit_id, promoted_name=label,
        )
    print(json.dumps({"visit_id": args.visit_id, "promoted": promoted, "reason": why,
                      "drift_recorded": drifted, "saved": entry}))
    return 0


def _parse_iso(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except Exception:
        return None


def _ask_dates_to_rerender(ask: dict) -> list[str]:
    """Return YYYY-MM-DD strings (home zone) covered by the ask's GPS window,
    filtered to dates strictly before today in the home zone.

    Today's summary hasn't been generated yet (the cron runs at 00:10 home time on
    "yesterday"), so a confirmation that lands today and patches today's
    location_history row needs no re-render — the upcoming nightly run sees
    it. Only finalized days (yesterday or earlier with an existing
    daily_summaries row) need the silent re-render.
    """
    try:
        from zoneinfo import ZoneInfo  # py3.9+
    except Exception:
        return []
    et = ZoneInfo(HOME_TZ)
    start = ask.get("first_sample_ts")
    end = ask.get("last_sample_ts") or start
    if not start:
        return []
    try:
        start_dt = datetime.fromisoformat(start.replace("Z", "+00:00")).astimezone(et)
        end_dt = datetime.fromisoformat(end.replace("Z", "+00:00")).astimezone(et)
    except Exception:
        return []
    today_et = datetime.now(tz=et).date()
    out: list[str] = []
    cur = start_dt.date()
    while cur <= end_dt.date():
        if cur < today_et:
            out.append(cur.isoformat())
        cur = cur + timedelta(days=1)
    return out


def _dispatch_silent_rerender(dates: list[str]) -> int:
    """Best-effort POST to the ops supervisor for each date that needs a
    silent daily-summary re-render after this confirmation. Returns the
    count of successfully-dispatched re-renders. Failures are logged to
    stderr — the save itself has already succeeded.
    """
    if not dates:
        return 0
    token_path = os.path.join(INSTALL_ROOT, "secrets", "webhook-token")
    try:
        with open(token_path) as f:
            token = f.read().strip()
    except Exception:
        print("location-confirm: no webhook token, skipping silent re-render", file=sys.stderr)
        return 0
    sent = 0
    for d in dates:
        body = json.dumps({
            # `content`, not `task`: :9093/dispatch reads payload.content, so
            # until 2026-10-08 every late-correction re-render reached the ops
            # agent as the literal task "undefined" and nothing re-rendered.
            "content": f"DAILY SUMMARY {d} SILENT",
            "source": "late-correction-rerender",
        }).encode("utf-8")
        req = urllib.request.Request(
            "http://localhost:9093/dispatch",
            data=body,
            method="POST",
            headers={
                "Authorization": f"Bearer {token}",
                "Content-Type": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=5) as resp:
                if 200 <= resp.status < 300:
                    sent += 1
                    print(f"location-confirm: dispatched silent re-render for {d}", file=sys.stderr)
        except Exception as e:
            print(f"location-confirm: re-render dispatch failed for {d}: {e}", file=sys.stderr)
    return sent


def cmd_prune(args) -> int:
    """Drop stale entries from pending + recent so chat-agent + dedup stay sane.

    pending TTL defaults to 6h: an ask older than that is no longer relevant
    (the user moved on; resolver-day will see the underlying GPS row regardless).
    recent TTL defaults to 24h: same-day anti-spam window.
    Always rewrites recent.json so the file exists for chat-agent reads.
    """
    now = datetime.now(tz=timezone.utc)
    pending_cutoff = now - timedelta(hours=args.pending_ttl_h)
    recent_cutoff = now - timedelta(hours=args.recent_ttl_h)

    pending = _load_json(PENDING_FILE, [])
    if not isinstance(pending, list):
        pending = []
    kept_pending = []
    for e in pending:
        ts = _parse_iso(e.get("last_sample_ts") or e.get("first_sample_ts"))
        if ts and ts > pending_cutoff:
            kept_pending.append(e)
    pruned_pending = len(pending) - len(kept_pending)
    if pruned_pending > 0:
        _save_json(PENDING_FILE, kept_pending)

    recent = _load_json(RECENT_ASKS_FILE, [])
    if not isinstance(recent, list):
        recent = []
    kept_recent = []
    for e in recent:
        ts = _parse_iso(e.get("last_sample_ts") or e.get("first_sample_ts"))
        if ts and ts > recent_cutoff:
            kept_recent.append(e)
    pruned_recent = len(recent) - len(kept_recent)
    _save_json(RECENT_ASKS_FILE, kept_recent)

    print(json.dumps({
        "pending": {"kept": len(kept_pending), "pruned": pruned_pending},
        "recent": {"kept": len(kept_recent), "pruned": pruned_recent},
    }))
    return 0


def cmd_list(args) -> int:
    confirmed = _load_json(CONFIRMED_FILE, [])
    if isinstance(confirmed, dict):
        confirmed = confirmed.get("entries", [])
    pending = _load_json(PENDING_FILE, [])
    print("=== confirmed stops (last 10) ===")
    for e in confirmed[-10:]:
        c = e.get("centroid") or {}
        lat = c.get("lat") if isinstance(c, dict) else (c[0] if isinstance(c, (list, tuple)) and len(c) >= 2 else None)
        lon = c.get("lon") if isinstance(c, dict) else (c[1] if isinstance(c, (list, tuple)) and len(c) >= 2 else None)
        coord = f"@({lat:.4f},{lon:.4f})" if isinstance(lat, (int, float)) and isinstance(lon, (int, float)) else "@(?,?)"
        print(f"  {e['ts'][:16]}  {e['name']:30s}  {coord}")
    print()
    print(f"=== pending asks ({len(pending)}) ===")
    for a in pending:
        cand = a.get("primary", {}).get("name", "?")
        alts = ", ".join(c.get("name","?") for c in a.get("alternatives", []))
        print(f"  {a['ask_id']}  {cand} [{alts}]  age={a.get('age_min','?')}min")
    return 0

def main(argv=None) -> int:
    p = argparse.ArgumentParser(description="Record + manage venue confirmations")
    sub = p.add_subparsers(dest="cmd", required=True)
    sp_save = sub.add_parser("save", help="record a confirmation for a pending ask")
    sp_save.add_argument("ask_id")
    sp_save.add_argument("venue", help="venue name OR 1-based index from the ask")
    sp_save_current = sub.add_parser(
        "save-current",
        help="record a confirmation against the currently-open (or just-closed) stop — no ask_id needed",
    )
    sp_save_current.add_argument("venue", help="venue name the user stated")
    sp_save_current.add_argument(
        "--lookback-min", type=float, default=DIRECT_SAVE_LOOKBACK_MIN,
        help=f"how far back a just-closed stop can be to still count (default {DIRECT_SAVE_LOOKBACK_MIN:g})",
    )
    sp_save_current.add_argument(
        "--new-place-here", action="store_true",
        help="save even though this spot is already confirmed as another place on other days",
    )
    sp_save_visit = sub.add_parser(
        "save-visit",
        help="promote an answer already written to a visit row (findme resolve) into "
             "confirmed-stops.json, and record the correction in the drift ledger",
    )
    sp_save_visit.add_argument("visit_id")
    sp_save_visit.add_argument("venue", help="the name he gave")
    sp_save_visit.add_argument("--guess", help="what Jori had guessed (records a drift row)")
    sp_save_visit.add_argument("--signal", default="chat_correction",
                               help="drift signal: chat_correction | unknown_answered | late_confirm")
    sp_save_visit.add_argument("--source", default="findme_resolve")
    sp_save_at = sub.add_parser(
        "save-at",
        help="record a place he named at given coordinates and window (a Maps link, a "
             "past-tense 'we had dinner at X') — NOT where he is now, so never save-current; "
             "patches no visit row",
    )
    sp_save_at.add_argument("venue", help="the place name he gave")
    sp_save_at.add_argument("--lat", required=True, help="latitude of the place itself")
    sp_save_at.add_argument("--lon", required=True, help="longitude of the place itself")
    sp_save_at.add_argument("--start", required=True, help="ISO timestamp with offset: when he was there from")
    sp_save_at.add_argument("--end", required=True, help="ISO timestamp with offset: when he was there until")
    sp_save_at.add_argument("--source", help="entry source (default user_stated_at)")
    sp_save_at.add_argument("--answer", help="his words, kept on the entry")
    sp_save_at.add_argument("--companions", help="comma-separated people his words put there with him")
    sp_withdraw = sub.add_parser(
        "withdraw",
        help="take a wrong entry out of confirmed-stops.json, archiving it whole in "
             "confirmed-stops-withdrawn.json; touches no visit row",
    )
    sp_withdraw.add_argument("ask_id", help="exact ask_id of the entry (every entry with it is withdrawn, unless --only-name narrows it)")
    sp_withdraw.add_argument("--reason", required=True, help="why it is wrong (kept in the archive)")
    sp_withdraw.add_argument("--name", help="refuse unless every entry with this ask_id has exactly this name")
    sp_withdraw.add_argument("--only-name", dest="only_name",
                             help="withdraw only the entries under this ask_id saved with exactly this name; keep the rest")
    sub.add_parser("list", help="show recent confirmations + pending asks")
    sp_prune = sub.add_parser("prune", help="drop stale pending/recent asks (cron hygiene)")
    sp_prune.add_argument("--pending-ttl-h", type=float, default=6.0)
    sp_prune.add_argument("--recent-ttl-h", type=float, default=24.0)
    args = p.parse_args(argv if argv is not None else sys.argv[1:])
    return {
        "save": cmd_save,
        "save-current": cmd_save_current,
        "save-visit": cmd_save_visit,
        "save-at": cmd_save_at,
        "withdraw": cmd_withdraw,
        "list": cmd_list,
        "prune": cmd_prune,
    }[args.cmd](args)

if __name__ == "__main__":
    sys.exit(main())
