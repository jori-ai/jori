#!/usr/bin/env node
// build-park — a chat build asks the user one question and resumes the same
// session with the answer. Logic and the full flow: lib/build-park.mjs;
// design: docs/chat-build-park.md.
//
// Inside a chat build (the playbook, jobs/chat-build.md § Asking the user):
//   build-park ask --id "$JORI_CHAT_BUILD_REQUEST" --question "<question>" \
//     --option "<label>" --option "<label>" [--option …] [--recommended <0-based index>] \
//     [--context "<one sentence: what you have done so far>"]
//   then end your turn without writing the report.
//
// The trigger (trigger-chat-build.sh), after the run:
//   build-park park --id <id> --session-file <file with the run's session id>
//     exit 0 parked (card sent or held), 1 not parked (fall back to the report)
//   build-park resume-task --id <id> --result <path>   the resumed run's opening message
//   build-park sweep                                    drop builds unanswered for 30 days
//
// The answer (lib/choice-reply.mjs on a tap; the chat agent on a typed reply):
//   build-park answer --id <id> --option "<the tapped label, exactly>"
//   build-park answer --id <id> --text "<the user's own words>"
//
//   build-park list                                     parked builds

import fs from "node:fs";
import path from "node:path";
import { ask, park, answer, sweep, resumeTask, queueDir } from "../lib/build-park.mjs";

const argv = process.argv.slice(2);
const cmd = argv[0];
const val = (k) => { const i = argv.indexOf(k); return i >= 0 ? argv[i + 1] : undefined; };
const all = (k) => argv.flatMap((a, i) => (a === k && argv[i + 1] != null ? [argv[i + 1]] : []));
const out = (o) => process.stdout.write(JSON.stringify(o) + "\n");

try {
  if (cmd === "ask") {
    const rec = val("--recommended");
    const r = ask({ id: val("--id"), question: val("--question"), options: all("--option"),
      recommended: rec == null ? null : Number(rec), context: val("--context") || "" });
    out({ ok: true, round: r.round, next: "End your turn now without writing the report. The trigger sends the card; the user's answer resumes this session." });
  } else if (cmd === "park") {
    const sf = val("--session-file");
    let sessionId = "";
    try { sessionId = fs.readFileSync(sf, "utf8").trim(); } catch {}
    const r = park({ id: val("--id"), sessionId });
    out(r);
    process.exit(r.parked ? 0 : 1);
  } else if (cmd === "answer") {
    const r = answer({ id: val("--id"), option: val("--option") ?? null, text: val("--text") ?? null });
    out(r);
    process.exit(r.ok || r.already_answered ? 0 : 2);
  } else if (cmd === "resume-task") {
    const id = val("--id");
    const req = JSON.parse(fs.readFileSync(path.join(queueDir(), "running", `${id}.json`), "utf8"));
    if (!req.resume) process.exit(1);
    process.stdout.write(resumeTask(id, req.resume, val("--result")));
  } else if (cmd === "sweep") {
    out({ swept: sweep() });
  } else if (cmd === "list") {
    const dir = path.join(queueDir(), "parked");
    for (const f of fs.existsSync(dir) ? fs.readdirSync(dir).filter((n) => n.endsWith(".json")) : []) {
      const p = JSON.parse(fs.readFileSync(path.join(dir, f), "utf8"));
      console.log(`${f.replace(/\.json$/, "")}  parked ${p.parked_at}  round ${p.round}  ${p.question}`);
    }
  } else {
    console.error("usage: build-park ask|park|answer|resume-task|sweep|list (see the header)");
    process.exit(64);
  }
} catch (e) {
  console.error(`build-park: ${e.message}`);
  process.exit(3);
}
