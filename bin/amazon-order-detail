#!/usr/bin/env node
// amazon-order-detail — fill in what an Amazon order actually contained, by
// reading the order page the confirmation email refuses to describe.
//
// WHY THIS EXISTS. Amazon anonymised its order mail. A confirmation says, in
// its entirety: "Ordered: 1 Appliances item", an order number, the recipient's
// first name and town, and a total. No product name — not in the subject, not
// in the body, and not in the Shipped or Delivered notices either. receipt-scan
// extracts that faithfully and stores "Appliances item", which categorises
// nothing: a ledger cannot tell a pool vacuum from a coffee machine.
//
// The order page behind the email's own "View order" link has all of it: the
// product, the seller, the line price and the shipping address. This tool
// reads that page through the automation Chrome (:9222) and writes it back
// onto the receipt.
//
// WHY A BROWSER. There is no orders API. Amazon's order pages are gated by
// session cookies, so there is no fetch-and-parse route and no key to buy.
// Same posture as `zestimate`, for the same reasons and with the same limits:
// the account's own orders, from the account's own machine, a few pages a week,
// paced — and it STOPS on a bot challenge rather than hardening the block.
//
// AUTH. The automation Chrome keeps its own profile, separate from the one the
// user browses with. When Amazon has signed it out, the run signs it back in
// once with the user's saved login through bin/site-login (the standing rule
// for every job: log in automatically; credentials go from the password store
// straight into the page, never through this process). One attempt per run,
// never a retry loop: a locked account is a much worse outcome than a stale
// ledger. Only two outcomes reach the user: the saved login did not work (ask
// for the right one), or something else blocked it (a robot check, a one-time
// code, no sign-in form), named so a way around it can be found. This used to
// stop and ask for a sign-in by hand ("Sign it in once by hand"), which the
// rule retired.
//
// OFF without the amazon.com browsing skill (browsing-skills/skills/amazon.com/
// references/order-details.md — the page's selectors live there, private to
// the install): the run says so and exits 0.
//
// Usage:
//   amazon-order-detail                     the last 60 days, newest first
//   amazon-order-detail --since 2026-01-01  reach further back
//   amazon-order-detail --all               no date floor (deliberate backfill)
//   amazon-order-detail --limit 20          cap one run (default 25)
//   amazon-order-detail --only <id,...>     just these order numbers, any age
//   amazon-order-detail --rescan            re-read orders already fetched
//   amazon-order-detail --dry-run           fetch + print, write nothing (never signs in)
//   amazon-order-detail --retry-signin      try the sign-in even inside the 3-day backoff
//   amazon-order-detail --json              machine-readable summary

import fs from "node:fs";
import path from "node:path";
import { execFileSync } from "node:child_process";
import { connect } from "../lib/cdp.mjs";
import { port } from "../lib/ports.cjs";
import supa from "../lib/supabase-rest.js";
import rootLib from "../lib/root.cjs";
import instanceLib from "../lib/instance.cjs";
const { request } = supa;
const { installRoot, installTools } = rootLib;
const { instance } = instanceLib;

const SKILL = path.join(installRoot(), "browsing-skills/skills/amazon.com/references/order-details.md");

// Where bin/site-login signs in, and the page it checks afterwards: the order
// history only loads for a signed-in session.
const SIGNIN_URL =
  "https://www.amazon.com/ap/signin?openid.pape.max_auth_age=0&openid.return_to=https%3A%2F%2Fwww.amazon.com%2F" +
  "&openid.identity=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0%2Fidentifier_select&openid.assoc_handle=usflex" +
  "&openid.mode=checkid_setup&openid.claimed_id=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0%2Fidentifier_select" +
  "&openid.ns=http%3A%2F%2Fspecs.openid.net%2Fauth%2F2.0";
const SIGNED_IN_CHECK_URL = "https://www.amazon.com/gp/css/order-history";

const ARGV = process.argv.slice(2);
const FLAGS = new Set(ARGV.filter((a) => a.startsWith("--")));
const flagVal = (n, d) => {
  const i = ARGV.indexOf(`--${n}`);
  return i >= 0 && ARGV[i + 1] ? ARGV[i + 1] : d;
};
const DRY_RUN = FLAGS.has("--dry-run");
const JSON_OUT = FLAGS.has("--json");
const RESCAN = FLAGS.has("--rescan");
const LIMIT = Number(flagVal("limit", "25"));
const ONLY = (flagVal("only", "") || "").split(",").map((s) => s.trim()).filter(Boolean);

/**
 * How far back a routine run reaches. Sixty days by default, NOT all of it.
 *
 * There are ~300 Amazon receipts with an order number and history is not this
 * tool's job: Amazon's "Request my data" export hands over everything already
 * bought, in bulk, for nothing. Reading those same orders here would be about
 * an hour and a half of page loads against a site that challenges browsers for
 * exactly that pattern — spending the whole risk budget on the half we already
 * have another copy of.
 *
 * `--all` lifts the floor for a deliberate backfill; `--since` sets it.
 */
const SINCE = FLAGS.has("--all")
  ? null
  : flagVal("since", new Date(Date.now() - 60 * 86400000).toISOString().slice(0, 10));

// Human-scale pacing. Not politeness theatre: a burst of rapid loads is the
// signature that gets a browser challenged, and a challenged profile costs far
// more than the seconds saved. Amazon is stricter about this than most.
const DELAY_MS = Number(flagVal("delay", "7000"));

const log = (...a) => { if (!JSON_OUT) console.log(...a); };
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

/**
 * The action body, read from the browsing-skill at run time.
 *
 * Deliberately not a copy. The registry exists so that when Amazon ships a UI
 * change the selector is fixed in exactly one file and every consumer picks it
 * up — a second copy here is how that guarantee quietly stops being true.
 */
function loadAction() {
  const src = fs.readFileSync(SKILL, "utf8");
  const blocks = [...src.matchAll(/```js\n([\s\S]*?)```/g)].map((m) => m[1]); // lang-regex-ok: fenced code block in our own file
  const block = blocks.filter((b) => b.includes("execute:")).pop();
  if (!block) throw new Error(`no execute block in ${SKILL}`);
  return block;
}

const orderUrl = (id) =>
  `https://www.amazon.com/your-orders/order-details?orderID=${encodeURIComponent(id)}`;

/**
 * Say out loud when the run stalls on something only a human can clear.
 *
 * This is what makes the tool safe to leave on a schedule. A weekly job that
 * quietly reads nothing looks exactly like a weekly job with nothing to read,
 * and the ledger would go on filing "Appliances item" for months with nobody
 * the wiser. Re-authing is a sixty-second task; not knowing it is needed is
 * the expensive part.
 *
 * `--observed-error` carries the verbatim status the page actually returned,
 * because jori-send-curl refuses a system-channel message that asserts a
 * mechanism without one — a quote cannot be produced by a turn that merely
 * believes its own narration.
 */
function alert(message, observedError) {
  try {
    execFileSync(installTools("bin", "jori-send-curl"), [
      "--channel", "system",
      // The gate on the system channel refuses a message asserting a mechanism
      // without the verbatim output behind it — a quote cannot be produced by a
      // turn that merely believes its own narration.
      "--observed-error", observedError.slice(0, 400),
      message,
    ], { stdio: "ignore", timeout: 20000 });
  } catch (e) {
    // An alert that cannot be sent must not take the run down with it. The
    // console line and the non-zero exit still stand on their own.
    log(`  (could not send the alert: ${e.message.slice(0, 80)})`);
  }
}

/**
 * How long a refused or blocked sign-in keeps the next runs from trying again.
 * A daily run that retried a refused password would be how an Amazon account
 * gets locked, which costs far more than a stale ledger. `--retry-signin`
 * lifts it for one run, e.g. right after the saved login was corrected.
 * no_credentials and error are not here: nothing was typed into Amazon, so
 * there is nothing to protect and the next run simply tries again.
 */
const BACKOFF_MS = 3 * 86400000;
const BACKOFF_STATUSES = new Set(["bad_credentials", "captcha", "needs_2fa", "no_login_form", "still_signed_out"]);
const CHROME_PORT = String(port("chrome_cdp"));
const LOGIN_LOG = path.join(installRoot(), "data", "site-login-log.jsonl"); // the file bin/site-login appends to

/**
 * The newest site-login attempt on amazon.com in THIS Chrome (its port: the
 * shop Chrome signs in to Amazon too, and its outcome says nothing about this
 * profile), when it was a refusal or a blocker inside the backoff window; null
 * when a sign-in may be tried.
 */
function recentRefusal() {
  if (FLAGS.has("--retry-signin")) return null;
  let rows;
  try {
    rows = fs.readFileSync(LOGIN_LOG, "utf8").trim().split("\n");
  } catch {
    return null; // no log yet: nothing has been tried
  }
  for (let i = rows.length - 1; i >= 0; i--) {
    let row;
    try { row = JSON.parse(rows[i]); } catch { continue; }
    if (!row || row.site !== "amazon.com" || String(row.port) !== CHROME_PORT) continue;
    const at = Date.parse(row.ts);
    if (Number.isNaN(at)) continue;
    const age = Date.now() - at;
    return BACKOFF_STATUSES.has(row.status) && age >= 0 && age < BACKOFF_MS ? row : null;
  }
  return null;
}

/** Write an outcome into the same log site-login uses, so the backoff sees it. */
function recordLogin(status, detail) {
  try {
    fs.appendFileSync(LOGIN_LOG, JSON.stringify({ ts: new Date().toISOString(), site: "amazon.com", port: CHROME_PORT, status, detail }) + "\n");
  } catch {
    /* only a courtesy to the backoff: without it the next run may try once more */
  }
}

const shortDate = (ms) =>
  new Date(ms).toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: instance().tz });

/**
 * Sign the automation Chrome back in to Amazon, once, with the saved login.
 * site-login prints one JSON line {site, status, detail} (never a credential)
 * and exits non-zero for every outcome that is not a sign-in, so the line is
 * read from stdout either way.
 *
 * site-login reads the login through site-pass/dev-pass, which call `op` by
 * name. Cron's PATH (and cron-run's, which adds only node's own directory)
 * does not have it, and without it the read fails and looks like "no saved
 * login": a false ask for credentials. So the Homebrew directories are
 * appended here, after whatever PATH the run already has.
 */
function signIn() {
  const args = ["amazon.com", "--login-url", SIGNIN_URL, "--check-url", SIGNED_IN_CHECK_URL, "--port", CHROME_PORT];
  const env = { ...process.env, PATH: [process.env.PATH, "/opt/homebrew/bin", "/usr/local/bin"].filter(Boolean).join(":") };
  const done = (r) => ({ ...r, at: new Date().toISOString() });
  let out = "";
  try {
    out = execFileSync(installTools("bin", "site-login"), args,
      { encoding: "utf8", timeout: 240000, env, stdio: ["ignore", "pipe", "pipe"] });
  } catch (e) {
    out = e && e.stdout ? String(e.stdout) : "";
    if (!out.trim()) return done({ site: "amazon.com", status: "error", detail: String((e && e.message) || e).slice(0, 200) });
  }
  try {
    return done(JSON.parse(out.trim().split("\n").pop()));
  } catch {
    return done({ site: "amazon.com", status: "error", detail: `unreadable site-login output: ${out.slice(0, 120)}` });
  }
}

const SIGNED_IN = new Set(["signed_in", "already_signed_in"]);

/** Plain words for why the automatic sign-in did not get the profile back in. */
function signInBlocker(result) {
  switch (result && result.status) {
    case "captcha": return "Amazon put a robot check on the sign-in form";
    case "needs_2fa": return "Amazon asked for a one-time code";
    case "no_login_form": return "it could not find Amazon's sign-in form";
    case "still_signed_out": return "the login went in without an error but Amazon still shows it signed out";
    case "denylisted": return "Amazon is on the list of sites that are never signed in automatically";
    case "signed_in":
    case "already_signed_in": return "it signed in, but Amazon signed it out again during the run";
    default: return `the sign-in tool stopped with "${(result && result.status) || "no answer"}"`;
  }
}

function alertHuman(status, receipt, signInResult) {
  const observed =
    `order-details returned status="${status}" for order ${receipt.order_id}` +
    (signInResult ? `; site-login: ${JSON.stringify({ status: signInResult.status, detail: signInResult.detail })}` : "");
  if (status !== "login_required") {
    alert(
      "amazon-order-detail stopped: Amazon showed a bot challenge. Left alone deliberately; " +
        "re-run later rather than hammering it.",
      observed
    );
    return;
  }
  const st = signInResult && signInResult.status;
  const tail = "Receipts keep saying \"1 Electronics item\" until it is back in.";
  // The attempt's own date and the retry date are the same on every day of a
  // backoff, so the text stays identical and the system channel's repeat
  // filter treats it as one condition.
  const tried = signInResult && signInResult.at ? shortDate(Date.parse(signInResult.at)) : "today";
  const retry = signInResult && signInResult.at ? shortDate(Date.parse(signInResult.at) + BACKOFF_MS) : "";
  let message;
  if (st === "no_credentials") {
    // A missing saved login and a password store that did not answer (a
    // network or 1Password hiccup) read the same to site-login, so the words
    // do not claim which one it is. Nothing reached Amazon.
    message =
      "amazon-order-detail is signed out of Amazon and could not read a saved Amazon login " +
      "(none is saved, or the password store did not answer). It tries again on the next run. " + tail;
  } else if (st === "error") {
    // The sign-in tool itself failed (Chrome or a page failed, a timeout, an
    // unreadable answer): no claim about the login. The detail is in the quote.
    message =
      "amazon-order-detail is signed out of Amazon and the sign-in tool failed before it could finish " +
      "(the detail is attached). It tries again on the next run. " + tail;
  } else if (st === "bad_credentials") {
    message =
      `amazon-order-detail is signed out of Amazon and the saved Amazon login was refused on ${tried}. ` +
      `Send the right one: it signs itself in on the first run after ${retry}, or sooner if you ask for a retry ` +
      "(it does not retry a refused login in between, so the account is not put at risk of a lockout). " + tail;
  } else {
    message =
      `amazon-order-detail is signed out of Amazon and its sign-in attempt on ${tried} did not get back in: ` +
      `${signInBlocker(signInResult)}.` +
      (BACKOFF_STATUSES.has(st) ? ` It does not try again before ${retry}, so a refused login is not retried into a lockout.` : "") + " " + tail;
  }
  alert(message, observed);
}

/**
 * Receipts that have an order number and no order page read yet.
 *
 * NEWEST FIRST, deliberately. History is not this tool's job — Amazon's own
 * "Request my data" export covers everything already bought, in bulk, without
 * a single page load. What this exists for is the orders arriving from now on,
 * and those are the ones a run should reach before it hits its ceiling or a
 * challenge stops it. Oldest-first would spend the budget on the half we
 * already have another copy of.
 */
async function pending() {
  const params = new URLSearchParams();
  params.set("select", "id,vendor,date,total,order_id,ship_to,detail_status");
  params.set("vendor", "ilike.*amazon*");
  params.set("order_id", "not.is.null");
  params.set("order", "date.desc");
  if (ONLY.length) {
    // An explicit order number always wins: asking for one by name means it,
    // however old it is.
    params.set("order_id", `in.(${ONLY.join(",")})`);
  } else {
    if (!RESCAN) params.set("detail_fetched_at", "is.null");
    if (SINCE) params.set("date", `gte.${SINCE}`);
  }
  const rows = await request(`/rest/v1/receipts?${params}`);
  return rows.slice(0, LIMIT);
}

async function writeBack(receipt, detail) {
  const patch = {
    detail_fetched_at: new Date().toISOString(),
    detail_status: detail.status,
  };
  if (detail.address) {
    if (detail.address.full) patch.ship_address = detail.address.full;
    if (detail.address.recipient) patch.ship_recipient = detail.address.recipient;
  }
  await request(`/rest/v1/receipts?id=eq.${encodeURIComponent(receipt.id)}`, {
    method: "PATCH",
    body: patch,
    prefer: "return=minimal",
  });

  if (!detail.items || !detail.items.length) return 0;

  // Replace rather than merge. The email's placeholder lines ("Appliances
  // item") describe the same purchase as the real ones, so keeping both would
  // double the receipt and, downstream, double what the classifier reads.
  await request(
    `/rest/v1/receipt_line_items?receipt_id=eq.${encodeURIComponent(receipt.id)}`,
    { method: "DELETE", prefer: "return=minimal" }
  );
  await request(`/rest/v1/receipt_line_items`, {
    method: "POST",
    prefer: "return=minimal",
    body: detail.items.map((item, i) => ({
      receipt_id: receipt.id,
      line_number: i + 1,
      description: item.title,
      quantity: item.quantity ?? null,
      // The line total, which is what the email's version held. unitPrice ×
      // quantity, because a receipt line is what that line cost.
      amount: item.unitPrice == null ? null : Number((item.unitPrice * (item.quantity || 1)).toFixed(2)),
      asin: item.asin ?? null,
      seller: item.seller ?? null,
    })),
  });
  return detail.items.length;
}

async function main() {
  if (!fs.existsSync(SKILL)) {
    log(`amazon-order-detail: off — no amazon.com browsing skill at ${SKILL}`);
    if (JSON_OUT) console.log(JSON.stringify({ off: true, considered: 0, filled: 0, items: 0 }));
    return;
  }
  const rows = await pending();
  if (!rows.length) {
    log("Nothing to read — every Amazon receipt with an order number has its page.");
    if (JSON_OUT) console.log(JSON.stringify({ considered: 0, filled: 0, items: 0 }));
    return;
  }

  log(`${rows.length} Amazon order${rows.length === 1 ? "" : "s"} to read.`);
  const block = loadAction();
  const expression = `(${block}).execute({})`;

  let browser;
  try {
    browser = await connect();
  } catch (e) {
    const detail = `connect() to localhost:${port("chrome_cdp")} failed: ${e.message}`;
    console.error(
      `Cannot reach the automation Chrome (${e.message}).\n` +
        `It is the LaunchAgent com.jori.chrome-cdp, port ${port("chrome_cdp")}.`
    );
    // chrome-cdp-watch also notices a dead port, but it cannot know this job
    // needed it — and this one failing silently means receipts stop improving.
    if (!DRY_RUN) {
      alert(
        "amazon-order-detail could not reach the automation Chrome " +
          `(com.jori.chrome-cdp, port ${port("chrome_cdp")}), so no Amazon orders were read.`,
        detail
      );
    }
    process.exit(2);
  }

  const summary = { considered: rows.length, filled: 0, items: 0, skipped: [], stoppedOn: null, signIn: null };

  for (const [index, receipt] of rows.entries()) {
    if (index > 0) await sleep(DELAY_MS);

    let detail;
    try {
      await browser.goto(orderUrl(receipt.order_id));
      detail = await browser.evaluate(expression);
    } catch (e) {
      summary.skipped.push({ orderId: receipt.order_id, reason: e.message.slice(0, 120) });
      log(`  ${receipt.order_id}: could not read — ${e.message.slice(0, 90)}`);
      continue;
    }

    // Signed out: sign back in once with the saved login, then read this
    // order again. Never a second attempt in the same run, never within the
    // backoff of a refused or blocked one, and never on a dry run (it types
    // the real password and can make Amazon send a code, with the alert off).
    if (detail.status === "login_required" && !summary.signIn && !DRY_RUN) {
      const refused = recentRefusal();
      if (refused) {
        summary.signIn = { site: "amazon.com", status: refused.status, detail: refused.detail, backedOff: true, at: refused.ts };
        log(`  ${receipt.order_id}: signed out of Amazon; not signing in again, the attempt on ${shortDate(Date.parse(refused.ts))} ended "${refused.status}".`);
      } else {
        log(`  ${receipt.order_id}: signed out of Amazon — signing back in with the saved login.`);
        summary.signIn = signIn();
        log(`  sign-in: ${summary.signIn.status}`);
      }
      if (SIGNED_IN.has(summary.signIn.status)) {
        try {
          await browser.goto(orderUrl(receipt.order_id));
          detail = await browser.evaluate(expression);
        } catch (e) {
          summary.skipped.push({ orderId: receipt.order_id, reason: e.message.slice(0, 120) });
          log(`  ${receipt.order_id}: could not read after signing in — ${e.message.slice(0, 90)}`);
          continue;
        }
        // The tool said it was in and the order page still asks for a sign-in:
        // that is a blocker like any other. Record it, so the next runs back
        // off instead of typing the real password again every day.
        if (detail.status === "login_required") {
          summary.signIn = {
            site: "amazon.com", status: "still_signed_out", at: new Date().toISOString(),
            detail: "site-login reported signed in but the order page still asks for a sign-in",
          };
          recordLogin(summary.signIn.status, summary.signIn.detail);
        }
      }
    }

    // Stop rather than grind. Once the profile is challenged, or still signed
    // out after its one sign-in attempt, every further load makes it worse and
    // none of them can succeed.
    if (detail.status === "login_required" || detail.status === "blocked") {
      summary.stoppedOn = detail.status;
      if (!DRY_RUN) alertHuman(detail.status, receipt, summary.signIn);
      log(
        detail.status === "login_required"
          ? `  ${receipt.order_id}: the automation profile is signed out of Amazon — stopping.`
          : `  ${receipt.order_id}: bot challenge shown — stopping.`
      );
      break;
    }

    if (detail.status !== "ok" || !detail.items.length) {
      summary.skipped.push({ orderId: receipt.order_id, reason: detail.status });
      log(`  ${receipt.order_id}: ${detail.status}, nothing to write.`);
      if (!DRY_RUN) await writeBack(receipt, detail);
      continue;
    }

    const titles = detail.items.map((i) => i.title.slice(0, 60)).join("; ");
    log(`  ${receipt.order_id}: ${titles}`);
    if (detail.address && detail.address.street) log(`      → ${detail.address.full}`);

    if (!DRY_RUN) {
      summary.items += await writeBack(receipt, detail);
      summary.filled += 1;
    }
  }

  // Hang up the CDP socket. Without this the run finishes, prints, and then
  // never exits: an open WebSocket keeps node's event loop alive, so cron-run
  // waits forever on a child that is done, and a daily schedule accumulates one
  // wedged process per day. Found the expensive way — a test run was still
  // resident ten minutes after it had written its last line.
  try {
    browser.close();
  } catch {
    /* already gone — nothing to hang up */
  }

  if (JSON_OUT) {
    console.log(JSON.stringify(summary));
  } else {
    log(
      `\n${summary.filled} receipt${summary.filled === 1 ? "" : "s"} filled in, ` +
        `${summary.items} line item${summary.items === 1 ? "" : "s"} written.` +
        (DRY_RUN ? "  (dry run — nothing written)" : "")
    );
    if (summary.stoppedOn === "login_required") {
      const st = summary.signIn && summary.signIn.status;
      log(
        !summary.signIn
          ? `\n⚠ Signed out of Amazon (dry run: no sign-in was tried).`
          : st === "bad_credentials" || st === "no_credentials"
            ? `\n⚠ Signed out of Amazon, and the saved Amazon login ${st === "no_credentials" ? "could not be read" : "was refused"}.`
            : `\n⚠ Signed out of Amazon and ${summary.signIn.backedOff ? "the earlier sign-in attempt is still inside its backoff" : "the sign-in attempt did not get back in"}: ${signInBlocker(summary.signIn)}.`
      );
    }
    if (summary.stoppedOn === "blocked") {
      log(`\n⚠ Stopped early on a bot challenge — re-run later, don't hammer it.`);
    }
  }
}

// Anything that breaks says so out loud. On a schedule nobody watches, a job
// that dies is indistinguishable from a job with nothing to do — and the whole
// point of this one is that the ledger goes quietly wrong when it stalls. The
// error text is carried verbatim rather than summarised, because a paraphrase
// of a failure is how a real cause gets lost.
main()
  .then(() => {
    // Belt to close()'s braces. If any socket or timer is still holding the
    // loop open, exit anyway rather than leaving cron-run parked on us.
    process.exit(0);
  })
  .catch((e) => {
    const detail = e && e.message ? e.message : String(e);
    console.error(detail);
    if (!DRY_RUN) {
      alert(`amazon-order-detail failed and read nothing this run: ${detail.slice(0, 200)}`, detail);
    }
    process.exit(1);
  });
