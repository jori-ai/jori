#!/usr/bin/env node
// watch-discover — find NEW shows/movies for the list. One pipeline, two callers:
//   daily   hum `screen` lane      watch-discover --window-days 21 --max 4 --source screen --result-file <hum cache>
//   monthly watchlist-discover     watch-discover --window-days 60 --max 12 --source monthly-discover --effort medium
//
// Candidates come from two places, and code decides what gets added:
//   1. the TMDB sweep (sweepNewShows in lib/tmdb-providers.mjs): every series that
//      premiered in the last ~8 months on the configured streaming services (confirmed
//      against the show's own TMDB providers: a paid add-on channel or rent/buy doesn't
//      count), kept when season 1 has fully dropped and its finale aired within
//      --sweep-days (default 120). Deterministic coverage: the model's search alone can
//      come back empty day after day.
//   2. the model's web search (taste profile + the user's own verdicts as examples),
//      for titles the sweep can't see (films, services not configured).
// Every candidate then has to pass:
//   - a TMDB match (real title, real ids)                → no invented "9.1, no IMDb id" rows
//   - dedup on IMDb/TMDB id against every row incl. rejected → a "no" never resurfaces
//   - IMDb ≥ 7.5 (shows) / ≥ 6.8 (films) from IMDb's own daily dataset (lib/watch-db.mjs imdbRatings;
//     OMDb lags weeks on new series and is only the fallback), and for shows at least
//     MIN_SHOW_VOTES votes. A fully-dropped show with no rating or too few votes yet is
//     HELD, not dropped: the sweep finds it again every day until its finale is
//     --sweep-days old, so it joins once IMDb has enough votes.
//   - shows: season 1 fully dropped per TMDB episode dates → the fully-dropped rule is enforced
//   - hard-excluded genres (reality, talk, soap, kids, romance-led films)
//   - taste fit from feedback not strongly negative for the target audience
//   - shows only: critics not mixed (Rotten Tomatoes >= 75% and Metacritic >= 65 when OMDb has
//     them). Films have no critic floor — critics predict their film marks at chance.
//   - the fit gate (2026-10-10): Jev site `watchlist-fit` per survivor, a batched Sonnet
//     judgement as shadow/fallback (lib/watch-fit.mjs) — keeps only titles the audience
//     would truly enjoy (no stretches; every harvester gates fit through Jev).
//     Fails CLOSED: no verdict, no add. A "drop" is remembered for FIT_RECHECK_DAYS
//     (data/watch-discover/fit-verdicts.json) so the daily sweep doesn't re-ask about the
//     same title every day; a rating that climbs FIT_RECHECK_RATING_GAIN re-opens it.
// New SEASONS are not discovered here: watchlist-season-check finds those
// deterministically from TMDB for shows the user has watched.
//
// Prints a JSON summary {added, held, skipped, ...} on stdout (and to --result-file
// when given, in the hum cache's shape). --dry-run skips every write but the summary.
// --no-sweep / --no-model run one source alone.

import { execFile } from "node:child_process";
import { promisify } from "node:util";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import {
  loadAll, insertTitle, findExisting, lookupMeta, tmdbSeasons, omdbRecord, syncShowSeasons,
  audienceFrom, todayEt, hasTmdb, PREFERRED_LANGUAGES, languageName, tmdbGet, tmdbDetails, tmdbWatchProviders, normName,
  imdbRatings,
} from "../lib/watch-db.mjs";
import { PARTNER, whoFor, watchConfig } from "../lib/watch-config.mjs";
import { tasteProfile } from "../lib/watch-fit.mjs";
import { createRequire } from "node:module";
const { MODELS } = createRequire(import.meta.url)("../lib/models.cjs");
const { installTools } = createRequire(import.meta.url)("../lib/root.cjs");
import { genreAffinity, tasteFit } from "../lib/watch-rank.mjs";
import { judgeFit } from "../lib/watch-fit.mjs";
import { loadModel } from "../lib/watch-model.mjs";
import * as recsys from "../lib/watch-recsys.mjs";
import { pickProviders, sweepNewShows, mapLimit, daysBefore, onServices, DEFAULT_SERVICES } from "../lib/tmdb-providers.mjs";

// What the taste model has learned from every mark and verdict, for the fit gate. Optional:
// a model that can't load leaves the gate exactly as it was.
async function learnedTaste() {
  try { return recsys.tasteSummary((await loadModel()).model, 10); } catch { return null; }
}

const arg = (n, d) => { const i = process.argv.indexOf(`--${n}`); return i >= 0 ? process.argv[i + 1] : d; };
const has = (n) => process.argv.includes(`--${n}`);
const WINDOW = parseInt(arg("window-days", "21"), 10);
const MAX = parseInt(arg("max", "4"), 10);
const SOURCE = arg("source", "manual-discover");
const DRY = has("dry-run");
const EFFORT = ["low", "medium", "high"].includes(arg("effort")) ? arg("effort") : "low";
const SWEEP = !has("no-sweep");
const MODEL = !has("no-model");
const SWEEP_DAYS = parseInt(arg("sweep-days", "120"), 10);   // season-1 finale at most this old
const SWEEP_LOOKBACK_DAYS = 240;                              // premieres this far back (weekly seasons run ~2-3 months)
const RESULT_FILE = arg("result-file", null);
const RATING_FLOOR = 7.5;     // shows
// Films: IMDb ≥ 6.8 and no critic floors (2026-10-10 — critics predicted the viewers'
// film marks at chance). Shows keep the stricter bar: no evidence yet.
const FILM_RATING_FLOOR = 6.8;
const MIN_SHOW_VOTES = 1000;  // below this a new show's IMDb rating is noise (a 9.2 on 13 votes)
const FIT_FLOOR = -0.4;
const RT_FLOOR = 75;          // percent
const METACRITIC_FLOOR = 65;  // out of 100
// Sweep prefilter (TMDB's own numbers, before any per-show call): a show with almost no
// TMDB votes has no IMDb rating worth reading yet (it comes back on a later run), and a
// show outside the preferred languages has to look exceptional to be worth checking.
const SWEEP_MIN_TMDB_VOTES = 10;
const FOREIGN_MIN_TMDB = { average: 8.0, votes: 100 };
const FIT_RECHECK_DAYS = 30;
const FIT_RECHECK_RATING_GAIN = 0.3;
const VERDICTS_FILE = installTools("data", "watch-discover", "fit-verdicts.json");
const HOME = os.homedir();
const today = todayEt();

function finish(summary, code = 0) {
  const json = JSON.stringify(summary, null, 2);
  if (RESULT_FILE) {
    try {
      fs.mkdirSync(path.dirname(RESULT_FILE), { recursive: true });
      const tmp = `${RESULT_FILE}.${process.pid}.tmp`;
      fs.writeFileSync(tmp, JSON.stringify({ ...summary, _cached_at: new Date().toISOString() }, null, 2));
      fs.renameSync(tmp, RESULT_FILE);
    } catch (e) { console.error(`[watch-discover] result file: ${e.message}`); }
  }
  console.log(json);
  process.exit(code);
}

// A crash still leaves a result (the hum lane waits ERROR_TTL before retrying, instead of
// re-running a failing search every tick).
const crashed = (e) => finish({ source: SOURCE, error: `crashed: ${String(e?.message || e).slice(0, 200)}`, added: [], held: [], skipped: [] }, 1);
process.on("uncaughtException", crashed);
process.on("unhandledRejection", crashed);

if (!hasTmdb()) finish({ source: SOURCE, error: "TMDB_API_KEY missing", added: [], held: [], skipped: [] }, 1);

const { titles, feedback, prefs, ratings } = await loadAll();
const prefLine = (aud) => prefs.filter((p) => p.audience === aud || p.audience === "all").map((p) => `${p.tag} ${p.weight > 0 ? "+" : ""}${p.weight}`).join(", ") || "(none)";
const byId = new Map(titles.map((t) => [t.id, t]));
const verdictList = (vs) => [...new Map(feedback.filter((f) => vs.includes(f.verdict)).map((f) => [f.title_id, f])).values()]
  .map((f) => byId.get(f.title_id)).filter(Boolean)
  .map((t) => `${t.name} (${t.kind === "show" ? t.audience : t.kind})`);
const loved = verdictList(["loved", "liked"]).slice(-25);
const disliked = verdictList(["disliked", "dropped", "not_interested", "meh"]).slice(-25);
const watchedNames = titles.filter((t) => t.status === "watched").slice(-40).map((t) => t.name);

const cfg = watchConfig();
const tastes = cfg.audience_tastes || {};
const taste = (aud) => (tastes[aud] ? ` — ${tastes[aud]}` : "");
const rules = [].concat(cfg.fit_rules || []).filter(Boolean).join(" ");
const langs = [...PREFERRED_LANGUAGES].map(languageName).join(" or ");
const me = whoFor("solo"), both = whoFor("together"), partner = whoFor(PARTNER);
const services = [].concat(cfg.discover_services || DEFAULT_SERVICES).filter(Boolean);
const region = cfg.home_region || "US";

const prompt = `You are scouting NEW TV series and films for ${me}'s watch list. Today is ${today}.

The taste profile:
---
${tasteProfile()}
---

What the viewers actually thought of things (strongest signal — weigh this above the profile):
- Loved/liked: ${loved.join("; ") || "(no verdicts yet)"}
- Disliked / dropped / not interested: ${disliked.join("; ") || "(none yet)"}
- Recently watched: ${watchedNames.join("; ")}

Stated genre preferences (weights; negative = avoid):
- together: ${prefLine("together")}
- solo: ${prefLine("solo")}

Audiences: "solo" (${me} alone${taste("solo")}) and "together" (${both}${taste("together")}). "${PARTNER}" only for titles clearly for ${partner} alone${taste(PARTNER)}.

Run several separate searches (new streaming series by platform — ${services.join(", ")} — best-of lists for the period, critics' picks, new films on streaming) and list up to ${MAX * 2} titles that match the taste above:
- brand-new SERIES whose first season FINISHED releasing (every episode out) in roughly the last ${WINDOW} days. For a weekly show that is the date of its season finale, not its premiere: a show that premiered two months ago and just aired its finale counts.
- FILMS that became available to stream in roughly the last ${WINDOW} days
Code checks every title you list afterwards (IMDb rating and vote count, every episode out, genre rules, and a strict taste-fit judge), so do the searching and list what plausibly fits; don't pre-filter down to nothing. Leave out what clearly doesn't fit: mixed-reception gambles and stretches.${rules ? ` ${rules}` : ""}
Strongly prefer ${langs}-language titles. A title in another language only qualifies if it is exceptional — those rank at the end of the list anyway.
Do NOT include new seasons of existing shows (tracked separately), reality TV, sitcoms, network procedurals, romance-led stories, or relationship drama.

Output ONE JSON object, no prose:
{"items":[{"title":"...","type":"show|movie|documentary","year":2026,"imdb_id":"tt... or null","audience":"solo|together|${PARTNER}","platform":"Netflix|Apple TV+|...","why":"one line tying it to something they loved or to the profile"}]}
Return {"items":[]} only if your searches found nothing that fits.`;

// --- source 2: the model's web search -------------------------------------------------
async function modelSearch() {
  const run = promisify(execFile)(path.join(HOME, ".local/bin/claude"), [
    "-p", "--model", MODELS.sonnet, "--effort", EFFORT, "--allowedTools", "WebSearch", "--output-format", "text", prompt,
  ], { encoding: "utf8", timeout: 240000, maxBuffer: 4 * 1024 * 1024 });
  run.child.stdin?.end(); // no stdin: `claude -p` would otherwise wait for it
  const { stdout } = await run;
  const m = stdout.match(/\{[\s\S]*"items"[\s\S]*\}/);
  return m ? JSON.parse(m[0]).items || [] : [];
}

// On the list already (any status, rejected included)? Ids first, then the exact name. A
// TV documentary series can sit on the list as kind "documentary" with no ids (older rows),
// so a series candidate also matches a documentary row of the same name: a rejected title
// must never come back under the other kind.
function alreadyListed(m) {
  return findExisting(titles, { imdb_id: m.imdb_id, tmdb_id: m.tmdb_id, name: m.name, kind: m.kind })
    || (m.kind === "show" ? titles.find((x) => x.kind === "documentary" && normName(x.name) === normName(m.name)) || null : null);
}

// --- source 1: the TMDB sweep of the configured services -------------------------------
const isPreferred = (lang) => !lang || PREFERRED_LANGUAGES.has(lang);
const finaleFloor = daysBefore(today, SWEEP_DAYS);
async function tmdbSweep() {
  const { shows } = await sweepNewShows({ tmdbGet, services, region, today, lookbackDays: SWEEP_LOOKBACK_DAYS, maxPages: 25 });
  const stats = { listed: shows.length, on_list: 0, prefiltered: 0, still_airing: 0, finale_too_old: 0, not_on_services: 0, checked: 0 };
  const fresh = shows.filter((s) => {
    if (alreadyListed({ tmdb_id: s.tmdb_id, kind: "show", name: s.name })) { stats.on_list++; return false; }
    const foreignOk = s.vote_average >= FOREIGN_MIN_TMDB.average && s.vote_count >= FOREIGN_MIN_TMDB.votes;
    if (s.vote_count < SWEEP_MIN_TMDB_VOTES || (!isPreferred(s.original_language) && !foreignOk)) { stats.prefiltered++; return false; }
    return true;
  });
  const metas = await mapLimit(fresh, 6, async (s) => {
    try {
      const meta = await tmdbDetails("tv", s.tmdb_id);
      if (!meta) return null;
      meta.kind = "show";
      const seasons = await tmdbSeasons(meta._tv, today);
      const s1 = seasons.find((x) => x.n === 1);
      if (!s1 || !s1.fully_dropped) { stats.still_airing++; return null; }
      if (s1.finale_date && s1.finale_date < finaleFloor) { stats.finale_too_old++; return null; }
      const where = onServices(await tmdbWatchProviders("tv", s.tmdb_id, region), services);
      if (!where.length) { stats.not_on_services++; return null; }
      meta._s1 = s1;
      meta._services = where;
      return meta;
    } catch { return null; }
  });
  const out = metas.filter(Boolean);
  stats.checked = out.length;
  return { metas: out, stats };
}

const [modelRes, sweepRes] = await Promise.allSettled([
  MODEL ? modelSearch() : Promise.resolve([]),
  SWEEP ? tmdbSweep() : Promise.resolve({ metas: [], stats: null }),
]);
const items = modelRes.status === "fulfilled" ? modelRes.value : [];
const modelError = modelRes.status === "rejected" ? `search failed: ${String(modelRes.reason?.message || modelRes.reason).slice(0, 200)}` : null;
const sweep = sweepRes.status === "fulfilled" ? sweepRes.value : { metas: [], stats: null };
const sweepError = sweepRes.status === "rejected" ? `TMDB sweep failed: ${String(sweepRes.reason?.message || sweepRes.reason).slice(0, 200)}` : null;
if ((modelError || !MODEL) && (sweepError || !SWEEP) && (modelError || sweepError)) {
  finish({ source: SOURCE, error: [modelError, sweepError].filter(Boolean).join("; "), added: [], held: [], skipped: [] });
}

const EXCLUDED_GENRES = /reality|talk|soap|kids|news/i; // TMDB genre names (structured data)
const added = [], held = [], skipped = [];
const skip = (title, why) => skipped.push({ title, why });
const hold = (title, why) => held.push({ title, why });

// Resolve the model's proposals to TMDB; merge with the sweep (one entry per TMDB id;
// a model proposal keeps its audience, platform and "why").
const pool = new Map(); // key → { meta, hint }
const keyOf = (m) => `${m.kind === "show" ? "tv" : "movie"}:${m.tmdb_id}`;
for (const m of sweep.metas) pool.set(keyOf(m), { meta: m, hint: { origin: "tmdb" } });
for (const it of items) {
  const name = String(it.title || "").trim();
  if (!name) continue;
  const kindHint = ["show", "movie", "documentary"].includes(it.type) ? it.type : null;
  let meta;
  try { meta = await lookupMeta({ imdb_id: /^tt\d+$/.test(it.imdb_id || "") ? it.imdb_id : null, name, kind: kindHint, year: it.year }); }
  catch (e) { skip(name, `TMDB error: ${e.message}`); continue; }
  if (!meta) { skip(name, "no TMDB match"); continue; }
  const k = keyOf(meta);
  pool.set(k, { meta: pool.get(k)?.meta || meta, hint: { origin: pool.has(k) ? "both" : "model", audience: it.audience, platform: it.platform, why: it.why } });
}

// Ratings: one pass over IMDb's dataset for every candidate; OMDb only when it's unavailable.
const imdb = await imdbRatings([...pool.values()].map((p) => p.meta.imdb_id));
const affinity = { together: genreAffinity(titles, feedback, "together"), solo: genreAffinity(titles, feedback, "solo") };
const fitFor = (meta, aud) => tasteFit({ genres: meta.genres, keywords: meta.keywords }, affinity[aud] || genreAffinity(titles, feedback, aud), prefs, aud);

const candidates = [];
for (const { meta, hint } of pool.values()) {
  const existing = alreadyListed(meta);
  if (existing) { skip(meta.name, `already on list (${existing.status})`); continue; }
  if (meta.genres && EXCLUDED_GENRES.test(meta.genres)) { skip(meta.name, `excluded genre: ${meta.genres}`); continue; }
  if (meta.kind === "movie" && /^romance/i.test(meta.genres || "")) { skip(meta.name, "romance-led film"); continue; }

  // A TV series is held to the series rules (season 1 fully dropped, the show floors) even
  // when it was proposed as a "documentary": only a film is a film.
  const film = !meta._tv;
  if (film && meta.release_date && meta.release_date > today) { skip(meta.name, `not released until ${meta.release_date}`); continue; }
  if (!film && !meta._s1) {
    const seasons = await tmdbSeasons(meta._tv, today);
    const s1 = seasons.find((s) => s.n === 1);
    if (!s1 || !s1.fully_dropped) { skip(meta.name, `season 1 not fully dropped${s1?.finale_date ? ` (finale ${s1.finale_date})` : ""}`); continue; }
    meta._s1 = s1;
  }

  let omdb = null;
  let rating = null, votes = null;
  if (imdb && meta.imdb_id) {
    const r = imdb.get(meta.imdb_id);
    if (r) ({ rating, votes } = r);
  } else {
    omdb = await omdbRecord(meta.imdb_id);
    rating = omdb.imdb;
    votes = omdb.votes;
  }
  if (rating == null) { hold(meta.name, `no IMDb rating yet${meta.imdb_id ? "" : " (no IMDb id on TMDB)"}`); continue; }
  const floor = film ? FILM_RATING_FLOOR : RATING_FLOOR;
  if (rating < floor) { skip(meta.name, `IMDb ${rating} < ${floor}`); continue; }
  if (!film && votes != null && votes < MIN_SHOW_VOTES) { hold(meta.name, `IMDb ${rating} on ${votes} votes, waiting for ${MIN_SHOW_VOTES}`); continue; }
  if (!film) {
    omdb ||= await omdbRecord(meta.imdb_id);
    if (omdb.rt != null && omdb.rt < RT_FLOOR) { skip(meta.name, `Rotten Tomatoes ${omdb.rt}% < ${RT_FLOOR}%`); continue; }
    if (omdb.metacritic != null && omdb.metacritic < METACRITIC_FLOOR) { skip(meta.name, `Metacritic ${omdb.metacritic} < ${METACRITIC_FLOOR}`); continue; }
  }

  // Audience: the model's call when it made one; for a swept show, whichever list its
  // genres fit better by the stated preferences and verdicts (ties → together).
  let audience = "together";
  if (meta.kind === "show") {
    audience = audienceFrom(hint.audience) || (fitFor(meta, "solo") > fitFor(meta, "together") ? "solo" : "together");
  }
  const fit = meta.kind === "show" ? fitFor(meta, audience) : tasteFit({ genres: meta.genres, keywords: meta.keywords }, genreAffinity(titles, feedback, null), prefs, "together");
  if (fit < FIT_FLOOR) { skip(meta.name, `poor taste fit (${fit.toFixed(2)}) for ${audience}`); continue; }

  const why = hint.why || (hint.origin === "tmdb" ? `New on ${region} streaming, season 1 complete${meta._s1?.finale_date ? ` (finale ${meta._s1.finale_date})` : ""}, IMDb ${rating}${votes ? ` on ${votes.toLocaleString("en-US")} votes` : ""}` : null);
  const row = {
    kind: meta.kind, name: meta.name, imdb_id: meta.imdb_id, tmdb_id: meta.tmdb_id, audience, status: "queued",
    year_start: meta.year_start, year_end: meta.year_end || null, genres: meta.genres,
    platform: meta._services?.length ? meta._services.slice(0, 2).join(" / ") : hint.platform || null,
    original_language: meta.original_language || null,
    keywords: meta.keywords || null,
    imdb_rating: rating, description: meta.description, source: SOURCE, source_reason: String(why || "").slice(0, 300) || null,
  };
  candidates.push({ row, rating, votes: votes ?? 0, omdb: omdb || { rt: null, metacritic: null }, why, origin: hint.origin });
}

// Best first: preferred languages, then IMDb rating, then votes. Only the top of the
// list goes to the fit gate (each verdict is a Jev call).
candidates.sort((a, b) => (isPreferred(b.row.original_language) - isPreferred(a.row.original_language))
  || (b.rating - a.rating) || (b.votes - a.votes));

// Fit-gate memory: a title judged "drop" recently isn't re-judged until it ages out or
// its rating climbs.
let verdictMemo = {};
try { verdictMemo = JSON.parse(fs.readFileSync(VERDICTS_FILE, "utf8")); } catch {}
const memoKey = (row) => `${row.imdb_id || `${row.kind}:${row.tmdb_id}`}|${row.audience}`;
const recheckAfter = Date.now() - FIT_RECHECK_DAYS * 86400000;
const toJudge = [];
for (const c of candidates) {
  const prev = verdictMemo[memoKey(c.row)];
  if (prev && !prev.keep && Date.parse(prev.at) > recheckAfter && c.rating < (prev.rating ?? 0) + FIT_RECHECK_RATING_GAIN) {
    skip(c.row.name, `fit gate ${prev.at.slice(0, 10)} (${prev.used}): ${prev.reason || "drop"}`);
    continue;
  }
  if (toJudge.length < MAX * 3) toJudge.push(c);
  else skip(c.row.name, "over this run's review limit (checked next run)");
}

// Fit gate — Jev (site watchlist-fit) per candidate, Sonnet batch as shadow/fallback.
// lib/watch-fit.mjs; fails closed.
const verdicts = await judgeFit(toJudge.map(({ row, omdb, why }) => ({
  name: row.name, kind: row.kind, audience: row.audience, year: row.year_start, genres: row.genres,
  language: row.original_language, synopsis: row.description, imdb: row.imdb_rating, rt: omdb.rt, metacritic: omdb.metacritic, why,
})), { titles, feedback, prefs, ratings, learned: await learnedTaste() });

for (const [i, { row, rating, origin }] of toJudge.entries()) {
  const v = verdicts[i];
  if (v && v.used !== "none" && v.judged !== false) verdictMemo[memoKey(row)] = { keep: !!v.keep, reason: String(v.reason || "").slice(0, 200), used: v.used, at: new Date().toISOString(), rating, name: row.name };
  if (!v?.keep) { skip(row.name, `fit gate (${v?.used || "none"}): ${v?.reason || "no verdict"}`); continue; }
  if (added.length >= MAX) { skip(row.name, `passed every gate; over this run's limit of ${MAX} (added next run)`); delete verdictMemo[memoKey(row)]; continue; }
  if (DRY) { added.push({ name: row.name, kind: row.kind, audience: row.audience, rating, origin, dry_run: true }); continue; }
  try {
    if (row.tmdb_id && origin === "model") {
      // The model's platform guess, replaced by TMDB's when it has one (swept titles already carry it).
      const providers = pickProviders(await tmdbWatchProviders(row.kind === "show" ? "tv" : "movie", row.tmdb_id, region).catch(() => null), 2);
      if (providers.length) row.platform = providers.join(" / ");
    }
    const t = await insertTitle(row);
    titles.push({ ...t, seasons: [] });
    if (t.kind === "show") await syncShowSeasons({ ...t, seasons: [] }, today);
    added.push({ name: t.name, kind: t.kind, audience: row.audience, rating, platform: row.platform || null, origin });
  } catch (e) { skip(row.name, `insert failed: ${e.message}`); }
}

if (!DRY) {
  // Keep the memory small: forget verdicts past the recheck window.
  for (const [k, v] of Object.entries(verdictMemo)) if (!(Date.parse(v.at) > recheckAfter)) delete verdictMemo[k];
  try {
    fs.mkdirSync(path.dirname(VERDICTS_FILE), { recursive: true });
    fs.writeFileSync(VERDICTS_FILE, JSON.stringify(verdictMemo, null, 1));
  } catch (e) { console.error(`[watch-discover] verdict memory: ${e.message}`); }
}

finish({
  source: SOURCE, proposed: items.length, swept: sweep.stats, added, held, skipped,
  ...(modelError ? { model_error: modelError } : {}), ...(sweepError ? { sweep_error: sweepError } : {}),
});
