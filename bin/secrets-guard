#!/usr/bin/env node
// secrets-guard — Claude Code PreToolUse hook (matcher Bash|Read|Grep|Glob|
// Edit|Write) for Jori's own sessions: notice (log mode) or refuse (block
// mode) an agent reading the installation's secrets itself — .env, the
// secrets directories, the 1Password CLI, keychain password reads, an env
// dump. Logic: lib/secrets-guard.mjs. Wired in next to rollback-guard by
// lib/rollback-guard-settings.mjs (supervisors and fork launchers).
//
//   echo '{"tool_name":"Bash","tool_input":{"command":"cat .env"},"cwd":"/repo"}' | secrets-guard
//   secrets-guard --check '<command>'   # what it would report, for a shell test

import { runHook, findAccesses } from "../lib/secrets-guard.mjs";

const ci = process.argv.indexOf("--check");
if (ci >= 0) {
  const hits = findAccesses({ tool_name: "Bash", tool_input: { command: process.argv[ci + 1] || "" }, cwd: process.cwd() });
  for (const h of hits) console.log(`${h.kind}\t${h.target}`);
  process.exit(hits.length ? 1 : 0);
}

let input = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (c) => { input += c; });
process.stdin.on("end", () => {
  const r = runHook(input);
  if (r.stderr) process.stderr.write(r.stderr + "\n");
  process.exit(r.code);
});
