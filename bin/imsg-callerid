#!/bin/bash
# imsg-callerid — Get or set the iMessage "Start new conversations from" caller ID
#
# Usage:
#   imsg-callerid get          — Print current caller ID
#   imsg-callerid set <value>  — Change caller ID (phone number or email)
#   imsg-callerid list         — List available caller IDs
#
# The <value> for set can be a partial match (e.g. "icloud", "+1555", part of an email).
# This works by UI-scripting the Messages > Settings > iMessage dropdown.
# Requires: Accessibility permission for the calling process (Terminal, etc.)

set -euo pipefail

SETTINGS_TAB=""

ensure_settings_open() {
    # Check if the iMessage settings tab is already open
    SETTINGS_TAB=$(osascript -e '
        tell application "System Events"
            tell process "Messages"
                try
                    set wins to name of every window
                    if wins contains "iMessage" then return "open"
                    if wins contains "General" then return "general"
                end try
            end tell
        end tell
        return "closed"
    ' 2>/dev/null || echo "closed")

    if [ "$SETTINGS_TAB" = "closed" ]; then
        osascript <<'EOF'
tell application "Messages" to activate
delay 0.3
tell application "System Events"
    tell process "Messages"
        keystroke "," using command down
    end tell
end tell
delay 1.5
EOF
    fi

    # Navigate to iMessage tab if not already there
    if [ "$SETTINGS_TAB" != "open" ]; then
        osascript <<'EOF' 2>/dev/null
tell application "System Events"
    tell process "Messages"
        repeat with w in every window
            if name of w is "General" or name of w is "iMessage" then
                tell w
                    try
                        click button "iMessage" of toolbar 1
                        delay 0.8
                    end try
                end tell
            end if
        end repeat
    end tell
end tell
EOF
    fi
}

close_settings() {
    osascript <<'EOF' >/dev/null 2>&1 || true
tell application "System Events"
    tell process "Messages"
        try
            tell window "iMessage"
                click button 1
            end tell
        end try
    end tell
end tell
EOF
}

get_current() {
    ensure_settings_open
    local result
    result=$(osascript <<'EOF'
tell application "System Events"
    tell process "Messages"
        tell window "iMessage"
            set allContents to entire contents
            repeat with e in allContents
                try
                    if class of e is pop up button then
                        return value of e
                    end if
                end try
            end repeat
        end tell
    end tell
end tell
return ""
EOF
    )
    close_settings
    echo "$result"
}

list_options() {
    ensure_settings_open
    osascript <<'EOF'
tell application "System Events"
    tell process "Messages"
        tell window "iMessage"
            set allContents to entire contents
            repeat with e in allContents
                try
                    if class of e is pop up button then
                        click e
                        delay 0.3
                        tell menu 1 of e
                            set menuItems to every menu item
                            set output to ""
                            repeat with mi in menuItems
                                if output is not "" then set output to output & linefeed
                                set output to output & (name of mi)
                            end repeat
                        end tell
                        key code 53
                        return output
                    end if
                end try
            end repeat
        end tell
    end tell
end tell
return ""
EOF
    close_settings
}

set_callerid() {
    local target="$1"
    ensure_settings_open
    local result
    result=$(osascript -e "
        on run
            set targetStr to \"$target\"
            tell application \"System Events\"
                tell process \"Messages\"
                    tell window \"iMessage\"
                        set allContents to entire contents
                        repeat with e in allContents
                            try
                                if class of e is pop up button then
                                    set currentVal to value of e
                                    click e
                                    delay 0.3
                                    tell menu 1 of e
                                        set menuItems to every menu item
                                        repeat with mi in menuItems
                                            set miName to name of mi
                                            if miName contains targetStr or targetStr contains miName then
                                                click mi
                                                delay 0.5
                                                return value of e
                                            end if
                                        end repeat
                                    end tell
                                    -- No match found, close menu
                                    key code 53
                                    return \"ERROR: No match for '\" & targetStr & \"'\"
                                end if
                            end try
                        end repeat
                    end tell
                end tell
            end tell
            return \"ERROR: Popup not found\"
        end run
    " 2>&1)
    close_settings
    if [[ "$result" == ERROR:* ]]; then
        echo "$result" >&2
        return 1
    fi
    echo "$result"
}

case "${1:-help}" in
    get)
        get_current
        ;;
    list)
        list_options
        ;;
    set)
        if [ -z "${2:-}" ]; then
            echo "Usage: imsg-callerid set <value>" >&2
            echo "  value: phone number, email, or partial match" >&2
            exit 1
        fi
        set_callerid "$2"
        ;;
    help|--help|-h)
        echo "Usage: imsg-callerid <command> [args]"
        echo ""
        echo "Commands:"
        echo "  get          Print current caller ID"
        echo "  set <value>  Change caller ID (supports partial match)"
        echo "  list         List available caller IDs"
        echo ""
        echo "Examples:"
        echo "  imsg-callerid get"
        echo "  imsg-callerid set agent@example.com"
        echo "  imsg-callerid set icloud"
        echo "  imsg-callerid set +1555"
        echo "  imsg-callerid list"
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Run 'imsg-callerid help' for usage." >&2
        exit 1
        ;;
esac
