#!/usr/bin/env node
"use strict";
// period-summary — deterministic half of weekly-summary / monthly-summary
// (see lib/period-summary.js for why).
//
//   period-summary prep <weekly|monthly> [--today YYYY-MM-DD]
//       Window on the local calendar, exact stats, home/away nights from the
//       travel timeline, source narratives. Writes the packet to
//       data/period-summary/<kind>-<start>.json and prints its path.
//       Too little data (<3 dailies a week, <10 a month) → sends the short
//       "not enough data" email itself and exits 3 (nothing for a model to do).
//   period-summary publish <packet.json> <reply.json>
//       Validates the model's {narrative, themes[]} reply (exit 2 + problems on
//       failure), upserts weekly_/monthly_summaries, stamps the source dailies,
//       renders and emails. Prints one JSON line.

const fs = require("fs");
const os = require("os");
const path = require("path");
const { execFileSync } = require("child_process");
const PS = require("../lib/period-summary.js");
const { request } = require("../lib/supabase-rest.js");
const { installRoot, installTools } = require("../lib/root.cjs");
const { instance } = require("../lib/instance.cjs");

const OUT_DIR = path.join(installRoot(), "data/period-summary");
const MIN_ROWS = { weekly: 3, monthly: 10 };
const TABLE = { weekly: "weekly_summaries", monthly: "monthly_summaries" };
const KEY = { weekly: "week_start", monthly: "month_start" };
const STAMP = { weekly: "weekly_compacted_at", monthly: "monthly_compacted_at" };

const argv = process.argv.slice(2);
const flag = (n) => { const i = argv.indexOf(n); return i >= 0 ? argv[i + 1] : undefined; };
const die = (m, code = 1) => { process.stderr.write(`period-summary: ${m}\n`); process.exit(code); };

function sendEmail(subject, html) {
  const to = instance().owner_email;
  if (!to) die("no owner_email configured (agent/local/instance.json) — nowhere to send the summary");
  const f = path.join(os.tmpdir(), `period-summary-${process.pid}.html`);
  fs.writeFileSync(f, html);
  try {
    execFileSync(installTools("bin/email-send"), ["--to", to, "--subject", subject, "--body-file", f, "--html"], { stdio: ["ignore", "pipe", "pipe"] });
  } finally { try { fs.unlinkSync(f); } catch {} }
}

async function prep(kind) {
  if (!TABLE[kind]) die("usage: period-summary prep <weekly|monthly>", 2);
  const today = flag("--today") || execFileSync(installTools("bin/local-day"), ["today"]).toString().trim();
  const win = PS.windows(kind, today);
  const rows = (await request(`/rest/v1/daily_summaries?date=gte.${win.start}&date=lte.${win.end}&select=date,narrative,wake_at,sleep_at,places_count,photos_count,commits_count,messages_count,key_events&order=date.asc`)) || [];
  if (rows.length < MIN_ROWS[kind]) {
    const subj = PS.subject(win);
    sendEmail(subj, `<p>${subj}: only ${rows.length} daily entr${rows.length === 1 ? "y" : "ies"} available, not enough data for a ${kind === "weekly" ? "weekly" : "monthly"} synthesis yet.</p>`);
    console.log(JSON.stringify({ skipped: "insufficient_data", rows: rows.length, window: win }));
    process.exit(3);
  }
  const P = require("../lib/presence.js");
  const [segments, flights] = [await P.fetchSegments(), P.loadFlights()];
  const where = async (when) => P.resolvePresenceAt(P.parseWhen(when), segments, flights);
  const st = PS.stats(rows, win);
  const nt = await PS.nights(win, where, P.HOME_METROS);
  const weeklies = kind === "monthly"
    ? (await request(`/rest/v1/weekly_summaries?week_start=gte.${win.start}&week_start=lte.${win.end}&select=week_start,narrative,themes&order=week_start.asc`)) || []
    : [];
  const prev = ((await request(`/rest/v1/${TABLE[kind]}?${KEY[kind]}=lt.${win.start}&select=${KEY[kind]},narrative,themes&order=${KEY[kind]}.desc&limit=1`)) || [])[0] || null;
  // Monthly trusts the weekly compactions; dailies only fill weeks that are missing.
  const coveredWeeks = new Set(weeklies.map((w) => w.week_start));
  const dailies = kind === "weekly" ? rows : rows.filter((r) => {
    const d = new Date(`${r.date}T12:00:00Z`); const dow = (d.getUTCDay() + 6) % 7;
    return !coveredWeeks.has(PS.addDays(r.date, -dow));
  });
  const packet = {
    kind, window: win, subject: PS.subject(win), limits: PS.LIMITS[kind],
    stats: st, nights: nt,
    weeklies, dailies: dailies.map((r) => ({ date: r.date, narrative: r.narrative, key_events: r.key_events })),
    previous: prev,
    generated_at: new Date().toISOString(),
  };
  fs.mkdirSync(OUT_DIR, { recursive: true });
  const out = path.join(OUT_DIR, `${kind}-${win.start}.json`);
  fs.writeFileSync(out, JSON.stringify(packet, null, 2) + "\n");
  console.log(out);
}

async function publish(packetPath, replyPath) {
  if (!packetPath || !replyPath) die("usage: period-summary publish <packet.json> <reply.json>", 2);
  const packet = JSON.parse(fs.readFileSync(packetPath, "utf8"));
  let reply;
  try { reply = JSON.parse(fs.readFileSync(replyPath, "utf8")); } catch (e) { die(`reply is not valid JSON: ${e.message}`, 2); }
  const v = PS.validate(packet.kind, reply);
  if (!v.ok) { console.log(JSON.stringify({ ok: false, problems: v.problems })); process.exit(2); }
  const { kind, window: win } = packet;
  await request(`/rest/v1/${TABLE[kind]}?on_conflict=${KEY[kind]}`, {
    method: "POST", prefer: "resolution=merge-duplicates,return=minimal",
    body: [{ [KEY[kind]]: win.start, narrative: v.value.narrative, themes: v.value.themes }],
  });
  await request(`/rest/v1/daily_summaries?date=gte.${win.start}&date=lte.${win.end}`, {
    method: "PATCH", prefer: "return=minimal", body: { [STAMP[kind]]: new Date().toISOString() },
  });
  sendEmail(packet.subject, PS.renderHtml(win, packet.stats, packet.nights, v.value));
  console.log(JSON.stringify({ ok: true, kind, start: win.start, themes: v.value.themes.length }));
}

(async () => {
  try {
    const cmd = argv[0];
    if (cmd === "prep") await prep(argv[1]);
    else if (cmd === "publish") await publish(argv[1], argv[2]);
    else die("usage: period-summary <prep|publish> ...", 2);
  } catch (e) { die(e && e.message ? e.message : String(e)); }
})();
