#!/usr/bin/env node
// jev-shadow-report — per-site scoreboard for the Jev-primary / legacy-shadow week.
// Reads data/jev-shadow/YYYY-MM-DD.jsonl (written by lib/jev-shadow.mjs).
//
// Usage: jev-shadow-report [--days N] [--site <id>] [--json]

import fs from "node:fs";
import { createRequire } from "node:module";
import path from "node:path";

const DIR = process.env.JEV_SHADOW_DIR || path.join(createRequire(import.meta.url)("../lib/root.cjs").installTools(), "data/jev-shadow");
const args = process.argv.slice(2);
const flag = (n) => { const i = args.indexOf(n); return i >= 0 ? args[i + 1] : null; };
const days = Number(flag("--days") || 7);
const onlySite = flag("--site");
const since = Date.now() - days * 864e5;

let files = [];
try { files = fs.readdirSync(DIR).filter((f) => /^\d{4}-\d{2}-\d{2}\.jsonl$/.test(f)); } catch {}
const by = {};
for (const f of files) {
  for (const line of fs.readFileSync(path.join(DIR, f), "utf8").split("\n")) {
    if (!line.trim()) continue;
    let r; try { r = JSON.parse(line); } catch { continue; }
    if (Date.parse(r.ts) < since || (onlySite && r.site !== onlySite)) continue;
    const s = (by[r.site] ||= { site: r.site, decisions: 0, used_jev: 0, compared: 0, agree: 0, disagree: 0, jev_error: 0, low_conf: 0, excluded: 0, jev_cost: 0, ms: [] });
    if (!r.late) s.decisions++;
    if (r.used === "jev" && !r.late) s.used_jev++;
    if (r.reason === "jev-error") s.jev_error++;
    if (r.reason === "jev-low-confidence") s.low_conf++;
    if (r.reason && /excluded|disabled|unavailable/.test(r.reason)) s.excluded++;
    if (typeof r.agree === "boolean") { s.compared++; r.agree ? s.agree++ : s.disagree++; }
    if (r.jev && typeof r.jev.cost === "number" && !r.late) s.jev_cost += r.jev.cost;
    if (r.jev && typeof r.jev.ms === "number" && !r.late) s.ms.push(r.jev.ms);
  }
}
const out = Object.values(by).sort((a, b) => b.decisions - a.decisions).map((s) => {
  const ms = s.ms.sort((a, b) => a - b);
  const { ms: _drop, ...rest } = s;
  return { ...rest, jev_cost: Math.round(s.jev_cost * 1e4) / 1e4, agree_rate: s.compared ? Math.round((s.agree / s.compared) * 1000) / 10 : null, p50_ms: ms.length ? ms[Math.floor(ms.length / 2)] : null };
});

if (args.includes("--json")) { process.stdout.write(JSON.stringify(out, null, 2) + "\n"); process.exit(0); }
if (!out.length) { console.log(`no Jev decisions in the last ${days}d`); process.exit(0); }
console.log(`Jev shadow — last ${days}d`);
console.log("site".padEnd(24), "dec".padStart(6), "jev%".padStart(6), "cmp".padStart(6), "agree%".padStart(7), "dis".padStart(5), "err".padStart(5), "lowc".padStart(5), "$jev".padStart(8), "p50ms".padStart(6));
for (const s of out) {
  console.log(s.site.padEnd(24), String(s.decisions).padStart(6),
    String(s.decisions ? Math.round((s.used_jev / s.decisions) * 100) : 0).padStart(6),
    String(s.compared).padStart(6), String(s.agree_rate ?? "-").padStart(7), String(s.disagree).padStart(5),
    String(s.jev_error).padStart(5), String(s.low_conf).padStart(5), s.jev_cost.toFixed(4).padStart(8), String(s.p50_ms ?? "-").padStart(6));
}
