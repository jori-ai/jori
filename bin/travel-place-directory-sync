#!/usr/bin/env node
// travel-place-directory-sync — build country/city directories for travel
// history and link trips / Airbnb stays back to those pages.

"use strict";

const ws = require("../lib/wiki-store.js");

const args = process.argv.slice(2);
const dryRun = !args.includes("--apply");

// Deletion cap for UNATTENDED runs. This tool prunes any generated travel page
// that the current parse no longer produces — which is correct, and is how the
// 8 bad pages from 2026-07-29 were cleaned up. But once it runs weekly on a
// timer, that same logic is a standing risk: if an upstream source degrades (a
// trip page mangled, wiki-store returning a partial list, a parser regression),
// the tool cannot tell "these pages are garbage" from "I can no longer see the
// data that justified them" — and would quietly delete real travel history.
//
// Steady state is 0 deletions. A legitimate cleanup after a parser fix was 8.
// So: above the cap, skip the deletions entirely, print the full list, and exit
// non-zero. Writes still happen (they are additive and safe). Pass
// --max-deletions <n> to raise it for a deliberate, attended cleanup.
const MAX_DELETIONS_DEFAULT = 10;
const maxDeletions = (() => {
  const i = args.indexOf("--max-deletions");
  const v = i === -1 ? NaN : Number(args[i + 1]);
  return Number.isFinite(v) && v >= 0 ? v : MAX_DELETIONS_DEFAULT;
})();
let deletionCapTripped = false;

