#!/usr/bin/env node
// jori-notify — Send a push notification about Jori messages (no DB write).
// Usage:
//   jori-notify "Your morning briefing for Apr 5 is ready"
//   jori-notify --message-id <uuid> "P1 email ready for review"
//   jori-notify --title "Jori" "Short summary body"
//   jori-notify --channel system "Watchdog: Ollama restarted"  (no badge)
//   jori-notify --urgent "Leave now — tunnel is backing up"     (pierces Focus)
//   jori-notify --no-announce "Where did you have lunch?"       (a question: never read aloud)
//   jori-notify --announce "You are standing by the old bakery"  (time-sensitive: read aloud, no Jev judgment; motion gate unchanged)

import { createClient } from "@supabase/supabase-js";
import { createRequire } from "node:module";
import { sendApnsPush } from "../lib/apns-push.mjs";

const require = createRequire(import.meta.url);
require("../lib/load-env.js").loadEnv();

// This installation's Supabase project (agent/local/instance.json) and
// its public anon key (agent/local/config/supabase.json anon_key).
const { instance, supabaseAnonKey, assistantName } = require("../lib/instance.cjs");
const SUPABASE_URL = `https://${instance().supabase_project}.supabase.co`;
const SUPABASE_ANON_KEY = supabaseAnonKey();

const args = process.argv.slice(2);
let messageId = null;
let title = assistantName();
let channel = "chat";
let urgent = false;
let announce = "judge";
const positional = [];

for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === "--message-id" || a === "-m") messageId = args[++i];
  else if (a === "--title" || a === "-t") title = args[++i];
  else if (a === "--channel" || a === "-c") channel = args[++i];
  else if (a === "--urgent" || a === "-u") urgent = true;
  else if (a === "--no-announce") announce = "never";
  else if (a === "--announce") announce = "always";
  else positional.push(a);
}

const body = positional.join(" ").trim();
if (!body) {
  console.error("Usage: jori-notify [--message-id <uuid>] [--title <title>] <body>");
  process.exit(1);
}

// The push path reads device_tokens, jori_messages and location_history.
// Those tables are closed to the anon role, so use the service-role key from
// .env; the anon key is only a fallback for a host without it.
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY || SUPABASE_ANON_KEY;
if (!process.env.SUPABASE_SERVICE_ROLE_KEY) {
  console.error("jori-notify: SUPABASE_SERVICE_ROLE_KEY not set in .env; falling back to the anon key");
}
const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

try {
  const res = await sendApnsPush(supabase, { body, title, messageId, channel, urgent, announce });
  if (res?.repingIfUnread) console.log(`Push notification sent while moving (${res.reason}) — ping-flush re-pings it once on stopping if still unread.`);
  else console.log("Push notification sent.");
} catch (e) {
  console.error(`Push failed: ${e.message}`);
  process.exit(1);
}
process.exit(0);
