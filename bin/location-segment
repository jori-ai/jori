# ============================================================================
# Reverse geocode (Nominatim — fallback only)
# ============================================================================

def reverse_geocode_nominatim(lat: float, lon: float) -> Optional[Tuple[str, str, float, Optional[str]]]:
    """Returns (name, address, confidence, name_native). Confidence reflects how venue-like the match is:
    POI hit (amenity/shop/etc.) → 0.75, street address → 0.65, neighborhood-only → 0.55.
    """
    try:
        url = (f"https://nominatim.openstreetmap.org/reverse"
               f"?lat={lat}&lon={lon}&format=json&zoom=18&addressdetails=1&namedetails=1&extratags=1"
               "&accept-language=en")
        req = urllib.request.Request(url, headers={"User-Agent": "location-segment/1.0"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read())
        addr = data.get("address", {}) or {}
        road = addr.get("road") or addr.get("pedestrian") or addr.get("footway")
        house = addr.get("house_number")
        nbhd = addr.get("neighbourhood") or addr.get("suburb") or addr.get("quarter")
        city = addr.get("city") or addr.get("town") or addr.get("village")
        state = addr.get("state")
        nd = data.get("namedetails") or {}
        # The matched feature IS the road and has no name tag of any kind, only
        # `ref`: Nominatim printed its route number as its name (2026-10-19).
        ref_road = road if (road and data.get("addresstype") == "road" and road == nd.get("ref")
                            and not any("name" in k for k in nd)) else None
        venue_keys = ("amenity", "shop", "tourism", "leisure", "office", "craft")
        en = english_names([(x, k) for x, k in ((road, "street"), (nbhd, "area"), (city, "area"), *(
            (v, "place") for v in (data.get("name"), *map(addr.get, venue_keys)))) if x and x != ref_road])
        _en = lambda x: x if x not in en else (en[x]["en"] if en[x]["is_name"] else None)
        # isdigit() reads an OSM `ref` tag value, machine structure ("3976" vs "I 95"), not language.
        road = (f"Route {ref_road}" if ref_road.isdigit() else ref_road) if ref_road else _en(road)
        nbhd, city = _en(nbhd), _en(city)
        # Build the canonical address line first (street, neighborhood, city, state).
        parts: List[str] = []
        if house and road:
            parts.append(f"{house} {road}")
        elif road:
            parts.append(road)
        if nbhd:
            parts.append(nbhd)
        if city:
            parts.append(city)
        if state:
            parts.append(state)
        addr_line = ", ".join(parts) if parts else ""

        # Try to surface a real venue name. Nominatim exposes POIs through address.amenity /
        # shop / tourism / leisure / office / craft / building (when named), and the top-level
        # `name` field when the matched feature is a POI rather than a road/area.
        venue = next((addr.get(k) for k in venue_keys if addr.get(k)), None)
        addr_type = data.get("addresstype") or ""
        top_name = data.get("name")
        # Top-level name is only trustworthy when it's not just a road/area echo.
        AREA_TYPES = {"road", "residential", "neighbourhood", "suburb", "quarter",
                      "city", "town", "village", "state", "country", "postcode"}
        if not venue and top_name and addr_type and addr_type not in AREA_TYPES:
            venue = top_name
        native, venue = venue, _en(venue)
        native = native if venue and native != venue else None

        if venue:
            name = venue
            if nbhd and nbhd != venue:
                name = f"{venue} ({nbhd})"
            confidence = 0.75
        elif house and road:
            name = f"{house} {road}"
            if nbhd:
                name = f"{name}, {nbhd}"
            confidence = 0.65
        elif road:
            name = road
            if nbhd:
                name = f"{name}, {nbhd}"
            confidence = 0.6
        elif nbhd:
            name = f"{nbhd}, {city}" if city and city != nbhd else nbhd
            confidence = 0.55
        else:
            name = city or addr_line
            confidence = 0.5
        return (name, addr_line, confidence, native) if name else None
    except Exception:
        return None

def nominatim_neighborhood(lat: float, lon: float) -> Optional[str]:
    """Just the neighborhood/suburb (else city) name for a point — the fallback
    label for the confidence-gated naming ladder, so a caller always has a
    locality even when the primary resolve is a confident venue. Lower zoom (14)
    biases toward the neighborhood, not a street/POI."""
    try:
        # zoom 15 surfaces the actual neighborhood — zoom 14 collapses to the
        # borough/city. Prefer the neighborhood-grain fields; in a big city
        # `suburb` is the borough, so it ranks below the finer fields.
        url = (f"https://nominatim.openstreetmap.org/reverse"
               f"?lat={lat}&lon={lon}&format=json&zoom=15&addressdetails=1&accept-language=en")
        req = urllib.request.Request(url, headers={"User-Agent": "location-segment/1.0"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read())
        addr = data.get("address", {}) or {}
        return (addr.get("neighbourhood") or addr.get("quarter")
                or addr.get("city_district") or addr.get("suburb")
                or addr.get("city") or addr.get("town") or addr.get("village"))
    except Exception:
        return None

# ============================================================================
# Google Places
# ============================================================================

import hashlib
import time

def _places_locale(lat: float, lon: float) -> Dict[str, str]:
    """Hebrew names for Israeli coordinates — lib/places_nearby.py
    places_locale (2026-10-06). {} elsewhere, and on any import trouble."""
    try:
        from places_nearby import places_locale
        return places_locale(lat, lon)
    except Exception:
        return {}


def _places_cache_key(prefix: str, lat: float, lon: float, radius_m: float,
                       max_results: int, query: str = "") -> str:
    # Round centroid to 4 decimals (~11 m). Real movement still cache-misses;
    # GPS jitter on the same dwell hits the same key. Bucket radius to 20m
    # so neighboring stop-radius values collapse to one entry.
    lat_r = round(lat, 4)
    lon_r = round(lon, 4)
    rad_r = int(radius_m / 20) * 20
    raw = f"{prefix}|{lat_r}|{lon_r}|{rad_r}|{max_results}|{query}"
    return hashlib.md5(raw.encode("utf-8")).hexdigest()[:16]

def _places_cache_get(key: str, allow_stale: bool = False) -> Optional[List[Dict[str, Any]]]:
    path = os.path.join(PLACES_CACHE_DIR, f"{key}.json")
    try:
        if not os.path.exists(path):
            return None
        age = time.time() - os.path.getmtime(path)
        if age > PLACES_CACHE_TTL_SEC and not allow_stale:
            return None
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None

def _places_cache_set(key: str, results: List[Dict[str, Any]]) -> None:
    try:
        os.makedirs(PLACES_CACHE_DIR, exist_ok=True)
        path = os.path.join(PLACES_CACHE_DIR, f"{key}.json")
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(results, f)
        os.replace(tmp, path)
    except Exception:
        pass

# rating + userRatingCount make both searches Enterprise tier (not Atmosphere).
_LS_PLACES_MASK = ("places.displayName,places.formattedAddress,places.rating,"
                   "places.userRatingCount,places.primaryType,places.types,"
                   "places.location,places.id")


def google_places_nearby(lat: float, lon: float, radius_m: float = PLACES_RADIUS_M,
                         max_results: int = 20) -> List[Dict[str, Any]]:
    key = get_google_places_key()
    if not key:
        return []
    locale = _places_locale(lat, lon)
    ck = _places_cache_key("nearby", lat, lon, radius_m, max_results,
                           ("lang=" + locale["languageCode"]) if locale else "")
    cached = _places_cache_get(ck)
    if cached is not None:
        _places_log("location-segment", "searchNearby", tier="enterprise", cached=True)
        return cached
    try:
        body = {
            "locationRestriction": {
                "circle": {"center": {"latitude": lat, "longitude": lon}, "radius": radius_m},
            },
            "rankPreference": "DISTANCE",
            "maxResultCount": max_results,
            **locale,
        }
        from places_client import post as _places_post  # the one guarded door: prices, gates, logs
        data = _places_post("location-segment", "places:searchNearby", body, _LS_PLACES_MASK, "searchNearby",
                            timeout=10, api_key=key, lat=lat, lon=lon, radius=radius_m)
    except Exception as e:
        print(f"[location-segment] places error: {e}", file=sys.stderr)
        return []

    results: List[Dict[str, Any]] = []
    for p in data.get("places", []):
        loc = p.get("location") or {}
        plat = loc.get("latitude")
        plon = loc.get("longitude")
        if plat is None or plon is None:
            continue
        results.append({
            "name": (p.get("displayName") or {}).get("text", "?"),
            "address": p.get("formattedAddress", ""),
            "rating": p.get("rating"),
            "reviews": p.get("userRatingCount", 0) or 0,
            "primary_type": p.get("primaryType", ""),
            "types": p.get("types", []),
            "lat": plat,
            "lon": plon,
            "distance_m": haversine_m(lat, lon, plat, plon),
            "place_id": p.get("id", ""),
        })
    # Only cache a NON-EMPTY answer. An empty Overpass response is far more
    # likely a rate-limit or a partial outage than "there are no venues here",
    # and caching it would freeze the wrong POI in place for the full 7 days —
    # the precise failure this cache exists to prevent.
    if results:
        _places_cache_set(ck, results)
    else:
        stale = _places_cache_get(ck, allow_stale=True)
        if stale:
            print(f"[location-segment] overpass returned 0 POIs — using cached ({len(stale)})", file=sys.stderr)
            return stale
    return results

# ============================================================================
# Vacation-rental listing filter
# ============================================================================
#
# Hosts publish Airbnb/Vrbo listings into Google Places, so a coastal block in a
# tourist town is carpeted with pins whose "name" is a marketing headline. They
# are dense, they sit meters from the path, and they can never be corroborated —
# so they win the nearest-POI joust and then get printed as if they were venues.
# One seaside day shipped two of them as stop titles:
#
#   ~T2 Sea View. The small ones. Near the port. Family. Balcony.?
#   ~Résidence avec Piscine face au port 200m plage?
#
# ...for two stretches of walking near the marina. They also drive the
# location-enrich ASKS ("20m near a cluster of vacation rentals…"), so filtering
# here — at the producer — fixes the questions and the summary together.
#
# Dropping one costs nothing: the ladder falls through to Nominatim, and a
# beach's name or a street address is a strictly better label than a listing
# headline. A REAL hotel (ordinary name, street address, reviews) trips none of
# these tests and is unaffected.

# Unmistakable on their own.
_LISTING_BRAND = re.compile(r"\b(vrbo|airbnb|homeaway|abritel|booking\.com|expedia|tripadvisor\s+rental)\b", re.I)  # kernel-guard-ok: public rental-platform names a listing title carries, the same for every user
_LISTING_ID = re.compile(r"\b[A-Z]{2}-\d+-\d+-\d+\b")
_GUEST_COUNT = re.compile(
    r"\b(sleeps?\s*\d+|\d+\s*(guests?|bedrooms?|beds?|chambres?|pi[eè]ces?|personnes?|pers\.?|couchages?)|\d+\s*br\b|\bT[1-6]\b)",
    re.I)

# Need two or more of these.
_ACCOM_NOUN = re.compile(
    r"\b(appartements?|apartments?|appart|studios?|duplex|lofts?|r[ée]sidences?|"
    r"g[iî]tes?|cottages?|bungalows?|mobil[- ]?home|chambre\s+d.h[oô]te)\b", re.I)
_AMENITY_PITCH = re.compile(
    r"(sea\s*view|ocean\s*view|vue\s*mer|panoramic|beach\s*front|bord\s*de\s*mer|"
    r"pr[eè]s\s+de\s+la\s+plage|face\s+au\s+port|steps?\s+from|\d+\s*m\s*(from\s+)?(the\s+)?(beach|plage)|"
    r"avec\s+(piscine|terrasse|balcon|jardin)|with\s+(pool|terrace|balcony|garden|hot\s*tub))", re.I)
_LODGING_TYPES = {"lodging", "guest_house", "bed_and_breakfast", "cottage", "farmstay",
                  "apartment_complex", "apartment_building", "condominium_complex",
                  "housing_complex", "vacation_rental_agency"}


def _has_street_address(address: Optional[str]) -> bool:
    """A real walk-in venue publishes a street. Listing pins publish a city."""
    if not address:
        return False
    first = address.split(",")[0].strip()
    # "14 Rue de l'Exemple" -> yes. "17000 Villeneuve" (postcode + city) -> no.
    return bool(re.match(r"^\d+\S*\s+\S", first)) and not re.match(r"^\d{4,6}\s", first)


def is_rental_listing(c: Dict[str, Any]) -> bool:
    """Is this Places candidate a vacation-rental LISTING rather than a venue?"""
    name = (c.get("name") or "").strip()
    if not name:
        return False
    if _LISTING_BRAND.search(name) or _LISTING_ID.search(name) or _GUEST_COUNT.search(name):
        return True
    # A name written as several sentences is a listing headline, never a venue.
    if len([seg for seg in re.split(r"\.\s+|\.$", name) if seg.strip()]) >= 3:
        return True
    weak = 0
    if _ACCOM_NOUN.search(name):
        weak += 1
    if _AMENITY_PITCH.search(name):
        weak += 1
    if len(name) > 40:
        weak += 1
    if not _has_street_address(c.get("address")):
        weak += 1
    if (c.get("primary_type") or "") in _LODGING_TYPES and not (c.get("reviews") or 0):
        weak += 1
    return weak >= 3


def score_places_candidate(c: Dict[str, Any], hour_local: Optional[int] = None) -> float:
    type_score = PLACE_TYPE_PRIORITY.get(c.get("primary_type", ""), 20)
    # Gentler prox decay: 100 at 0 m, 75 at 50 m, 50 at 100 m, 0 at 200 m.
    # The old formula (max(0, 100 - 2d)) zeroed at 50 m, which made venues at the
    # edge of a 150 m cluster impossible to ever beat the closest indexed business —
    # so The Bitter End at 54 m kept losing to a sushi restaurant at 8 m.
    distance_m = c.get("distance_m", 0) or 0
    prox_score = max(0.0, 100.0 - distance_m * 0.5)
    reviews = c.get("reviews", 0) or 0
    # Cap raised popularity at 25 (was 50) AND decay by distance: a famous venue
    # at 100 m shouldn't outweigh a closer venue at 30 m. Without this decay,
    # Shu Jiao Fu Zhou (2999 reviews, 97 m) beat Pho Grand (993 reviews, 33 m)
    # for yesterday's lunch stop.
    pop_raw = min(25.0, reviews ** 0.5)
    pop_decay = 1.0 / (1.0 + distance_m / 100.0)
    pop_score = pop_raw * pop_decay
    # Rating is now a small bonus, not a baseline. Pre-2026-04-25 we used
    # `(rating or 3.0) * 4` which gave un-enriched OSM POIs a 12-point baseline
    # while a Google-enriched venue at 4.3 stars scored 17 — net 5-point handicap
    # against any OSM venue Google didn't surface. Now rating only adds points
    # when the venue is genuinely well-rated (≥4.0) and contributes 0 otherwise.
    rating = c.get("rating")
    if rating is None:
        rating_score = 0.0
    elif rating >= 4.5:
        rating_score = 10.0
    elif rating >= 4.0:
        rating_score = 5.0
    else:
        rating_score = 0.0
    boost = 0.0
    if hour_local is not None:
        bucket = hour_to_bucket(hour_local)
        boost = TIME_OF_DAY_BOOST.get(bucket, {}).get(c.get("primary_type", ""), 0)
    return type_score + prox_score + pop_score + rating_score + boost

def hour_to_bucket(h: int) -> str:
    if 6 <= h < 11: return "morning"
    if 11 <= h < 15: return "lunch"
    if 15 <= h < 17: return "afternoon"
    if 17 <= h < 22: return "dinner"
    return "night"  # 22-05

def stop_local_hour(start_ts_ms: int, end_ts_ms: int) -> int:
    """Return local-hour at the stop midpoint (the home zone, HOME_TZ)."""
    mid_s = (start_ts_ms + end_ts_ms) / 2 / 1000.0
    return datetime.fromtimestamp(mid_s, tz=HOME_TZ).hour

def time_of_day_queries(hour_local: int) -> List[str]:
    for (lo, hi), prompts in TIME_OF_DAY_PROMPTS:
        if lo <= hour_local < hi:
            return prompts
        # Late-night window straddles midnight (22-27 means 22-23 wraps to 0-3).
        if hi > 24 and (hour_local >= lo or hour_local < hi - 24):
            return prompts
    return []

def google_places_search_text(query: str, lat: float, lon: float, radius_m: float,
                              max_results: int = 20) -> List[Dict[str, Any]]:
    """20 is the Google cap; using less arbitrarily drops good hits — Pho Grand at
    33 m only surfaced via `restaurant` when max_results was raised from 8 to 20."""
    # places:searchText — biased to the centroid. Different surface than searchNearby:
    # catches venues by category prompt ("bar music venue") that nearest-20 misses in dense
    # blocks. Returns candidates inside 1.5x radius so the bias doesn't pull from a block away.
    key = get_google_places_key()
    if not key:
        return []
    locale = _places_locale(lat, lon)
    ck = _places_cache_key("text", lat, lon, radius_m, max_results,
                           query + (("|lang=" + locale["languageCode"]) if locale else ""))
    cached = _places_cache_get(ck)
    if cached is not None:
        _places_log("location-segment", "searchText", tier="enterprise", cached=True)
        return cached
    try:
        body = {
            "textQuery": query,
            "locationBias": {"circle": {"center": {"latitude": lat, "longitude": lon},
                                         "radius": radius_m}},
            "maxResultCount": max_results,
            **locale,
        }
        from places_client import post as _places_post  # the one guarded door: prices, gates, logs
        data = _places_post("location-segment", "places:searchText", body, _LS_PLACES_MASK, "searchText",
                            timeout=10, api_key=key, query=query, lat=lat, lon=lon, radius=radius_m)
    except Exception as e:
        print(f"[location-segment] places searchText error: {e}", file=sys.stderr)
        return []

    cap_m = radius_m * 1.5
    results: List[Dict[str, Any]] = []
    for p in data.get("places", []):
        loc = p.get("location") or {}
        plat = loc.get("latitude")
        plon = loc.get("longitude")
        if plat is None or plon is None:
            continue
        d = haversine_m(lat, lon, plat, plon)
        if d > cap_m:
            continue
        results.append({
            "name": (p.get("displayName") or {}).get("text", "?"),
            "address": p.get("formattedAddress", ""),
            "rating": p.get("rating"),
            "reviews": p.get("userRatingCount", 0) or 0,
            "primary_type": p.get("primaryType", ""),
            "types": p.get("types", []),
            "lat": plat,
            "lon": plon,
            "distance_m": d,
            "place_id": p.get("id", ""),
        })
    _places_cache_set(ck, results)
    return results

# ============================================================================
# OSM Overpass — primary venue source (free, deterministic, no API key)
# ============================================================================

def osm_overpass_pois(lat: float, lon: float, radius_m: float,
                      kinds: Tuple[str, ...] = OSM_AMENITY_KINDS,
                      timeout_s: int = OVERPASS_TIMEOUT_S) -> List[Dict[str, Any]]:
    """Return named OSM venue POIs around (lat, lon) shaped like the Google Places
    result records so the existing scorer + merger can consume them transparently.
    Only POIs with both an amenity tag and a name come through — unnamed buildings
    are noise here. Cuisine tag takes precedence over plain amenity for primary_type
    so a Vietnamese restaurant scores as `vietnamese_restaurant` not just `restaurant`.
    """
    # CACHE (2026-07-27). Google Places has been cached for 7 days; Overpass was
    # not, so every re-resolve re-queried a free, heavily rate-limited public
    # endpoint — and when it errored the OSM candidates simply vanished, taking
    # the OSM_VERIFIED_BONUS with them and handing the stop to a different POI.
    # That is why 2026-07-26's 12:09 stop rendered "Capitaine café" on one run
    # and "Yélomobile autopartage : Station Les Minimes" on the next: the same
    # day resolving differently depending on whether Overpass happened to answer.
    # An unconfirmed title has to at least be STABLE.
    ck = _places_cache_key("osm-en", lat, lon, radius_m, len(kinds), len(OSM_SHOP_KINDS))  # "osm": local names only
    cached = _places_cache_get(ck)
    if cached is not None:
        return cached

    # Two unioned clauses: `amenity` (restaurant/bar/cafe/...) and `shop`
    # (supermarket/convenience/...) — these are different OSM tag keys, so a
    # single amenity-only selector structurally cannot match a Whole Foods or
    # Costco no matter how the value list is extended.
    amenity_selector = "|".join(kinds)
    shop_selector = "|".join(OSM_SHOP_KINDS)
    q = (
        f"[out:json][timeout:{max(timeout_s - 2, 5)}];"
        f"(nwr[\"amenity\"~\"^({amenity_selector})$\"][\"name\"](around:{radius_m},{lat},{lon});"
        f"nwr[\"shop\"~\"^({shop_selector})$\"][\"name\"](around:{radius_m},{lat},{lon}););"
        f"out center tags;"
    )
    try:
        from overpass_client import post as _overpass_post
        data = _overpass_post(q, timeout_s=timeout_s)
    except Exception as e:
        # A stale venue list beats a different answer every run.
        stale = _places_cache_get(ck, allow_stale=True) or _places_cache_get(
            _places_cache_key("osm", lat, lon, radius_m, len(kinds), len(OSM_SHOP_KINDS)), allow_stale=True)
        print(f"[location-segment] overpass error: {e}"
              + (f" — using cached POIs ({len(stale)})" if stale else ""), file=sys.stderr)
        return stale if stale is not None else []

    results: List[Dict[str, Any]] = []
    for el in data.get("elements", []):
        tags = el.get("tags") or {}
        name, native = osm_display_name(tags)
        if not name:
            continue
        elat = el.get("lat") or (el.get("center") or {}).get("lat")
        elon = el.get("lon") or (el.get("center") or {}).get("lon")
        if elat is None or elon is None:
            continue
        amenity = tags.get("amenity") or ""
        shop = tags.get("shop") or ""
        cuisine_first = (tags.get("cuisine") or "").split(";")[0].strip().lower()
        primary_type = (OSM_CUISINE_TO_TYPE.get(cuisine_first)
                        or OSM_AMENITY_TO_TYPE.get(amenity)
                        or OSM_SHOP_TO_TYPE.get(shop)
                        or (amenity or shop))
        # Address line from OSM addr:* tags (often present in big cities).
        addr_parts: List[str] = []
        if tags.get("addr:housenumber") and tags.get("addr:street"):
            addr_parts.append(f"{tags['addr:housenumber']} {tags['addr:street']}")
        elif tags.get("addr:street"):
            addr_parts.append(tags["addr:street"])
        if tags.get("addr:city"):
            addr_parts.append(tags["addr:city"])
        # Notability tags — used by the scorer to break ties between equally-close
        # venues. wikidata/wikipedia mark encyclopedically-notable places (The
        # Bitter End at 147 Bleecker has both; Terra Blues next door has neither).
        notability = {
            "wikidata": tags.get("wikidata") or tags.get("brand:wikidata"),
            "wikipedia": tags.get("wikipedia"),
            "tourism": tags.get("tourism"),
            "heritage": tags.get("heritage"),
            "website": tags.get("website") or tags.get("contact:website"),
            "brand": tags.get("brand"),
            "cuisine": cuisine_first,
        }
        results.append({
            "name": name,
            "name_native": native,
            "address": ", ".join(addr_parts),
            "rating": None,         # OSM doesn't carry ratings; Google enrichment may fill
            "reviews": 0,           # OSM doesn't carry review counts
            "primary_type": primary_type,
            "types": [t for t in (amenity, shop, cuisine_first) if t],
            "lat": elat,
            "lon": elon,
            "distance_m": haversine_m(lat, lon, elat, elon),
            "place_id": f"osm:{el.get('type')}/{el.get('id')}",
            "_source": "osm",
            "_notability": notability,
        })
    _places_cache_set(ck, results)
    return results

def name_token_overlap(a: str, b: str) -> float:
    """Jaccard over normalized word tokens (≥3 chars each, common words dropped).
    Diacritics are stripped (Phở → pho) so OSM's `Pho Grand` matches Google's
    `Phở Grand` — without this we miss Google enrichment for any non-ASCII venue.
    """
    import unicodedata
    STOP = {"the", "and", "bar", "cafe", "restaurant", "shop", "store", "house",
            "of", "for", "at", "by", "on", "new", "york"}  # kernel-guard-ok: a city word in many venue names, a stopword for any user
    def normalize(s: str) -> str:
        # NFKD decomposes "ở" → "o" + combining-tilde; the second filter drops the mark.
        n = unicodedata.normalize("NFKD", s)
        return "".join(c for c in n if not unicodedata.combining(c)).lower()
    def toks(s: str) -> set:
        return {w for w in (t.strip(".,()[]'\"") for t in normalize(s).split())
                if len(w) >= 3 and w not in STOP}
    ta, tb = toks(a), toks(b)
    if not ta or not tb:
        return 0.0
    return len(ta & tb) / len(ta | tb)

# ============================================================================
# Place resolution (tiered)
# ============================================================================

from place_naming import match_named_location, english_names  # noqa: E402
from osm_places import osm_display_name  # noqa: E402


def _in_english(picked: List[PlaceCandidate]) -> List[PlaceCandidate]:
    """Surfaced OSM/Google guesses with no English tag, in English; his own names are never touched."""
    ask = [c for c in picked if c.source in ("osm_overpass", "google_places") and not c.name_native]
    en = english_names([c.name for c in ask]) if ask else {}
    for c in ask:
        a = en.get(c.name)
        if a and a["is_name"] and a["en"] != c.name:
            c.name_native, c.name = c.name, a["en"]
    return picked

def match_known_recurring(lat: float, lon: float, entries: List[Dict[str, Any]]
                          ) -> Optional[Tuple[Dict[str, Any], float]]:
    best: Optional[Tuple[Dict[str, Any], float]] = None
    for e in entries:
        coords = e.get("coords")
        if not coords or len(coords) != 2:
            continue
        d = haversine_m(lat, lon, coords[0], coords[1])
        prox = e.get("proximity_m") or 120
        if d <= prox and (best is None or d < best[1]):
            best = (e, d)
    return best

def match_confirmed_stop(lat: float, lon: float, entries: List[Dict[str, Any]]
                         ) -> Optional[Tuple[Dict[str, Any], float]]:
    """Closest past confirmation within CONFIRMED_STOP_MATCH_M, if any. The saver
    writes centroid as `{"lat":..., "lon":...}` but tolerate `[lat, lon]` lists too."""
    best: Optional[Tuple[Dict[str, Any], float]] = None
    for e in entries:
        c = e.get("centroid") or e.get("coords")
        if not c:
            continue
        if isinstance(c, dict):
            elat, elon = c.get("lat"), c.get("lon")
        elif isinstance(c, (list, tuple)) and len(c) == 2:
            elat, elon = c[0], c[1]
        else:
            continue
        if elat is None or elon is None:
            continue
        d = haversine_m(lat, lon, elat, elon)
        if d <= CONFIRMED_STOP_MATCH_M and (best is None or d < best[1]):
            best = (e, d)
    return best

REST_ACC_MAX_M = 35.0  # a sample must be this precise to say where he SAT (mirrors stop-rests.js)

def match_confirmed_stop_at_rest(stop: StopCandidate, entries: List[Dict[str, Any]]
                                 ) -> Optional[Tuple[Dict[str, Any], float]]:
    """The centroid match above averages in the walk to the door, so a long
    stay can sit 40 m from its own confirmation and miss the 30 m ring -- on
    one day a jazz club's cluster centroid was 41 m from an earlier
    confirmation 13 m off the visit row, and the stop went unnamed. Ask the
    samples instead: a confirmation names the stop when at least two precise
    samples, and most of the precise samples, are within CONFIRMED_STOP_MATCH_M
    of it (the same majority rule as resolve-day's restSatAt). Nearest wins
    among several that pass; a stop whose samples never settle names nothing."""
    precise = [s for s in stop.samples
               if s.accuracy_m is None or s.accuracy_m <= REST_ACC_MAX_M]
    if len(precise) < 2:
        return None
    best: Optional[Tuple[Dict[str, Any], float]] = None
    for e in entries:
        c = e.get("centroid") or e.get("coords")
        if isinstance(c, dict):
            elat, elon = c.get("lat"), c.get("lon")
        elif isinstance(c, (list, tuple)) and len(c) == 2:
            elat, elon = c[0], c[1]
        else:
            continue
        if elat is None or elon is None:
            continue
        dists = [haversine_m(s.lat, s.lon, elat, elon) for s in precise]
        at = [d for d in dists if d <= CONFIRMED_STOP_MATCH_M]
        if len(at) < 2 or len(at) * 2 < len(precise):
            continue
        d = min(at)
        if best is None or d < best[1]:
            best = (e, d)
    return best

def match_wifi(stop: StopCandidate, wifi_entries: List[Dict[str, Any]]
               ) -> Optional[Dict[str, Any]]:
    """Wi-Fi match requires a recent phone_context snapshot whose ts falls in the stop's window
    AND whose ssid matches a wifi-map entry. v1 does a single latest-context check; if that
    snapshot's ts overlaps a stop window, attach. Stop-specific historical SSID requires the
    append-only history table (deferred). Returns the matched wifi entry or None.
    """
    if not wifi_entries:
        return None
    # Latest snapshot only — limit of single-row-per-device upsert table.
    ctx = fetch_phone_context_latest()
    if not ctx:
        return None
    ssid = ctx.get("wifi_ssid")
    bssid = ctx.get("wifi_bssid")
    ctx_ts = parse_iso_to_ms(ctx.get("ts", "")) if isinstance(ctx.get("ts"), str) else 0
    if not ssid or not ctx_ts:
        return None
    if not (stop.start_ts_ms - 5 * 60_000 <= ctx_ts <= stop.end_ts_ms + 5 * 60_000):
        return None
    for e in wifi_entries:
        if e.get("ssid") and e["ssid"] == ssid:
            if not e.get("bssid") or e.get("bssid") == bssid:
                return e
    return None

def resolve_place(stop: StopCandidate, opts: "Options",
                  recurring: List[Dict[str, Any]],
                  wifi_entries: List[Dict[str, Any]],
                  confirmed: Optional[List[Dict[str, Any]]] = None,
                  ) -> Tuple[PlaceCandidate, List[PlaceCandidate]]:
    clat, clon = stop.centroid()
    confirmed = confirmed or []

    # 1) named locations (anchors)
    named = match_named_location(clat, clon)
    if named:
        loc, d = named
        primary = PlaceCandidate(
            name=loc["name"], address=loc.get("address"),
            source="named_location", confidence=0.95, distance_m=d,
        )
        return primary, []

    # 2) confirmed stops — past one-off venue confirmations from the live ask-cron.
    #    Beats known-recurring because a fresh user confirmation is more authoritative
    #    than a hand-curated entry that may be stale.
    #    Matched at the centroid first, then at the samples themselves -- the
    #    centroid of a long stay includes the walk in (see match_confirmed_stop_at_rest).
    conf_match = match_confirmed_stop(clat, clon, confirmed) \
        or match_confirmed_stop_at_rest(stop, confirmed)
    if conf_match:
        e, d = conf_match
        primary = PlaceCandidate(
            name=e["name"], address=e.get("address"),
            source="confirmed_stop", confidence=0.95, distance_m=d,
            place_id=e.get("place_id"),
            primary_type=e.get("primary_type"),
        )
        return primary, []

    # 3) known recurring stops
    rec = match_known_recurring(clat, clon, recurring)
    if rec:
        e, d = rec
        primary = PlaceCandidate(
            name=e["name"], address=e.get("address"),
            source="known_recurring", confidence=0.92, distance_m=d,
        )
        return primary, []

    # 3) Wi-Fi SSID overlay (best-effort, latest snapshot only)
    if wifi_entries:
        wifi = match_wifi(stop, wifi_entries)
        if wifi and wifi.get("place"):
            primary = PlaceCandidate(
                name=wifi["place"], address=None,
                source="wifi_ssid", confidence=0.90,
            )
            return primary, []

    candidates: List[PlaceCandidate] = []
    is_long = stop.duration_min >= LONG_STOP_MIN
    hour_local = stop_local_hour(stop.start_ts_ms, stop.end_ts_ms)

    # Common search radius — scales with cluster footprint so noisy stops still
    # surface real venues; long stops get a wider window since dwell-time +
    # hour-of-day strongly predict the venue category.
    if is_long:
        radius = max(LONG_STOP_PLACES_RADIUS_M,
                     min(stop.cluster_radius_m() + 20, LONG_STOP_PLACES_RADIUS_CAP_M))
        google_max = LONG_STOP_MAX_RESULTS
    else:
        radius = max(PLACES_RADIUS_M, min(stop.cluster_radius_m() + 20, 200.0))
        google_max = 5

    # 4) OSM Overpass — primary source. Free, deterministic, and far more
    #    comprehensive than Google's nearest-20 in dense urban blocks.
    osm_pois: List[Dict[str, Any]] = []
    if not opts.no_overpass:
        raw_osm = osm_overpass_pois(clat, clon, radius_m=radius)
        # Dedupe — OSM often models a business as both a node and a way (the building
        # polygon) with identical name+coords. Keep the first occurrence per (name, lat, lon).
        seen_osm: set = set()
        for o in raw_osm:
            key = (o["name"].lower(), round(o["lat"], 5), round(o["lon"], 5))
            if key in seen_osm:
                continue
            seen_osm.add(key)
            osm_pois.append(o)

    # 5) Google Places — enrichment (rating/reviews) + fallback when OSM is sparse.
    google_pois: List[Dict[str, Any]] = []
    text_n = 0
    if not opts.no_places:
        google_pois = google_places_nearby(clat, clon, radius_m=radius, max_results=google_max)
        if is_long:
            for q in time_of_day_queries(hour_local):
                hits = google_places_search_text(q, clat, clon, radius_m=radius, max_results=20)
                google_pois.extend(hits)
                text_n += len(hits)
        # Dedupe Google results by place_id.
        seen_g: set = set()
        google_pois = [p for p in google_pois
                       if not (p.get("place_id") in seen_g or seen_g.add(p.get("place_id")))]

    # 6) Merge — for each OSM POI, find a matching Google POI (within 60 m AND
    #    name overlap ≥ 0.4) and inherit its rating/review count. Google POIs
    #    that don't match any OSM entry come through on their own (covers
    #    new venues OSM hasn't picked up yet).
    matched_google_ids: set = set()
    pool: List[Dict[str, Any]] = []
    for o in osm_pois:
        best_g, best_score = None, 0.0
        for g in google_pois:
            d = haversine_m(o["lat"], o["lon"], g["lat"], g["lon"])
            if d > 60.0:
                continue
            ov = max(name_token_overlap(o["name"], g.get("name", "")),  # Google may be in Hebrew
                     name_token_overlap(o.get("name_native") or "", g.get("name", "")))
            if ov >= 0.4 and ov > best_score:
                best_g, best_score = g, ov
        merged = dict(o)
        if best_g is not None:
            merged["rating"] = best_g.get("rating")
            merged["reviews"] = best_g.get("reviews", 0)
            merged["place_id_google"] = best_g.get("place_id")
            matched_google_ids.add(best_g.get("place_id"))
        pool.append(merged)
    for g in google_pois:
        if g.get("place_id") in matched_google_ids:
            continue
        gp = dict(g)
        gp["_source"] = "google"
        pool.append(gp)

    # Drop vacation-rental listings BEFORE scoring — they're dense, they sit
    # meters off the path in any tourist town, and they can never be corroborated,
    # so left in the pool they win the nearest-POI joust and get printed as venues.
    # See is_rental_listing().
    rentals = [p for p in pool if is_rental_listing(p)]
    if rentals:
        pool = [p for p in pool if p not in rentals]

    if opts.debug:
        print(f"[location-segment] resolve stop@({clat:.4f},{clon:.4f}) "
              f"r={radius:.0f}m long={is_long} hour={hour_local}({hour_to_bucket(hour_local)}) "
              f"→ osm={len(osm_pois)} google_nearby+text={len(google_pois)} "
              f"merged={len(pool)} text_q={text_n} "
              f"rentals_dropped={len(rentals)}"
              + (f" [{'; '.join((p.get('name') or '')[:40] for p in rentals[:3])}]" if rentals else ""),
              file=sys.stderr)

    def pool_score(p: Dict[str, Any]) -> float:
        s = score_places_candidate(p, hour_local)
        if p.get("_source") == "osm":
            s += OSM_VERIFIED_BONUS  # named amenity in OSM = authoritative venue identity
            n = p.get("_notability") or {}
            if n.get("wikidata") or n.get("wikipedia"):
                s += OSM_WIKIDATA_BONUS
            if n.get("tourism") or n.get("heritage"):
                s += OSM_TOURISM_BONUS
            if n.get("brand"):
                s += OSM_BRAND_BONUS
            if n.get("website"):
                s += OSM_WEBSITE_BONUS
            if n.get("cuisine"):
                s += OSM_CUISINE_TAG_BONUS
        return s

    scored = sorted(pool, key=pool_score, reverse=True)
    # Tie-aware confidence cap: if the top candidate's lead over #2 is < 10 score
    # points, both are essentially tied — drop the cap to 0.80 so downstream
    # consumers (the live ask-cron) know to ask rather than auto-accept. Without
    # this, Fruit Vanity (cafe, 19 m) and Pho Grand (vietnamese, 33 m) both hit
    # the 0.92 cap and the cron skips on "high confidence" even though it's a coin flip.
    top_score = pool_score(scored[0]) if scored else 0.0
    runner_up = pool_score(scored[1]) if len(scored) >= 2 else 0.0
    is_tied = (top_score - runner_up) < 10.0
    cap = 0.80 if is_tied else 0.92
    for i, p in enumerate(scored[:5]):
        raw = pool_score(p)
        conf = max(0.45, min(cap, 0.45 + raw / 400.0))
        src = "osm_overpass" if p.get("_source") == "osm" else "google_places"
        candidates.append(PlaceCandidate(
            name=p["name"], address=p.get("address"),
            source=src, confidence=conf,
            distance_m=p.get("distance_m"),
            place_id=p.get("place_id"),
            primary_type=p.get("primary_type"),
            name_native=p.get("name_native"),
        ))

    if getattr(opts, "saved_places", False):
        saved = saved_place_candidates(stop)
        if saved:
            ids = {c.place_id for c in saved if c.place_id}
            candidates = saved + [c for c in candidates
                                  if not (c.place_id and c.place_id in ids)
                                  and all(name_token_overlap(c.name, sv.name) < 0.6 for sv in saved)]
            candidates.sort(key=lambda c: c.confidence, reverse=True)

    threshold = LONG_STOP_PRIMARY_CONF_THRESHOLD if is_long else PLACES_PRIMARY_CONF_THRESHOLD
    if candidates and candidates[0].confidence >= threshold:
        picked = _in_english(candidates[:3])
        return picked[0], picked[1:3]

    # 5) Nominatim — venue-aware reverse geocode. Always merge with any weak Places
    #    candidates so the user sees both the address ("12 Example St") and any nearby
    #    venue guesses ("Example Noodle Bar", "Example Pizza") as alternatives.
    geo = reverse_geocode_nominatim(clat, clon)
    nom_candidate: Optional[PlaceCandidate] = None
    if geo:
        name, addr, conf, native = geo
        nom_candidate = PlaceCandidate(
            name=name, address=addr or None,
            source="reverse_geocode", confidence=conf, name_native=native,
        )

    pool: List[PlaceCandidate] = list(candidates)
    if nom_candidate:
        pool.append(nom_candidate)
    pool.sort(key=lambda c: c.confidence, reverse=True)

    if pool:
        picked = _in_english(pool[:3])
        return picked[0], picked[1:3]

    # 6) coords fallback
    return PlaceCandidate(
        name=f"{clat:.4f}, {clon:.4f}", address=None,
        source="coordinate", confidence=0.3,
    ), []

# ============================================================================
# Stop detection — Li/Zheng anchor-walk
# ============================================================================

def detect_stops(samples: List[Sample], min_stop_min: float, stop_radius_m: float
                 ) -> List[StopCandidate]:
    """Li/Zheng (2008) anchor-walk.

    For each anchor, walk forward through samples while every following sample
    is within `stop_radius_m` of the anchor. If the spanned window meets
    `min_stop_min`, emit a stop candidate and skip past those samples.
    Otherwise advance the anchor by one and try again.
    """
    if not samples:
        return []
    pts = sorted(samples, key=lambda s: s.ts_ms)
    n = len(pts)
    out: List[StopCandidate] = []
    i = 0
    while i < n:
        anchor = pts[i]
        j = i + 1
        while j < n and haversine_m(anchor.lat, anchor.lon, pts[j].lat, pts[j].lon) <= stop_radius_m:
            j += 1
        # candidate window = pts[i..j-1] (j-1 inclusive)
        end_idx = j - 1
        if end_idx > i:
            duration_min = (pts[end_idx].ts_ms - anchor.ts_ms) / 60_000
            if duration_min >= min_stop_min:
                out.append(StopCandidate(samples=pts[i:j]))
                i = j
                continue
        i += 1
    return out

def merge_stops_temporal(stops: List[StopCandidate], merge_gap_min: float
                         ) -> List[StopCandidate]:
    """Merge consecutive stops separated by a short gap and within ~250 m centroid distance."""
    if len(stops) <= 1:
        return stops
    out: List[StopCandidate] = [stops[0]]
    for nxt in stops[1:]:
        cur = out[-1]
        gap_min = (nxt.start_ts_ms - cur.end_ts_ms) / 60_000
        clat, clon = cur.centroid()
        nlat, nlon = nxt.centroid()
        dist_m = haversine_m(clat, clon, nlat, nlon)
        if gap_min <= merge_gap_min and dist_m <= SEMANTIC_MERGE_RADIUS_M:
            out[-1] = StopCandidate(samples=cur.samples + nxt.samples)
        else:
            out.append(nxt)
    return out

def merge_stops_semantic(stops: List[StopCandidate]) -> List[StopCandidate]:
    """Collapse consecutive stops that both fall on the same NAMED_LOCATION anchor.

    Deliberately conservative: only fires for named locations, not for nameless
    coords. Patches "Home -> short walk -> Home" being three rows when the two
    Home stops are clearly the same stay punctuated by sparse sampling.
    """
    if len(stops) <= 1:
        return stops
    out: List[StopCandidate] = [stops[0]]
    for nxt in stops[1:]:
        cur = out[-1]
        gap_min = (nxt.start_ts_ms - cur.end_ts_ms) / 60_000
        c_lat, c_lon = cur.centroid()
        n_lat, n_lon = nxt.centroid()
        c_named = match_named_location(c_lat, c_lon)
        n_named = match_named_location(n_lat, n_lon)
        same_named = c_named and n_named and c_named[0]["name"] == n_named[0]["name"]
        if same_named and gap_min <= SEMANTIC_MERGE_MAX_GAP_MIN:
            out[-1] = StopCandidate(samples=cur.samples + nxt.samples)
        else:
            out.append(nxt)
    return out

def expand_inferred_stops(stops: List[StopCandidate], samples: List[Sample],
                          window_start_ms: int, window_end_ms: int
                          ) -> List[StopCandidate]:
    """Inject inferred stops where a long inter-sample silence happens between
    two GPS samples that bracket the gap within a small radius — the textbook
    cafe / indoor case where the phone loses GPS for ≥20 min while the user
    sits still. The anchor-walk in detect_stops can't see these because there
    are no samples to anchor on.

    For each between-stop gap window, scan the contained samples for an
    inter-sample delta >= INFERRED_STOP_GAP_MIN where the bracketing samples
    are within INFERRED_STOP_BRACKET_RADIUS_M of each other. Inject a synthetic
    StopCandidate at the last pre-gap sample's coordinates, spanning the gap.
    Skip if too close to an already-existing adjacent stop (avoid dupes).
    """
    if not samples:
        return stops
    boundaries: List[Tuple[int, int, Optional[StopCandidate], Optional[StopCandidate]]] = []
    if not stops:
        boundaries.append((window_start_ms, window_end_ms, None, None))
    else:
        boundaries.append((window_start_ms, stops[0].start_ts_ms, None, stops[0]))
        for i, st in enumerate(stops):
            nxt = stops[i + 1] if i + 1 < len(stops) else None
            nxt_start = nxt.start_ts_ms if nxt else window_end_ms
            boundaries.append((st.end_ts_ms, nxt_start, st, nxt))

    inferred: List[StopCandidate] = []
    for a, b, prev_st, next_st in boundaries:
        if b - a < INFERRED_STOP_GAP_MIN * 60_000:
            continue
        seg = [s for s in samples if a <= s.ts_ms <= b]
        if len(seg) < 2:
            continue
        prev_centroid = prev_st.centroid() if prev_st else None
        next_centroid = next_st.centroid() if next_st else None
        for k in range(1, len(seg)):
            gap_min = (seg[k].ts_ms - seg[k - 1].ts_ms) / 60_000
            if gap_min < INFERRED_STOP_GAP_MIN:
                continue
            anchor = seg[k - 1]
            post = seg[k]
            # Skip if the anchor sample sits on top of an existing adjacent
            # stop — the long silence is just a quiet stretch at that stop,
            # not a separate venue.
            anchor_at_adjacent = False
            for adj_centroid in (prev_centroid, next_centroid):
                if adj_centroid is None:
                    continue
                if haversine_m(anchor.lat, anchor.lon, adj_centroid[0], adj_centroid[1]) <= INFERRED_STOP_NEAR_EXISTING_M:
                    anchor_at_adjacent = True
                    break
            if anchor_at_adjacent:
                continue
            # Two acceptance signals for a real dwell at the anchor location:
            #   (A) bracketing samples are close — classic indoor-stay case
            #       (sat down and didn't move; GPS came back roughly where it
            #       died).
            #   (B) the post-gap sample lands back at a known existing stop —
            #       user took a side trip to the anchor location and returned.
            bracket_close = haversine_m(anchor.lat, anchor.lon, post.lat, post.lon) <= INFERRED_STOP_BRACKET_RADIUS_M
            post_returned = (
                next_centroid is not None
                and haversine_m(post.lat, post.lon, next_centroid[0], next_centroid[1]) <= INFERRED_STOP_NEAR_EXISTING_M
                # ...AND the anchor is a plausible side trip from that base, not a
                # travel waypoint. A lone in-transit ping during a long drive
                # (GPS died en route) otherwise becomes a phantom stop named for
                # whatever venue its coordinates happen to land on.
                and haversine_m(anchor.lat, anchor.lon, next_centroid[0], next_centroid[1]) <= INFERRED_STOP_SIDE_TRIP_MAX_M
            )
            if not (bracket_close or post_returned):
                continue
            synthetic_start = Sample(ts_ms=anchor.ts_ms, lat=anchor.lat, lon=anchor.lon)
            synthetic_end = Sample(ts_ms=post.ts_ms, lat=anchor.lat, lon=anchor.lon)
            inferred.append(StopCandidate(samples=[synthetic_start, synthetic_end], inferred=True))

    if not inferred:
        return stops
    combined = sorted(list(stops) + inferred, key=lambda sc: sc.start_ts_ms)
    return combined

# ============================================================================
# Route segmentation + features
# ============================================================================

def slice_samples(samples: List[Sample], start_ts_ms: int, end_ts_ms: int) -> List[Sample]:
    return [s for s in samples if start_ts_ms < s.ts_ms < end_ts_ms]

def trim_route_boundary(samples: List[Sample],
                        prev_centroid: Optional[Tuple[float, float]],
                        next_centroid: Optional[Tuple[float, float]],
                        ) -> List[Sample]:
    """Drop leading/trailing samples within ROUTE_BOUNDARY_CLEANUP_M of a stop centroid."""
    out = list(samples)
    if prev_centroid:
        plat, plon = prev_centroid
        while out and haversine_m(plat, plon, out[0].lat, out[0].lon) <= ROUTE_BOUNDARY_CLEANUP_M:
            out.pop(0)
    if next_centroid:
        nlat, nlon = next_centroid
        while out and haversine_m(nlat, nlon, out[-1].lat, out[-1].lon) <= ROUTE_BOUNDARY_CLEANUP_M:
            out.pop()
    return out

def compute_segment_features(seg: List[Sample]) -> Dict[str, Any]:
    """Aggregate features for a route or leg sample list."""
    if len(seg) < 2:
        return {
            "p50_speed_kmh": 0.0, "p95_speed_kmh": 0.0,
            "straightness": 1.0, "bearing_changes_per_km": 0.0,
            "total_dist_km": 0.0, "geodesic_dist_km": 0.0,
            "max_gap_min": 0.0, "dominant_activity": None,
            "duration_min": 0.0,
        }
    distances_km: List[float] = []
    durations_h: List[float] = []
    speeds: List[float] = []
    bearings: List[float] = []
    durations_min: List[float] = []
    activities: Dict[str, int] = {}
    for a, b in zip(seg, seg[1:]):
        d_km = haversine_km(a.lat, a.lon, b.lat, b.lon)
        d_h = max((b.ts_ms - a.ts_ms) / 3_600_000, 1e-6)
        distances_km.append(d_km)
        durations_h.append(d_h)
        durations_min.append((b.ts_ms - a.ts_ms) / 60_000)
        if d_km > 0.005:  # filter near-zero noise
            speeds.append(d_km / d_h)
            bearings.append(bearing_deg(a.lat, a.lon, b.lat, b.lon))
        if a.activity:
            activities[a.activity] = activities.get(a.activity, 0) + 1
    if seg[-1].activity:
        activities[seg[-1].activity] = activities.get(seg[-1].activity, 0) + 1

    total_km = sum(distances_km)
    geo_km = haversine_km(seg[0].lat, seg[0].lon, seg[-1].lat, seg[-1].lon)
    straightness = (geo_km / total_km) if total_km > 1e-6 else 1.0

    bcr = 0.0
    if len(bearings) >= 2 and total_km > 1e-3:
        total_change = sum(angle_delta(a, b) for a, b in zip(bearings, bearings[1:]))
        bcr = total_change / (total_km * 360.0) * 360.0  # = total_change / total_km
        # interpretation: "degrees of bearing change per km" — divide by 90 to get
        # "right-angle-turns per km". A walk through Manhattan grid hits ~6-15.

    dominant = max(activities, key=lambda k: activities[k]) if activities else None
    return {
        "p50_speed_kmh": round(percentile(speeds, 50), 2),
        "p95_speed_kmh": round(percentile(speeds, 95), 2),
        "straightness": round(straightness, 3),
        "bearing_changes_per_km": round(bcr, 2),
        "total_dist_km": round(total_km, 3),
        "geodesic_dist_km": round(geo_km, 3),
        "max_gap_min": round(max(durations_min) if durations_min else 0.0, 2),
        "n_samples": len(seg),
        "dominant_activity": dominant,
        "duration_min": round(sum(durations_min), 2),
    }

# ============================================================================
# Mode classification (rule ladder)
# ============================================================================

def classify_mode(feat: Dict[str, Any], centroid_lat: float, centroid_lon: float
                  ) -> Tuple[str, float]:
    """Returns (mode, confidence)."""
    p50 = feat["p50_speed_kmh"]
    p95 = feat["p95_speed_kmh"]
    straight = feat["straightness"]
    bcr = feat["bearing_changes_per_km"]
    total = feat["total_dist_km"]
    activity = feat["dominant_activity"]

    if total < STATIONARY_NOISE_KM:
        return "stationary_noise", 0.7

    if p95 > 200:
        return "flew", 0.95
    if p95 > 80 and straight > 0.85:
        return "train", _conf_band(p95, 80, 200, 0.7, 0.95)
    if p95 > 25:
        # could be drove or train (low straightness urban train)
        if straight > 0.75 and total > 5:
            return "drove", _conf_band(p95, 25, 100, 0.6, 0.9)
        return "drove", _conf_band(p95, 25, 100, 0.55, 0.85)
    if 12 <= p95 <= 25:
        if activity == "cycling":
            return "cycled", 0.85
        # Two fixes bracketing one gap have a speed but no shape: 1.47 km in
        # 5.8 min between two streets is the subway as readily as a bike
        # (once narrated as "biked home"). A ride needs to have
        # been SEEN -- several fixes, none of them a long silence.
        if feat.get("n_samples", 0) < 4 or feat.get("max_gap_min", 0) >= 3:
            return "unknown", 0.4
        if straight < 0.7 and in_scooter_area(centroid_lat, centroid_lon):
            return "e_scooter_likely", 0.65
        return "cycled", 0.55
    if p50 >= 3 and p50 <= 7 and bcr > 200:  # bearing changes per km > 200° (~ several turns)
        mode_conf = 0.8
        if activity == "walking":
            mode_conf = min(0.95, mode_conf + 0.1)
        return "walked", mode_conf
    if total < 0.5 and p50 < 2:
        return "walked", 0.7

    # CoreMotion fallback
    if activity == "walking":
        return "walked", 0.65
    if activity == "running":
        return "ran", 0.7
    if activity == "cycling":
        return "cycled", 0.7
    if activity == "driving":
        return "drove", 0.6
    return "unknown", 0.4

def _conf_band(value: float, lo: float, hi: float, conf_lo: float, conf_hi: float) -> float:
    if value <= lo:
        return conf_lo
    if value >= hi:
        return conf_hi
    return conf_lo + (conf_hi - conf_lo) * (value - lo) / (hi - lo)

# ============================================================================
# Multi-leg splitting (v2)
# ============================================================================

def _instantaneous_mode(window_samples: List[Sample], centroid_lat: float, centroid_lon: float
                        ) -> str:
    """Classify a small rolling window of samples into a coarse mode."""
    feat = compute_segment_features(window_samples)
    mode, _ = classify_mode(feat, centroid_lat, centroid_lon)
    # Collapse minor variants for boundary detection.
    if mode in ("ran", "walked"):
        return "walked"
    if mode in ("drove", "train", "flew"):
        return "vehicle"
    if mode in ("cycled", "e_scooter_likely"):
        return "wheels"
    if mode == "stationary_noise":
        return "stationary"
    return "unknown"

def split_into_legs(samples: List[Sample], window: int = 5, min_leg_samples: int = 4,
                    max_legs: int = 4) -> List[List[Sample]]:
    """Split a route into legs based on rolling-window mode change-points.

    For each sample, classify a centered window of `window` samples; emit a new
    leg whenever the mode flips. Smooth tiny flips (<min_leg_samples) by merging
    them back into the surrounding leg. Hard cap at max_legs to avoid noise
    runaway.
    """
    n = len(samples)
    if n < window * 2:
        return [samples]

    clat = sum(s.lat for s in samples) / n
    clon = sum(s.lon for s in samples) / n
    half = window // 2
    labels: List[str] = []
    for i in range(n):
        lo = max(0, i - half)
        hi = min(n, i + half + 1)
        labels.append(_instantaneous_mode(samples[lo:hi], clat, clon))

    # Build runs of identical labels.
    runs: List[Tuple[str, int, int]] = []  # (label, start_idx, end_idx_exclusive)
    cur_label = labels[0]
    run_start = 0
    for i in range(1, n):
        if labels[i] != cur_label:
            runs.append((cur_label, run_start, i))
            cur_label = labels[i]
            run_start = i
    runs.append((cur_label, run_start, n))

    # Smooth: merge runs shorter than min_leg_samples into the previous run.
    smoothed: List[Tuple[str, int, int]] = []
    for run in runs:
        label, lo, hi = run
        size = hi - lo
        if smoothed and size < min_leg_samples:
            prev = smoothed[-1]
            smoothed[-1] = (prev[0], prev[1], hi)
        else:
            if smoothed and smoothed[-1][0] == label:
                prev = smoothed[-1]
                smoothed[-1] = (prev[0], prev[1], hi)
            else:
                smoothed.append((label, lo, hi))

    # Cap leg count: if too many, keep the longest legs and absorb shorter ones into neighbors.
    while len(smoothed) > max_legs:
        # find shortest run, fold into smaller-of-its-neighbors
        idx = min(range(len(smoothed)), key=lambda k: smoothed[k][2] - smoothed[k][1])
        lo, hi = smoothed[idx][1], smoothed[idx][2]
        if idx == 0:
            nxt = smoothed[1]
            smoothed[1] = (nxt[0], lo, nxt[2])
            smoothed.pop(0)
        elif idx == len(smoothed) - 1:
            prv = smoothed[idx - 1]
            smoothed[idx - 1] = (prv[0], prv[1], hi)
            smoothed.pop(idx)
        else:
            prv = smoothed[idx - 1]
            nxt = smoothed[idx + 1]
            if (prv[2] - prv[1]) <= (nxt[2] - nxt[1]):
                smoothed[idx - 1] = (prv[0], prv[1], hi)
            else:
                smoothed[idx + 1] = (nxt[0], lo, nxt[2])
            smoothed.pop(idx)

    return [samples[lo:hi] for _, lo, hi in smoothed]

# ============================================================================
# Polyline simplification + snap
# ============================================================================

def _perpendicular_distance_m(lat: float, lon: float,
                              lat1: float, lon1: float,
                              lat2: float, lon2: float) -> float:
    """Approximate perpendicular distance from point to segment in meters,
    using equirectangular projection (good enough for ~1km segments)."""
    if lat1 == lat2 and lon1 == lon2:
        return haversine_m(lat, lon, lat1, lon1)
    mlat = math.radians((lat1 + lat2) / 2.0)
    x = (lon - lon1) * math.cos(mlat)
    y = (lat - lat1)
    x1 = (lon2 - lon1) * math.cos(mlat)
    y1 = (lat2 - lat1)
    t = max(0.0, min(1.0, (x * x1 + y * y1) / (x1 * x1 + y1 * y1 + 1e-12)))
    px = lon1 + t * (lon2 - lon1)
    py = lat1 + t * (lat2 - lat1)
    return haversine_m(lat, lon, py, px)

def douglas_peucker(points: List[Tuple[float, float]], epsilon_m: float
                    ) -> List[Tuple[float, float]]:
    if len(points) < 3:
        return list(points)
    # iterative DP to avoid recursion limits on long tracks
    keep = [False] * len(points)
    keep[0] = keep[-1] = True
    stack: List[Tuple[int, int]] = [(0, len(points) - 1)]
    while stack:
        lo, hi = stack.pop()
        if hi <= lo + 1:
            continue
        max_d = 0.0
        max_i = lo
        a = points[lo]
        b = points[hi]
        for i in range(lo + 1, hi):
            d = _perpendicular_distance_m(points[i][0], points[i][1], a[0], a[1], b[0], b[1])
            if d > max_d:
                max_d = d
                max_i = i
        if max_d > epsilon_m:
            keep[max_i] = True
            stack.append((lo, max_i))
            stack.append((max_i, hi))
    return [p for p, k in zip(points, keep) if k]

def downsample_polyline(samples: List[Sample]) -> List[List[float]]:
    if not samples:
        return []
    pts = [(s.lat, s.lon) for s in samples]
    simplified = douglas_peucker(pts, POLYLINE_EPSILON_M)
    if len(simplified) > POLYLINE_MAX_POINTS:
        # uniform-stride decimation as a final cap
        stride = math.ceil(len(simplified) / POLYLINE_MAX_POINTS)
        simplified = simplified[::stride]
        if simplified[-1] != pts[-1]:
            simplified.append(pts[-1])
    return [[round(la, 6), round(lo, 6)] for la, lo in simplified]

def _valhalla_costing(mode: str) -> str:
    if mode in ("walked", "ran"):
        return "pedestrian"
    if mode in ("cycled", "e_scooter_likely"):
        return "bicycle"
    if mode in ("drove", "train", "flew", "unknown"):
        return "auto"
    return "auto"

def snap_via_valhalla(samples: List[Sample], mode: str) -> Optional[List[List[float]]]:
    if not samples:
        return None
    os.makedirs(SNAP_CACHE_DIR, exist_ok=True)
    cache_key = f"{samples[0].ts_ms}-{samples[-1].ts_ms}-{mode}.json"
    cache_path = os.path.join(SNAP_CACHE_DIR, cache_key)
    if os.path.exists(cache_path):
        try:
            with open(cache_path) as f:
                return json.load(f)
        except Exception:
            pass

    body = json.dumps({
        "shape": [{"lat": s.lat, "lon": s.lon, "time": s.ts_ms // 1000} for s in samples],
        "shape_match": "map_snap",
        "costing": _valhalla_costing(mode),
        "format": "osrm",
    }).encode("utf-8")
    try:
        req = urllib.request.Request(
            "https://valhalla1.openstreetmap.de/trace_attributes",
            data=body, method="POST",
            headers={"Content-Type": "application/json", "User-Agent": "location-segment/1.0"},
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read())
    except Exception as e:
        print(f"[location-segment] valhalla snap error: {e}", file=sys.stderr)
        return None

    edges = data.get("edges") or []
    points: List[List[float]] = []
    for e in edges:
        shape = e.get("shape")
        if isinstance(shape, list):
            points.extend([[round(p[0], 6), round(p[1], 6)] for p in shape])
    if not points:
        return None
    try:
        with open(cache_path, "w") as f:
            json.dump(points, f)
    except Exception:
        pass
    return points

# ============================================================================
# Waypoints
# ============================================================================

def waypoints_for_route(samples: List[Sample], leg_boundaries: List[int],
                        photos: List[Dict[str, Any]],
                        transit: List[Dict[str, Any]],
                        no_photos: bool) -> List[Waypoint]:
    out: List[Waypoint] = []

    # mode-change waypoints (skip first/last; they are stop boundaries)
    for idx in leg_boundaries[1:-1]:
        s = samples[idx]
        out.append(Waypoint(ts_ms=s.ts_ms, lat=s.lat, lon=s.lon,
                            kind="mode_change", label="leg boundary"))

    # photo waypoints
    if not no_photos and photos and samples:
        win_start = samples[0].ts_ms
        win_end = samples[-1].ts_ms
        relevant = [p for p in photos if win_start <= p["ts_ms"] <= win_end]
        # cluster by 5-min window
        clusters: List[List[Dict[str, Any]]] = []
        for p in sorted(relevant, key=lambda x: x["ts_ms"]):
            if clusters and (p["ts_ms"] - clusters[-1][-1]["ts_ms"]) <= 5 * 60_000:
                clusters[-1].append(p)
            else:
                clusters.append([p])
        for cl in clusters:
            # require proximity to route polyline
            if not any(haversine_m(p["lat"], p["lon"], s.lat, s.lon) <= 50
                       for p in cl for s in samples):
                continue
            mid = cl[len(cl) // 2]
            label = f"{len(cl)} photo{'s' if len(cl) != 1 else ''}"
            out.append(Waypoint(ts_ms=mid["ts_ms"], lat=mid["lat"], lon=mid["lon"],
                                kind="photo", label=label))

    # transit station passthroughs
    for stn in transit:
        radius = stn.get("radius_m", 80)
        match = next(
            (s for s in samples
             if haversine_m(s.lat, s.lon, stn["lat"], stn["lon"]) <= radius),
            None,
        )
        if match:
            out.append(Waypoint(
                ts_ms=match.ts_ms, lat=match.lat, lon=match.lon,
                kind="transit", label=stn["name"],
            ))

    out.sort(key=lambda w: w.ts_ms)
    # dedupe waypoints within 100 m
    deduped: List[Waypoint] = []
    for w in out:
        if any(haversine_m(w.lat, w.lon, d.lat, d.lon) <= 100 and w.kind == d.kind
               for d in deduped):
            continue
        deduped.append(w)
    return deduped[:10]

# ============================================================================
# Audio context (v2 — best-effort)
# ============================================================================

def attach_audio_context(stop: Stop) -> None:
    """If the latest phone_context snapshot's ts falls inside (or within
    AUDIO_CONTEXT_FRESHNESS_MIN of) this stop's window, attach the audio
    snapshot. Single-row-per-device upsert table means this is only useful
    for the most recent stop — older stops get None."""
    ctx = fetch_phone_context_latest()
    if not ctx:
        return
    audio_class = ctx.get("audio_class")
    if not audio_class:
        return
    ts_str = ctx.get("ts")
    if not ts_str:
        return
    ctx_ts = parse_iso_to_ms(ts_str)
    window_lo = stop.start_ts_ms - AUDIO_CONTEXT_FRESHNESS_MIN * 60_000
    window_hi = stop.end_ts_ms + AUDIO_CONTEXT_FRESHNESS_MIN * 60_000
    if not (window_lo <= ctx_ts <= window_hi):
        return
    age_min = abs((ctx_ts - (stop.start_ts_ms + stop.end_ts_ms) // 2)) / 60_000
    stop.audio_context = {
        "audio_class": audio_class,
        "audio_confidence": ctx.get("audio_confidence"),
        "ambient_db_bucket": ctx.get("ambient_db_bucket"),
        "snapshot_ts": ts_str,
        "age_min": round(age_min, 2),
    }

# ============================================================================
# Photo-to-stop matching (annotate stops with on-site photos)
# ============================================================================

PHOTO_STOP_WINDOW_BUFFER_MS = 5 * 60 * 1000

def attach_photos_to_stop(stop: Stop, photos: List[Dict[str, Any]]) -> None:
    # +/-5min buffer around the stop window (mirrors resolve-day.js's
    # attachPhotosToStop, which added the buffer for the orphan-visit path but
    # never got backported here): a photo snapped while arriving at or leaving
    # a stop routinely lands a few seconds to a few minutes outside the strict
    # detected window and was silently dropped with no buffer at all. Confirmed
    # 2026-09-13: a photo 37s before the Bellevue Hospital stop's start_ts_ms
    # missed the strict bound and fell into the day's unmatched-photo bucket.
    matches: List[Dict[str, Any]] = []
    for p in photos:
        if not (stop.start_ts_ms - PHOTO_STOP_WINDOW_BUFFER_MS
                <= p["ts_ms"]
                <= stop.end_ts_ms + PHOTO_STOP_WINDOW_BUFFER_MS):
            continue
        if haversine_m(stop.centroid_lat, stop.centroid_lon, p["lat"], p["lon"]) > 200:
            continue
        matches.append({
            "uuid": p.get("uuid"),
            "ts": ms_to_iso(p["ts_ms"]),
            "filename": p.get("filename"),
        })
    stop.photos = matches

# ============================================================================
# Pipeline
# ============================================================================

@dataclass
class Options:
    min_stop_min: float
    stop_radius_m: float
    merge_gap_min: float
    snap: str  # "valhalla" or "none"
    no_places: bool
    no_overpass: bool
    no_photos: bool
    no_audio: bool
    debug: bool
    saved_places: bool = False  # live ask only; resolve-day names from saved places itself

def build_timeline(samples: List[Sample], window_start_ms: int, window_end_ms: int,
                   opts: Options) -> Dict[str, Any]:
    samples = sorted(samples, key=lambda s: s.ts_ms)
    stops_raw = detect_stops(samples, opts.min_stop_min, opts.stop_radius_m)
    stops_raw = merge_stops_temporal(stops_raw, opts.merge_gap_min)
    stops_raw = merge_stops_semantic(stops_raw)
    stops_raw = expand_inferred_stops(stops_raw, samples, window_start_ms, window_end_ms)

    recurring = load_known_recurring_stops()
    wifi_entries = load_wifi_map()
    confirmed = load_confirmed_stops()
    transit = load_transit_stations()
    photos = [] if opts.no_photos else fetch_photos(window_start_ms, window_end_ms)

    # ---- resolve places
    stops: List[Stop] = []
    for i, sc in enumerate(stops_raw, start=1):
        primary, alts = resolve_place(sc, opts, recurring, wifi_entries, confirmed)
        clat, clon = sc.centroid()
        stop = Stop(
            id=f"stop-{i}",
            start_ts_ms=sc.start_ts_ms,
            end_ts_ms=sc.end_ts_ms,
            centroid_lat=round(clat, 6),
            centroid_lon=round(clon, 6),
            cluster_radius_m=round(sc.cluster_radius_m(), 1),
            sample_count=len(sc.samples),
            primary=primary,
            alternatives=alts,
            inferred=sc.inferred,
        )
        if opts.debug:
            stop.debug = {
                "first_sample_ts": ms_to_iso(sc.samples[0].ts_ms),
                "last_sample_ts": ms_to_iso(sc.samples[-1].ts_ms),
            }
        if not opts.no_audio:
            attach_audio_context(stop)
        if not opts.no_photos:
            attach_photos_to_stop(stop, photos)
        stops.append(stop)

    # ---- routes + gaps
    routes: List[Route] = []
    gaps: List[Gap] = []
    boundaries: List[Tuple[int, int]] = []  # (segment_start_ts, segment_end_ts)
    boundaries.append((window_start_ms, stops[0].start_ts_ms if stops else window_end_ms))
    for i, st in enumerate(stops):
        nxt_start = stops[i + 1].start_ts_ms if i + 1 < len(stops) else window_end_ms
        boundaries.append((st.end_ts_ms, nxt_start))

    route_idx = 1
    for b_idx, (a, b) in enumerate(boundaries):
        if b - a < 60_000:  # < 1 minute, skip
            continue
        seg_samples = slice_samples(samples, a, b)
        prev_centroid = (stops[b_idx - 1].centroid_lat, stops[b_idx - 1].centroid_lon) if b_idx > 0 else None
        next_centroid = (stops[b_idx].centroid_lat, stops[b_idx].centroid_lon) if b_idx < len(stops) else None
        seg_samples = trim_route_boundary(seg_samples, prev_centroid, next_centroid)

        # gap if no samples and the interval is meaningful
        if len(seg_samples) < 2:
            duration_min = (b - a) / 60_000
            if duration_min >= MIN_GAP_MIN:
                gaps.append(Gap(start_ts_ms=a, end_ts_ms=b, reason="no_gps_samples"))
            continue

        # split into legs (v2)
        leg_chunks = split_into_legs(seg_samples)
        legs: List[Leg] = []
        leg_boundaries: List[int] = [0]
        cursor = 0
        for chunk in leg_chunks:
            if len(chunk) < 2:
                cursor += len(chunk)
                continue
            feat = compute_segment_features(chunk)
            clat = sum(s.lat for s in chunk) / len(chunk)
            clon = sum(s.lon for s in chunk) / len(chunk)
            mode, conf = classify_mode(feat, clat, clon)
            legs.append(Leg(
                start_ts_ms=chunk[0].ts_ms,
                end_ts_ms=chunk[-1].ts_ms,
                distance_km=round(feat["total_dist_km"], 3),
                mode=mode,
                mode_confidence=round(conf, 2),
                mode_features=feat,
                sample_count=len(chunk),
            ))
            cursor += len(chunk)
            leg_boundaries.append(cursor)

        # if everything reduced to zero or one leg, recompute on whole route
        if not legs:
            feat = compute_segment_features(seg_samples)
            clat = sum(s.lat for s in seg_samples) / len(seg_samples)
            clon = sum(s.lon for s in seg_samples) / len(seg_samples)
            mode, conf = classify_mode(feat, clat, clon)
            legs.append(Leg(
                start_ts_ms=seg_samples[0].ts_ms,
                end_ts_ms=seg_samples[-1].ts_ms,
                distance_km=round(feat["total_dist_km"], 3),
                mode=mode,
                mode_confidence=round(conf, 2),
                mode_features=feat,
                sample_count=len(seg_samples),
            ))
            leg_boundaries = [0, len(seg_samples)]

        # polyline
        polyline_source = "raw_downsampled"
        polyline: List[List[float]] = []
        if opts.snap == "valhalla":
            dominant_mode = max(legs, key=lambda lg: lg.distance_km).mode
            snapped = snap_via_valhalla(seg_samples, dominant_mode)
            if snapped:
                polyline = snapped
                polyline_source = "valhalla"
        if not polyline:
            polyline = downsample_polyline(seg_samples)

        from_stop_id = stops[b_idx - 1].id if b_idx > 0 else None
        to_stop_id = stops[b_idx].id if b_idx < len(stops) else None
        total_km = sum(lg.distance_km for lg in legs)

        # waypoints
        wps = waypoints_for_route(seg_samples, leg_boundaries, photos, transit, opts.no_photos)

        routes.append(Route(
            id=f"route-{route_idx}",
            from_stop_id=from_stop_id,
            to_stop_id=to_stop_id,
            start_ts_ms=seg_samples[0].ts_ms,
            end_ts_ms=seg_samples[-1].ts_ms,
            distance_km=round(total_km, 3),
            legs=legs,
            polyline=polyline,
            polyline_source=polyline_source,
            waypoints=wps,
        ))
        route_idx += 1

    # ---- collapse short stationary-noise routes into the adjacent stop.
    # Yesterday's route-2 (15:47–15:52, 0.09 km between two stops) is GPS jitter,
    # not a real movement; emitting it as a route both clutters the output and
    # wastes a route id. We extend the adjacent stop's window to cover the noise
    # interval so the (stops + routes + gaps) timeline stays gap-free.
    stops_by_id = {s.id: s for s in stops}
    kept_routes: List[Route] = []
    for r in routes:
        is_short_noise = (
            len(r.legs) == 1
            and r.legs[0].mode == "stationary_noise"
            and r.distance_km < STATIONARY_NOISE_KM
            and (r.end_ts_ms - r.start_ts_ms) / 60_000 < NOISE_ROUTE_MAX_MIN
        )
        if not is_short_noise:
            kept_routes.append(r)
            continue
        target = stops_by_id.get(r.from_stop_id) or stops_by_id.get(r.to_stop_id)
        if target is None:
            kept_routes.append(r)  # no adjacent stop to absorb into; keep as-is
            continue
        if target.id == r.from_stop_id:
            target.end_ts_ms = max(target.end_ts_ms, r.end_ts_ms)
        else:
            target.start_ts_ms = min(target.start_ts_ms, r.start_ts_ms)
    # Renumber surviving routes.
    for i, r in enumerate(kept_routes, start=1):
        r.id = f"route-{i}"
    routes = kept_routes

    # ---- classify each stop as `dwell` or `browse` based on m/min drift ratio.
    for s in stops:
        duration_min = max((s.end_ts_ms - s.start_ts_ms) / 60_000, 1.0)
        ratio = s.cluster_radius_m / duration_min
        s.pattern = "browse" if ratio > BROWSE_PATTERN_RATIO_M_PER_MIN else "dwell"

    return _serialize_timeline(window_start_ms, window_end_ms, stops, routes, gaps)

# ============================================================================
# Serialization
# ============================================================================

def _candidate_to_dict(c: PlaceCandidate) -> Dict[str, Any]:
    out: Dict[str, Any] = {
        "name": c.name,
        "address": c.address,
        "source": c.source,
        "confidence": round(c.confidence, 2),
    }
    if c.distance_m is not None:
        out["distance_m"] = round(c.distance_m, 1)
    if c.place_id:
        out["place_id"] = c.place_id
    if c.primary_type:
        out["primary_type"] = c.primary_type
    if c.name_native:
        out["name_native"] = c.name_native
    return out

def _stop_to_dict(s: Stop) -> Dict[str, Any]:
    out = {
        "id": s.id,
        "start": ms_to_iso(s.start_ts_ms),
        "end": ms_to_iso(s.end_ts_ms),
        "duration_min": round((s.end_ts_ms - s.start_ts_ms) / 60_000, 1),
        "place": _candidate_to_dict(s.primary),
        "alternatives": [_candidate_to_dict(a) for a in s.alternatives],
        "centroid": {"lat": s.centroid_lat, "lon": s.centroid_lon},
        "cluster_radius_m": s.cluster_radius_m,
        "sample_count": s.sample_count,
        "pattern": s.pattern,
        "audio_context": s.audio_context,
        "photos": s.photos,
    }
    if s.inferred:
        out["inferred"] = True
    if s.debug is not None:
        out["debug"] = s.debug
    return out

def _leg_to_dict(lg: Leg) -> Dict[str, Any]:
    return {
        "start": ms_to_iso(lg.start_ts_ms),
        "end": ms_to_iso(lg.end_ts_ms),
        "duration_min": round((lg.end_ts_ms - lg.start_ts_ms) / 60_000, 1),
        "distance_km": lg.distance_km,
        "mode": lg.mode,
        "mode_confidence": lg.mode_confidence,
        "mode_features": lg.mode_features,
        "sample_count": lg.sample_count,
    }

def _route_to_dict(r: Route) -> Dict[str, Any]:
    return {
        "id": r.id,
        "from_stop_id": r.from_stop_id,
        "to_stop_id": r.to_stop_id,
        "start": ms_to_iso(r.start_ts_ms),
        "end": ms_to_iso(r.end_ts_ms),
        "duration_min": round((r.end_ts_ms - r.start_ts_ms) / 60_000, 1),
        "distance_km": r.distance_km,
        "legs": [_leg_to_dict(lg) for lg in r.legs],
        "polyline": r.polyline,
        "polyline_source": r.polyline_source,
        "waypoints": [
            {
                "ts": ms_to_iso(w.ts_ms),
                "lat": round(w.lat, 6),
                "lon": round(w.lon, 6),
                "kind": w.kind,
                "label": w.label,
            }
            for w in r.waypoints
        ],
    }

def _gap_to_dict(g: Gap) -> Dict[str, Any]:
    return {
        "start": ms_to_iso(g.start_ts_ms),
        "end": ms_to_iso(g.end_ts_ms),
        "duration_min": round((g.end_ts_ms - g.start_ts_ms) / 60_000, 1),
        "reason": g.reason,
    }

def _serialize_timeline(window_start_ms: int, window_end_ms: int,
                        stops: List[Stop], routes: List[Route], gaps: List[Gap]
                        ) -> Dict[str, Any]:
    modes = sorted({lg.mode for r in routes for lg in r.legs})
    return {
        "window": {
            "start": ms_to_iso(window_start_ms),
            "end": ms_to_iso(window_end_ms),
        },
        "summary": {
            "stop_count": len(stops),
            "route_count": len(routes),
            "gap_count": len(gaps),
            "total_distance_km": round(sum(r.distance_km for r in routes), 2),
            "modes_seen": modes,
        },
        "stops": [_stop_to_dict(s) for s in stops],
        "routes": [_route_to_dict(r) for r in routes],
        "gaps": [_gap_to_dict(g) for g in gaps],
    }

# ============================================================================
# Input loading (Supabase or file)
# ============================================================================

def load_samples_from_file(path: str) -> List[Sample]:
    with open(path) as f:
        data = json.load(f)
    rows = data if isinstance(data, list) else data.get("samples", [])
    out: List[Sample] = []
    for r in rows:
        ts = r.get("ts_ms")
        if ts is None and r.get("ts"):
            ts = parse_iso_to_ms(r["ts"])
        if ts is None and r.get("arrived_at"):
            ts = parse_iso_to_ms(r["arrived_at"])
        if ts is None:
            continue
        if r.get("latitude") is not None:
            lat, lon = float(r["latitude"]), float(r["longitude"])
        else:
            lat, lon = float(r["lat"]), float(r["lon"])
        out.append(Sample(
            ts_ms=int(ts), lat=lat, lon=lon,
            accuracy_m=r.get("accuracy_m"),
            activity=r.get("activity"),
        ))
    return sorted(out, key=lambda s: s.ts_ms)

# ============================================================================
# CLI
# ============================================================================

def parse_args(argv: List[str]) -> Tuple[argparse.Namespace, Options]:
    p = argparse.ArgumentParser(prog="location-segment", add_help=True,
                                description="Gap-free GPS timeline builder.")
    p.add_argument("period", nargs="?",
                   help="today | yesterday | YYYY-MM-DD (use --start/--end for explicit window)")
    p.add_argument("--start")
    p.add_argument("--end")
    p.add_argument("--input", help="read samples from JSON file (default: Supabase)")
    p.add_argument("--output", help="write JSON to file (default: stdout)")
    p.add_argument("--json", action="store_true", help="JSON to stdout (default)")
    p.add_argument("--min-stop-min", type=float, default=DEFAULT_MIN_STOP_MIN)
    p.add_argument("--stop-radius-m", type=float, default=DEFAULT_STOP_RADIUS_M)
    p.add_argument("--merge-gap-min", type=float, default=DEFAULT_MERGE_GAP_MIN)
    p.add_argument("--snap", choices=("valhalla", "none"), default="none")
    p.add_argument("--no-places", action="store_true",
                   help="skip Google Places (rating/review enrichment + fallback)")
    p.add_argument("--no-overpass", action="store_true",
                   help="skip OSM Overpass (primary venue lookup)")
    p.add_argument("--no-photos", action="store_true")
    p.add_argument("--no-audio", action="store_true")
    p.add_argument("--debug", action="store_true")
    args = p.parse_args(argv)
    opts = Options(
        min_stop_min=args.min_stop_min,
        stop_radius_m=args.stop_radius_m,
        merge_gap_min=args.merge_gap_min,
        snap=args.snap,
        no_places=args.no_places,
        no_overpass=args.no_overpass,
        no_photos=args.no_photos,
        no_audio=args.no_audio,
        debug=args.debug,
    )
    return args, opts

def cmd_resolve_point(argv: List[str]) -> int:
    """resolve-point <lat> <lon> [--at <iso>] — name a single point via the full
    resolve_place ladder. Returns JSON {name, source, confidence, address,
    primary_type, distance_m, neighborhood, alternatives}. `neighborhood` is
    ALWAYS populated (separate Nominatim call) so the caller can apply the
    confidence gate: use `name` when confidence is high, else fall back to
    `neighborhood`. Reuses every existing resolver — no new geocoding."""
    p = argparse.ArgumentParser(prog="location-segment resolve-point")
    p.add_argument("lat", type=float)
    p.add_argument("lon", type=float)
    p.add_argument("--at", help="ISO timestamp (for time-of-day boosting / wifi window)")
    p.add_argument("--no-places", action="store_true")
    p.add_argument("--no-overpass", action="store_true")
    a = p.parse_args(argv)
    os.environ.pop("JORI_PLACE_NAMES_MODEL", None)  # resolve-day allows 30 s: remembered English names only

    if a.at:
        try:
            t = int(datetime.fromisoformat(a.at.replace("Z", "+00:00")).timestamp() * 1000)
        except Exception:
            t = int(time.time() * 1000)
    else:
        t = int(time.time() * 1000)

    opts = Options(
        min_stop_min=DEFAULT_MIN_STOP_MIN, stop_radius_m=DEFAULT_STOP_RADIUS_M,
        merge_gap_min=DEFAULT_MERGE_GAP_MIN, snap="none",
        no_places=a.no_places, no_overpass=a.no_overpass,
        no_photos=True, no_audio=True, debug=False,
    )
    # Minimal stop: two samples at the point spanning a 10-min dwell so the
    # time-of-day + wifi tiers behave.
    sc = StopCandidate(samples=[Sample(ts_ms=t, lat=a.lat, lon=a.lon),
                                Sample(ts_ms=t + 600_000, lat=a.lat, lon=a.lon)])
    recurring = load_known_recurring_stops()
    wifi_entries = load_wifi_map()
    confirmed = load_confirmed_stops()
    primary, alts = resolve_place(sc, opts, recurring, wifi_entries, confirmed)
    out = {
        "name": primary.name,
        "source": primary.source,
        "confidence": primary.confidence,
        "address": primary.address,
        "primary_type": primary.primary_type,
        "distance_m": primary.distance_m,
        "neighborhood": nominatim_neighborhood(a.lat, a.lon),
        "alternatives": [
            {"name": x.name, "source": x.source, "confidence": x.confidence}
            for x in (alts or [])[:4]
        ],
    }
    print(json.dumps(out, ensure_ascii=False))
    return 0

def main(argv: Optional[List[str]] = None) -> int:
    raw = argv if argv is not None else sys.argv[1:]
    if raw and raw[0] == "resolve-point":
        return cmd_resolve_point(raw[1:])
    args, opts = parse_args(raw)

    if args.input:
        # When reading from a file, derive window from samples unless --start/--end given.
        samples = load_samples_from_file(args.input)
        if args.start and args.end:
            ws, we = parse_period(None, args.start, args.end)
        else:
            if not samples:
                sys.exit("ERROR: input file has no samples and no --start/--end given.")
            ws = samples[0].ts_ms
            we = samples[-1].ts_ms
    else:
        ws, we = parse_period(args.period, args.start, args.end)
        samples = fetch_samples(ws, we)

    timeline = build_timeline(samples, ws, we, opts)

    payload = json.dumps(timeline, indent=2, ensure_ascii=False)
    if args.output:
        with open(args.output, "w") as f:
            f.write(payload)
            f.write("\n")
    else:
        print(payload)

    s = timeline["summary"]
    dur_h = (we - ws) / 3_600_000
    print(
        f"{s['stop_count']} stops · {s['route_count']} routes · "
        f"{s['gap_count']} gaps · {s['total_distance_km']} km · {dur_h:.1f}h window",
        file=sys.stderr,
    )
    return 0

if __name__ == "__main__":
    sys.exit(main())
