# ============================================================================
# Dataclasses
# ============================================================================

@dataclass
class Sample:
    ts_ms: int
    lat: float
    lon: float
    accuracy_m: Optional[float] = None
    activity: Optional[str] = None  # CoreMotion: walking/driving/cycling/running/...

@dataclass
class PlaceCandidate:
    name: str
    address: Optional[str]
    source: str  # named_location / known_recurring / wifi_ssid / google_places / reverse_geocode / coordinate
    confidence: float
    distance_m: Optional[float] = None
    place_id: Optional[str] = None
    primary_type: Optional[str] = None
    name_native: Optional[str] = None  # the map's own label when `name` is its English

@dataclass
class StopCandidate:
    samples: List[Sample]
    inferred: bool = False  # True for stops synthesized from a long inter-sample silence

    @property
    def start_ts_ms(self) -> int: return self.samples[0].ts_ms
    @property
    def end_ts_ms(self) -> int: return self.samples[-1].ts_ms
    @property
    def duration_min(self) -> float:
        return (self.end_ts_ms - self.start_ts_ms) / 60_000

    def centroid(self) -> Tuple[float, float]:
        n = len(self.samples)
        return (sum(s.lat for s in self.samples) / n,
                sum(s.lon for s in self.samples) / n)

    def cluster_radius_m(self) -> float:
        clat, clon = self.centroid()
        return max((haversine_m(clat, clon, s.lat, s.lon) for s in self.samples), default=0.0)

@dataclass
class Stop:
    id: str
    start_ts_ms: int
    end_ts_ms: int
    centroid_lat: float
    centroid_lon: float
    cluster_radius_m: float
    sample_count: int
    primary: PlaceCandidate
    alternatives: List[PlaceCandidate] = field(default_factory=list)
    wifi_ssid: Optional[str] = None
    audio_context: Optional[Dict[str, Any]] = None  # {audio_class, confidence, age_min}
    photos: List[Dict[str, Any]] = field(default_factory=list)
    pattern: str = "dwell"  # "dwell" | "browse" — browse = wandering, not real venue stop
    inferred: bool = False  # True if synthesized from a long inter-sample GPS silence (cafes/indoors)
    debug: Optional[Dict[str, Any]] = None

@dataclass
class Waypoint:
    ts_ms: int
    lat: float
    lon: float
    kind: str  # photo / transit / mode_change
    label: str

@dataclass
class Leg:
    start_ts_ms: int
    end_ts_ms: int
    distance_km: float
    mode: str
    mode_confidence: float
    mode_features: Dict[str, Any]
    sample_count: int

@dataclass
class Route:
    id: str
    from_stop_id: Optional[str]  # None for leading route (window-start to first stop)
    to_stop_id: Optional[str]    # None for trailing route (last stop to window-end)
    start_ts_ms: int
    end_ts_ms: int
    distance_km: float
    legs: List[Leg]
    polyline: List[List[float]]  # [[lat, lon], ...]
    polyline_source: str         # raw_downsampled / valhalla
    waypoints: List[Waypoint] = field(default_factory=list)

@dataclass
class Gap:
    start_ts_ms: int
    end_ts_ms: int
    reason: str  # no_gps_samples / between_stop_and_window_edge

# ============================================================================
# Env / secrets
# ============================================================================

_env_cache: Optional[Dict[str, str]] = None

def _load_env() -> Dict[str, str]:
    global _env_cache
    if _env_cache is not None:
        return _env_cache
    out: Dict[str, str] = {}
    if os.path.exists(ENV_FILE):
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip()
    _env_cache = out
    return out

def get_supabase_key() -> Optional[str]:
    env = _load_env()
    return env.get("SUPABASE_SERVICE_ROLE_KEY") or os.environ.get("SUPABASE_SERVICE_ROLE_KEY")

_places_key_cache: Optional[str] = None

def _log_secret_failure(secret_name: str, reason: str) -> None:
    # Append-only JSONL, daily-deduped per (script, secret). Never raises.
    try:
        from datetime import datetime, timezone
        log_path = os.path.join(DATA_DIR, "secret-failures.jsonl")
        now = datetime.now(timezone.utc)
        today = now.strftime("%Y-%m-%d")
        if os.path.exists(log_path):
            with open(log_path) as f:
                for line in f.readlines()[-50:]:
                    try:
                        r = json.loads(line)
                        if (r.get("script") == "location-segment"
                            and r.get("secret") == secret_name
                            and r.get("ts", "").startswith(today)):
                            return
                    except Exception:
                        continue
        record = {
            "ts": now.isoformat(timespec="seconds").replace("+00:00", "Z"),
            "script": "location-segment",
            "secret": secret_name,
            "reason": reason,
        }
        with open(log_path, "a") as f:
            f.write(json.dumps(record) + "\n")
    except Exception:
        pass

try:
    from places_log import log_call as _places_log, timed as _places_timed
except Exception:  # never let the logger break a caller
    def _places_log(*a, **k): pass
    class _places_timed:
        ms = None
        def __enter__(self): return self
        def __exit__(self, *e): return False


def _places_blocked() -> bool:
    """True when the Jori Places budget is spent. Never raises — a broken
    guard must read as 'not blocked' rather than silently strip every venue."""
    try:
        from places_guard import places_block_reason

        return places_block_reason() is not None
    except Exception:
        return False


def get_google_places_key() -> Optional[str]:
    """Google Places API key. Env first, then .env, then 1Password (SA-token only,
    the secret reference in JORI_PLACES_OP_REF).

    Returns None when the Jori Places budget is spent. Every caller here
    already treats a missing key as "no Places enrichment" and returns [], so
    this one line degrades the whole module — segments still resolve from GPS,
    they just come back without venue names. Checked before the cache so the
    block takes effect within a run, and lifts the same way.
    """
    global _places_key_cache
    if _places_blocked():
        print("[location-segment] Google Places blocked (monthly budget cap) — "
              "skipping Places supplement this call", file=sys.stderr)
        return None
    if _places_key_cache is not None:
        return _places_key_cache or None
    key = os.environ.get("GOOGLE_PLACES_API_KEY") or _load_env().get("GOOGLE_PLACES_API_KEY")
    op_ref = os.environ.get("JORI_PLACES_OP_REF")
    if not key and op_ref and os.environ.get("OP_SERVICE_ACCOUNT_TOKEN"):
        try:
            r = subprocess.run(
                ["op", "read", op_ref],
                capture_output=True, text=True, check=False, timeout=10,
            )
            if r.returncode == 0:
                key = r.stdout.strip() or None
        except Exception:
            key = None
    _places_key_cache = key or ""
    if not key:
        _log_secret_failure(
            "GOOGLE_PLACES_API_KEY",
            "no env var, no .env entry, no SA token"
            if not os.environ.get("OP_SERVICE_ACCOUNT_TOKEN")
            else "no env var, no .env entry; SA token present but op read returned empty",
        )
    return key or None

# ============================================================================
# Geo math
# ============================================================================

EARTH_KM = 6371.0088

def haversine_km(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    dlat = math.radians(lat2 - lat1)
    dlon = math.radians(lon2 - lon1)
    a = (math.sin(dlat / 2) ** 2 +
         math.cos(math.radians(lat1)) * math.cos(math.radians(lat2)) * math.sin(dlon / 2) ** 2)
    return EARTH_KM * 2 * math.asin(math.sqrt(a))

def haversine_m(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    return haversine_km(lat1, lon1, lat2, lon2) * 1000.0

def bearing_deg(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    """Initial bearing from p1 to p2, in degrees [0, 360)."""
    rlat1 = math.radians(lat1)
    rlat2 = math.radians(lat2)
    dlon = math.radians(lon2 - lon1)
    y = math.sin(dlon) * math.cos(rlat2)
    x = (math.cos(rlat1) * math.sin(rlat2) -
         math.sin(rlat1) * math.cos(rlat2) * math.cos(dlon))
    brng = math.degrees(math.atan2(y, x))
    return (brng + 360.0) % 360.0

def angle_delta(a: float, b: float) -> float:
    """Smallest angular distance between two bearings (degrees)."""
    d = abs(a - b) % 360.0
    return d if d <= 180.0 else 360.0 - d

def in_scooter_area(lat: float, lon: float) -> bool:
    """Inside the configured scooter_bbox (where shared e-scooters are common)."""
    b = _CFG.get("scooter_bbox")
    try:
        a, bb, c, d = (float(x) for x in b)
    except (TypeError, ValueError):
        return False
    return a <= lat <= c and bb <= lon <= d

def percentile(values: List[float], p: float) -> float:
    """Pure-stdlib percentile. p in [0, 100]. Returns 0 for empty input."""
    if not values:
        return 0.0
    s = sorted(values)
    if len(s) == 1:
        return s[0]
    k = (len(s) - 1) * (p / 100.0)
    lo = int(math.floor(k))
    hi = int(math.ceil(k))
    if lo == hi:
        return s[lo]
    return s[lo] + (s[hi] - s[lo]) * (k - lo)

# ============================================================================
# Time parsing
# ============================================================================

def parse_iso_to_ms(iso_str: str) -> int:
    try:
        dt = datetime.fromisoformat(iso_str.replace("Z", "+00:00"))
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return int(dt.timestamp() * 1000)
    except Exception:
        return 0

def ms_to_iso(ts_ms: int, tz: Optional[ZoneInfo] = None) -> str:
    dt = datetime.fromtimestamp(ts_ms / 1000, tz=timezone.utc)
    if tz is not None:
        dt = dt.astimezone(tz)
    return dt.isoformat()

def parse_period(period_arg: Optional[str], start_arg: Optional[str], end_arg: Optional[str]
                 ) -> Tuple[int, int]:
    HZ = HOME_TZ  # dates without a zone are the home zone's
    if start_arg and end_arg:
        try:
            sd = datetime.fromisoformat(start_arg)
            ed = datetime.fromisoformat(end_arg)
            if sd.tzinfo is None:
                sd = sd.replace(tzinfo=HZ)
            if ed.tzinfo is None:
                ed = ed.replace(tzinfo=HZ)
            return int(sd.timestamp() * 1000), int(ed.timestamp() * 1000)
        except Exception:
            sys.exit("ERROR: bad --start/--end. Use YYYY-MM-DD or ISO 8601.")
    if not period_arg:
        sys.exit("ERROR: specify period (yesterday/today/YYYY-MM-DD) or --start + --end.")

    arg = period_arg.lower()
    now_home = datetime.now(HZ)

    if arg == "today":
        start = now_home.replace(hour=0, minute=0, second=0, microsecond=0)
        end = start + timedelta(days=1)
    elif arg == "yesterday":
        start = (now_home - timedelta(days=1)).replace(hour=0, minute=0, second=0, microsecond=0)
        end = start + timedelta(days=1)
    else:
        try:
            d = datetime.fromisoformat(arg)
            if d.tzinfo is None:
                d = d.replace(tzinfo=HZ)
            start = d.replace(hour=0, minute=0, second=0, microsecond=0)
            end = start + timedelta(days=1)
        except Exception:
            sys.exit(f"ERROR: bad period '{period_arg}'. Use today/yesterday/YYYY-MM-DD.")

    return int(start.timestamp() * 1000), int(end.timestamp() * 1000)

# ============================================================================
# Supabase queries
# ============================================================================

def _sb_get(path: str, params: List[Tuple[str, str]], timeout: float = 15.0) -> List[Dict[str, Any]]:
    key = get_supabase_key()
    if not key:
        return []
    qs = urllib.parse.urlencode(params)
    url = f"{SUPABASE_URL}{path}?{qs}"
    req = urllib.request.Request(url, headers={
        "apikey": key,
        "Authorization": f"Bearer {key}",
        "Accept": "application/json",
        "User-Agent": "location-segment/1.0",
    })
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read())
            return data if isinstance(data, list) else []
    except Exception as e:
        print(f"[location-segment] supabase {path} error: {e}", file=sys.stderr)
        return []

def fetch_samples(start_ts_ms: int, end_ts_ms: int) -> List[Sample]:
    start_iso = ms_to_iso(start_ts_ms)
    end_iso = ms_to_iso(end_ts_ms)
    rows = _sb_get("/rest/v1/location_history", [
        ("arrived_at", f"gte.{start_iso}"),
        ("arrived_at", f"lte.{end_iso}"),
        ("order", "arrived_at.asc"),
        ("limit", "20000"),
        ("select", "latitude,longitude,arrived_at,accuracy_m,activity"),
    ])
    out: List[Sample] = []
    for r in rows:
        ts = parse_iso_to_ms(r.get("arrived_at", ""))
        lat = r.get("latitude")
        lon = r.get("longitude")
        if not ts or lat is None or lon is None:
            continue
        out.append(Sample(
            ts_ms=ts, lat=float(lat), lon=float(lon),
            accuracy_m=float(r["accuracy_m"]) if r.get("accuracy_m") is not None else None,
            activity=r.get("activity"),
        ))
    return out

def fetch_photos(start_ts_ms: int, end_ts_ms: int) -> List[Dict[str, Any]]:
    rows = _sb_get("/rest/v1/photos", [
        ("taken_at", f"gte.{ms_to_iso(start_ts_ms)}"),
        ("taken_at", f"lte.{ms_to_iso(end_ts_ms)}"),
        ("latitude", "not.is.null"),
        ("order", "taken_at.asc"),
        ("limit", "1000"),
        ("select", "uuid,taken_at,latitude,longitude,original_filename"),
    ])
    out = []
    for r in rows:
        ts = parse_iso_to_ms(r.get("taken_at", ""))
        if not ts or r.get("latitude") is None or r.get("longitude") is None:
            continue
        out.append({
            "ts_ms": ts,
            "lat": float(r["latitude"]),
            "lon": float(r["longitude"]),
            "uuid": r.get("uuid"),
            "filename": r.get("original_filename"),
        })
    return out

def fetch_phone_context_latest() -> Optional[Dict[str, Any]]:
    rows = _sb_get("/rest/v1/phone_context", [
        ("order", "ts.desc"),
        ("limit", "1"),
        ("select", "*"),
    ])
    return rows[0] if rows else None

