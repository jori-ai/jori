    # Shorter is better: Google's searchText returns 0 results for compound queries
    # like "restaurant cafe bar" but 4+ for "restaurant" alone. Each prompt = 1 API call.
    ((6, 11),  ["cafe", "bakery"]),
    ((11, 15), ["restaurant", "cafe"]),
