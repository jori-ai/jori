INFERRED_STOP_BRACKET_RADIUS_M = 200.0  # bracketing samples must be within this of each other
INFERRED_STOP_NEAR_EXISTING_M = 100.0   # skip if inferred centroid is this close to an adjacent real stop
INFERRED_STOP_SIDE_TRIP_MAX_M = 2500.0  # for the "side-trip & return" case, the anchor must be a
                                        # plausible side trip from the base it returned to — not a
