# 7-day TTL is safe: venues don't open/close minute-to-minute, and the
# resolver only hits Places for stops not yet user-confirmed (confirmed
# stops short-circuit at tier 2 of resolve_place). Without this cache
# live-day's 10-min refresh + location-confirm's 10-min refresh were
# re-Places'ing every unresolved stop on every tick — thousands of
# searchNearby+searchText calls/day at $0.032/call. (2026-05-11)
PLACES_CACHE_TTL_SEC = 7 * 24 * 3600

# Stop detection — Li/Zheng anchor-walk.
#
# 2026-04-30: lowered MIN_STOP_MIN from 15 → 5. Pre-fix, the Li/Zheng walk
# rejected any cluster shorter than 15min, which silently dropped dog-walk
# waypoints (4 stops of 6-9 min in one evening), sub-15min errands, drive-thru
# pickups, brief social check-ins — the entire class of "where I was for ~10
# min" was invisible to Jori (a summary that "completely missed the lunch
# location and the evening walk"). The daily-summary playbook now groups consecutive short stops as a
# single "walk loop" line so the rendering stays scannable while the data is
# captured. Set lower than 5 only if you want raw-noise traffic-light clusters.
DEFAULT_MIN_STOP_MIN = 5.0
DEFAULT_STOP_RADIUS_M = 200.0
DEFAULT_MERGE_GAP_MIN = 15.0
SEMANTIC_MERGE_RADIUS_M = 250.0  # both stops within this of same named anchor -> merge
# Max time gap between two same-named stops to consider semantic-merging them.
# Without this cap, semantic-merge collapses the morning walk pattern (Home →
# 6h gap with a walk → Home) into one false 12-hour Home stop. 60 min is
# enough to absorb sparse-GPS gaps within a single stay but small enough that
# any real outing breaks the merge. Discovered 2026-04-25.
SEMANTIC_MERGE_MAX_GAP_MIN = 60.0
STATIONARY_NOISE_KM = 0.2  # routes shorter than this collapse into adjacent stop
NOISE_ROUTE_MAX_MIN = 5.0  # also-shorter-than to trigger collapse
# Stops with cluster_radius/duration above this are "browse" patterns (wandering
# while photographing, looking at a menu, etc.) rather than real venue dwells.
# 5 m/min separates real stops (a restaurant 1.4, a music club 1.8) from
# drift-walks (a diner "stop" ran 7.2 m/min — confirmed by the user as "took
# pictures + looked at menu, not a real stop").
BROWSE_PATTERN_RATIO_M_PER_MIN = 5.0

