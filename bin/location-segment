#!/usr/bin/env python3
"""location-segment — gap-free GPS timeline builder.

Given a (start, end) window and the GPS pings stored in Supabase
location_history, produces a JSON timeline that covers every minute
of the window with exactly one of:
  - stops[]   — clusters where you stayed >= MIN_STOP_MIN (Li/Zheng anchor-walk)
  - routes[]  — movement between stops, split into legs by transport mode
  - gaps[]    — windows where no GPS samples exist

Stop naming is tiered (named locations -> known recurring stops -> Wi-Fi SSID
-> Google Places searchNearby -> Nominatim -> coords). Each route leg gets a
transport mode ("walked", "drove", "train", "cycled", "e_scooter_likely",
"flew", "unknown") with a confidence score derived from speed/straightness/
bearing-change features. Optional Valhalla snapping turns raw polylines
into road-matched ones.

Lives alongside `location-stops`. Same Supabase data source, same date
parsing, but with anchor-walk clustering, multi-leg routes, gap-explicit
coverage, and venue-grade naming on by default.

Usage:
  location-segment yesterday
  location-segment today
  location-segment --start 2026-04-24T14:00 --end 2026-04-24T20:00
  location-segment --input fixture.json --no-places --no-photos
  location-segment yesterday --snap valhalla --output timeline.json

Flags:
  --json                JSON to stdout (default)
  --output PATH         write JSON to file instead of stdout
  --input PATH          read raw samples from a JSON file (test/replay)
  --min-stop-min N      stop dwell threshold (default 15)
  --stop-radius-m N     anchor-walk radius (default 200)
  --merge-gap-min N     temporal-merge gap threshold (default 15)
  --snap valhalla|none  polyline source (default none -> raw downsampled)
  --no-places           skip Google Places (rating/review enrichment + fallback)
  --no-overpass         skip OSM Overpass (primary venue lookup)
  --no-photos           skip photo-table waypoint join
  --no-audio            skip phone_context audio snapshot join
  --debug               include cluster diagnostics in output
"""

import argparse
import json
