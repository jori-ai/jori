def load_known_recurring_stops() -> List[Dict[str, Any]]:
    if not os.path.exists(KNOWN_STOPS_FILE):
        return []
    try:
        with open(KNOWN_STOPS_FILE) as f:
            data = json.load(f)
        return data.get("entries", [])
    except Exception:
        return []

def load_confirmed_stops() -> List[Dict[str, Any]]:
    """Past one-off venue confirmations from the live ask-cron. Format:
    [{"centroid":[lat,lon], "name", "place_id", "ts", "address", "primary_type", "source"}].
    Each entry takes precedence over OSM/Google for any future stop within
    CONFIRMED_STOP_MATCH_M of its centroid — this is how a confirmed restaurant
    auto-resolves on the second visit even though it's not a recurring weekly stop."""
    if not os.path.exists(CONFIRMED_STOPS_FILE):
        return []
    try:
        with open(CONFIRMED_STOPS_FILE) as f:
            data = json.load(f)
        if isinstance(data, list):
            return data
        if isinstance(data, dict):
            return data.get("entries", [])
    except Exception:
        pass
    return []

_SAVED_PLACES_CACHE: Optional[List[Dict[str, Any]]] = None

def load_saved_places() -> List[Dict[str, Any]]:
    global _SAVED_PLACES_CACHE
    if _SAVED_PLACES_CACHE is not None:
        return _SAVED_PLACES_CACHE
    try:
        with open(SAVED_PLACES_FILE) as f:
            data = json.load(f)
        _SAVED_PLACES_CACHE = [p for p in data.get("places", [])
                               if p.get("name") and p.get("lat") is not None and p.get("lng") is not None]
    except Exception:
        _SAVED_PLACES_CACHE = []
    return _SAVED_PLACES_CACHE

def saved_place_candidates(stop: "StopCandidate") -> List[PlaceCandidate]:
    """Saved places near where the user SAT — measured from the nearest sample as well
    as the centroid, since a centroid that includes the walk in can sit 40 m off
    the table (location-spine: 'a centroid is a summary statistic')."""
    clat, clon = stop.centroid()
    pts = [(clat, clon)] + [(s.lat, s.lon) for s in stop.samples]
    near = []
    for p in load_saved_places():
        d = min(haversine_m(lat, lon, p["lat"], p["lng"]) for lat, lon in pts)
        if d <= SAVED_PLACE_LIVE_M:
            near.append((d, p))
    near.sort(key=lambda x: x[0])
    lead_ok = sum(1 for d, _ in near if d <= SAVED_PLACE_LEAD_M) == 1
    out = []
    for i, (d, p) in enumerate(near[:3]):
        conf = 0.85 if (i == 0 and lead_ok) else max(0.5, 0.75 - d / 400.0)
        out.append(PlaceCandidate(
            name=p["name"], address=p.get("address"),
            source="saved_place", confidence=conf, distance_m=d,
            place_id=p.get("place_id"),
        ))
    return out

def load_wifi_map() -> List[Dict[str, Any]]:
