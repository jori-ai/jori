#!/bin/sh
':' //; for n in /opt/homebrew/bin/node /usr/local/bin/node "$(command -v node 2>/dev/null)"; do [ -x "$n" ] && exec "$n" "$0" "$@"; done; echo "$0: no node interpreter found" >&2; exit 127 # kernel-closure-ok: the node launcher bin/cron-run uses, for cron's bare PATH; falls back to PATH
// (Lines 1-2: a sh launcher that is also valid JS, as in bin/cron-run, so this
// runs under cron's bare PATH too.)
// secrets-broker — the command-line side of the secrets broker
// (docs/secrets-broker.md). It holds no key: each command is one request to
// the broker, which runs as its own user, holds the 1Password tokens and
// answers only what its root-owned policy allows.
//
//   secrets-broker available [logins|dev|…]     exit 0 when a broker answers (and holds that token)
//   secrets-broker health                       tokens it holds (names only), as JSON
//   secrets-broker logins-list Login|card       Logins vault overview (op item list JSON)
//   secrets-broker login-field <id> username|password
//   secrets-broker card <id>                    a purchase-tagged card item (JSON)
//   secrets-broker dev-site <domain> [--field F]   Dev "site:<domain>": a field, or the item JSON
//   secrets-broker dev-item <name>              a policy-listed item's listed fields (JSON)
//   secrets-broker run <bundle> [--env-file F] -- CMD ARGS…
//                                               run CMD with a policy-listed bundle of values in
//                                               its environment, as `op run` did. F's plain lines
//                                               are set as they are; each 1Password-reference line must be a
//                                               variable the bundle supplies. Exits with CMD's code.
//
// Exit codes: 0 ok, 5 not found, 64 usage, 77 refused by policy (or the
// hourly cap), 78 no broker / it holds no token, 1 other.

const { ask, present, EXIT } = require("../lib/secrets-broker/client.cjs");

const [cmd, ...rest] = process.argv.slice(2);
const usage = () => { process.stderr.write("usage: secrets-broker available|health|logins-list|login-field|card|dev-site|dev-item …\n"); process.exit(64); };

async function main() {
  let op, fields = {}, raw = false;
  switch (cmd) {
    case "available": {
      if (!present()) process.exit(78);
      const r = await ask("health", {}, { timeoutMs: 5000 });
      process.exit(r.ok && (!rest[0] || (r.value.tokens || {})[rest[0]] === true) ? 0 : 78);
      return;
    }
    case "health": op = "health"; break;
    case "logins-list": op = "logins.list"; fields = { category: rest[0] === "card" ? "Credit Card" : rest[0] }; break;
    case "login-field": op = "logins.login_field"; fields = { id: rest[0], field: rest[1] }; raw = true; break;
    case "card": op = "logins.card"; fields = { id: rest[0] }; break;
    case "dev-site": {
      op = "dev.site"; fields = { domain: rest[0] };
      const i = rest.indexOf("--field");
      if (i >= 0) { fields.field = rest[i + 1]; raw = true; }
      break;
    }
    case "dev-item": op = "dev.item"; fields = { name: rest[0] }; break;
    case "run": return run(rest);
    default: usage();
  }
  const r = await ask(op, fields);
  if (!r.ok) {
    process.stderr.write(`secrets-broker: ${r.code}: ${r.error}\n`);
    process.exit(EXIT[r.code] ?? 1);
  }
  process.stdout.write(raw ? String(r.value) : JSON.stringify(r.value));
}

// `op run`, without the token: the bundle's values come from the broker.
async function run(args) {
  const dd = args.indexOf("--");
  if (dd < 1 || dd === args.length - 1) usage();
  const bundle = args[0];
  const opts = args.slice(1, dd);
  const cmd = args.slice(dd + 1);
  const fi = opts.indexOf("--env-file");
  const plain = {};
  const refs = [];
  if (fi >= 0) {
    const fs = require("node:fs");
    for (const raw of fs.readFileSync(opts[fi + 1], "utf8").split("\n")) {
      const line = raw.trim();
      const m = /^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/.exec(line); // lang-regex-ok: dotenv syntax, not language
      if (!m || line.startsWith("#")) continue;
      let v = m[2];
      if ((v.startsWith('"') && v.endsWith('"')) || (v.startsWith("'") && v.endsWith("'"))) v = v.slice(1, -1);
      if (v.includes("op://")) refs.push(m[1]); else plain[m[1]] = v; // kernel-guard-ok: the 1Password reference scheme, not a reference
    }
  }
  const r = await ask("dev.env", { name: bundle });
  if (!r.ok) { process.stderr.write(`secrets-broker: ${r.code}: ${r.error}\n`); process.exit(EXIT[r.code] ?? 1); }
  const missing = refs.filter((k) => !(k in r.value));
  if (missing.length) { process.stderr.write(`secrets-broker: bundle ${bundle} does not supply ${missing.join(", ")}; regenerate the policy\n`); process.exit(77); }
  const { spawn } = require("node:child_process");
  const child = spawn(cmd[0], cmd.slice(1), { stdio: "inherit", env: { ...process.env, ...plain, ...r.value } });
  for (const sig of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(sig, () => child.kill(sig));
  child.on("error", (e) => { process.stderr.write(`secrets-broker: ${cmd[0]}: ${e.message}\n`); process.exit(127); });
  child.on("exit", (code, sig) => process.exit(code ?? (sig ? 128 : 1)));
}

main();
