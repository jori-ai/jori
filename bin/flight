// ── Time zone ──────────────────────────────────────────────────────────────
// Departure times are entered and shown in the installation's home zone
// (instance().tz); each flight stores its zone as departureTZ.
const HOME_TZ = instance().tz;

/** The zone's short name at an instant ("CET", "GMT+3"), for display. */
function tzLabel(at = new Date(), tz = HOME_TZ) {
  try {
    const p = new Intl.DateTimeFormat("en-US", { timeZone: tz, timeZoneName: "short" }).formatToParts(new Date(at));
    return (p.find((x) => x.type === "timeZoneName") || {}).value || tz;
  } catch {
    return tz;
  }
}

