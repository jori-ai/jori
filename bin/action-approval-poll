#!/usr/bin/env node
// action-approval-poll — DETERMINISTIC executor for Face-ID-approved plugin
// actions (lib/action-approval.mjs). No LLM. Cron runs it every minute; each
// run polls for ~55 s so an approval is acted on within seconds of Face ID.
// It exits at once when no enabled plugin declares an approval, so it costs
// nothing on an installation that doesn't use them.
//
// For each `action_approvals` row the app has SIGNED:
//   1. claim it (signed → executing, conditional PATCH: exactly one runner wins)
//   2. verify the signature against the PAIRED device key for row.signed_by
//      (purchase_device_keys, written only by the pairing RPC) and that the
//      item still hashes to what was signed
//   3. check the plugin is still on and still declares the action
//   4. run the manifest's `run` command (never anything from the row) with
//      {id, plugin, action, params} as JSON on stdin, and tell the user how it went.
// Any miss before step 4 → `failed`, nothing runs, and the user is told why.
// Pending rows past their window are marked `expired`.

import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawn, execFileSync } from "node:child_process";
import { createRequire } from "node:module";
import { installRoot } from "../lib/root.cjs";

const ROOT = installRoot();
for (const l of (() => { try { return fs.readFileSync(path.join(ROOT, ".env"), "utf8").split("\n"); } catch { return []; } })()) {
  const m = l.match(/^([A-Z_]+)=(.*)$/); if (m && !process.env[m[1]]) process.env[m[1]] = m[2];
}
const require = createRequire(import.meta.url);
const Plugins = require("../lib/plugins.cjs");
const { nodeBin } = require("../lib/root.cjs");
const BASE = process.env.SUPABASE_URL || require("../lib/instance.cjs").supabaseUrl();
const K = process.env.SUPABASE_SERVICE_ROLE_KEY;
const H = { apikey: K, Authorization: "Bearer " + K, "Content-Type": "application/json" };
const LOCK = path.join(ROOT, "data/.action-approval-poll.lock");
const LOG = path.join(ROOT, "data/logs/action-approval.log");

const A = await import(path.join(ROOT, "lib/action-approval.mjs"));
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

function log(msg) {
  try { fs.mkdirSync(path.dirname(LOG), { recursive: true }); fs.appendFileSync(LOG, `${new Date().toISOString()} ${msg}\n`); } catch {}
}

async function rest(pathq, { method = "GET", body, prefer } = {}) {
  const r = await fetch(`${BASE}/rest/v1/${pathq}`, {
    method, headers: { ...H, ...(prefer ? { Prefer: prefer } : {}) }, body: body ? JSON.stringify(body) : undefined,
  });
  if (!r.ok) throw new Error(`supabase ${method} ${pathq.split("?")[0]}: HTTP ${r.status}`);
  const t = await r.text(); return t ? JSON.parse(t) : null;
}

const patch = (id, body, extra = "") =>
  rest(`action_approvals?id=eq.${encodeURIComponent(id)}${extra}`, { method: "PATCH", prefer: "return=representation", body });

function tell(text) {
  try {
    execFileSync(path.join(ROOT, "bin/jori-send-curl"),
      ["--skip-precheck", "--intent", "action-approval-result", "--agent", "ops", text], { stdio: "ignore", timeout: 60000 });
  } catch (e) { log(`notify failed: ${e.message}`); }
}

async function finish(row, status, result, message) {
  await patch(row.id, { status, result, executed_at: new Date().toISOString() });
  log(`${row.id} ${row.plugin}/${row.action} ${status} ${JSON.stringify(result).slice(0, 500)}`);
  if (message) tell(message);
}

/** Run the declared command; resolves {ok, exitCode, stdout, stderr, timedOut}. */
function runDeclared(cmd, input, { timeoutMs, env }) {
  return new Promise((resolve) => {
    const child = spawn("/bin/bash", ["-c", cmd], { cwd: ROOT, env, stdio: ["pipe", "pipe", "pipe"] });
    let stdout = "", stderr = "", timedOut = false;
    const cap = (s, d) => (s.length > 64 * 1024 ? s : s + d);
    child.stdout.on("data", (d) => { stdout = cap(stdout, d.toString()); });
    child.stderr.on("data", (d) => { stderr = cap(stderr, d.toString()); });
    const t = setTimeout(() => { timedOut = true; child.kill("SIGTERM"); setTimeout(() => child.kill("SIGKILL"), 5000); }, timeoutMs);
    child.on("close", (code) => { clearTimeout(t); resolve({ ok: code === 0 && !timedOut, exitCode: code, stdout, stderr, timedOut }); });
    child.on("error", (e) => { clearTimeout(t); resolve({ ok: false, exitCode: null, stdout, stderr: String(e.message), timedOut }); });
    child.stdin.on("error", () => {});
    child.stdin.end(JSON.stringify(input));
  });
}

async function execute(row) {
  const title = row.item_json?.title || `${row.plugin} ${row.action}`;
  const keys = await rest(`purchase_device_keys?device_id=eq.${encodeURIComponent(row.signed_by)}&select=public_key_raw&limit=1`);
  const v = A.verifyActionRow(row, keys[0]?.public_key_raw);
  if (!v.ok) {
    return finish(row, "failed", { reason: v.reason },
      `I didn't run “${title}”. Your approval didn't check out (${v.reason}), so nothing ran.`);
  }
  const decl = Plugins.declaredApproval(row.plugin, row.action);
  if (!decl) {
    return finish(row, "failed", { reason: "plugin off or action no longer declared" },
      `I didn't run “${title}”: the ${row.plugin} plugin is off or no longer declares that action. Nothing ran.`);
  }
  const item = A.normalizeActionItem(row.item_json);
  const root = ROOT;
  const node = String(Plugins.state().node || nodeBin()).replace(/^~(?=\/)/, os.homedir());
  const cmd = A.expandRun(decl.run, decl.plugin.dir, { node, sysnode: process.execPath, root, home: os.homedir() });
  log(`${row.id} running ${row.plugin}/${row.action}: ${cmd}`);
  const res = await runDeclared(cmd, { id: row.id, plugin: row.plugin, action: row.action, params: item.params }, {
    timeoutMs: (decl.timeout_seconds || A.DEFAULT_TIMEOUT_SECONDS) * 1000,
    env: { ...process.env, JORI_APPROVAL_ID: row.id, JORI_APPROVAL_PLUGIN: row.plugin, JORI_APPROVAL_ACTION: row.action },
  });
  const result = { exit: res.exitCode, timed_out: res.timedOut, stdout: res.stdout.slice(-2000), stderr: res.stderr.slice(-2000) };
  return finish(row, res.ok ? "done" : "failed", result, A.resultMessage(item, res));
}

async function tick() {
  const rows = await rest("action_approvals?status=in.(pending,signed)&select=*");
  for (const r of rows.filter((x) => x.status === "pending")) {
    if (Number(r.expires_at_ms) + A.EXECUTE_GRACE_MS < Date.now()) await patch(r.id, { status: "expired" }, "&status=eq.pending");
  }
  for (const r of rows.filter((x) => x.status === "signed")) {
    const claimed = await patch(r.id, { status: "executing" }, "&status=eq.signed");
    if (claimed?.length !== 1) continue;
    try { await execute(claimed[0]); }
    catch (e) {
      await finish(claimed[0], "failed", { reason: e.message },
        `Something went wrong running “${claimed[0].item_json?.title}” (${e.message}). It may or may not have run; worth a look.`);
    }
  }
}

if (!Plugins.anyApprovalsDeclared()) process.exit(0);

// One runner at a time (cron fires every minute; a run lasts ~55 s).
try {
  const st = fs.statSync(LOCK);
  if (Date.now() - st.mtimeMs < 120000 + A.DEFAULT_TIMEOUT_SECONDS * 1000) process.exit(0);
} catch {}
fs.writeFileSync(LOCK, String(process.pid));
try {
  const until = Date.now() + Number(process.env.ACTION_APPROVAL_POLL_SECONDS || 55) * 1000;
  do {
    await tick().catch((e) => log(`tick error: ${e.message}`));
    await sleep(5000);
  } while (Date.now() < until);
} finally { try { fs.unlinkSync(LOCK); } catch {} }
