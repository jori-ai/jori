#!/usr/bin/env node
// tmdb-watch-providers — refresh `platform` on every active watch_titles row by
// querying TMDB's /watch/providers endpoint. Closes the platform-tag drift
// gap noted across the 2026-04-27..04-30 nightly reviews (originally framed
// as "JustWatch API" — TMDB sources its streaming-availability data from
// JustWatch under partnership, free public API key, no contract needed).
//
// Strategy:
//   1. Read every non-rejected watchlist row with an imdb_id.
//   2. Use TMDB's /find/{imdb_id} to resolve to a TMDB ID + media type.
//   3. Fetch /watch/providers for that ID; pick US `flatrate` (subscription)
//      providers, falling back to `free` then `ads` then `rent`/`buy` if
//      none stream-with-subscription. Top 1-2 names → `platform` field.
//   4. UPDATE the row only when the value changes (idempotent re-runs).
//
// Usage:
//   tmdb-watch-providers              # dry-run
//   DROP=1 tmdb-watch-providers       # commit updates
//
// Requires TMDB_API_KEY in .env (free, self-serve at
// themoviedb.org/settings/api, "Developer" tier — instant approval).

import { createRequire } from "node:module";
import { loadEnv } from "../lib/load-env.js";
import { pickProviders } from "../lib/tmdb-providers.mjs";
import { watchConfig } from "../lib/watch-config.mjs";

loadEnv();

const { supabaseUrl } = createRequire(import.meta.url)("../lib/instance.cjs");
const SUPABASE_URL = process.env.SUPABASE_URL || supabaseUrl();
const SUPABASE_KEY = process.env.SUPABASE_SERVICE_ROLE_KEY;
const TMDB_KEY = process.env.TMDB_API_KEY;
const COMMIT = process.env.DROP === "1";
const REGION = process.env.TMDB_REGION || String(watchConfig().home_region || "US").toUpperCase();
const PROVIDER_CAP = 2;

if (!SUPABASE_URL) {
  console.error("tmdb-watch-providers: no Supabase project (instance supabase_project or SUPABASE_URL)");
  process.exit(1);
}
if (!SUPABASE_KEY) {
  console.error("tmdb-watch-providers: SUPABASE_SERVICE_ROLE_KEY not set");
  process.exit(1);
}
if (!TMDB_KEY) {
  console.error("tmdb-watch-providers: TMDB_API_KEY not set in .env — get a free key at https://www.themoviedb.org/settings/api");
  process.exit(1);
}

async function fetchJson(url, opts = {}) {
  const res = await fetch(url, { ...opts, headers: { Accept: "application/json", ...(opts.headers || {}) } });
  if (!res.ok) throw new Error(`${res.status} ${url}: ${(await res.text()).slice(0, 200)}`);
  return res.json();
}

async function rest(method, path, body) {
  const res = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, {
    method,
    headers: {
      apikey: SUPABASE_KEY,
      Authorization: `Bearer ${SUPABASE_KEY}`,
      "Content-Type": "application/json",
      Prefer: method === "PATCH" ? "return=minimal" : "return=representation",
    },
    body: body ? JSON.stringify(body) : undefined,
  });
  if (!res.ok) throw new Error(`${method} ${path} → ${res.status}: ${(await res.text()).slice(0, 240)}`);
  if (res.status === 204) return null;
  return res.json();
}

async function resolveTmdbId(imdbId) {
  const data = await fetchJson(
    `https://api.themoviedb.org/3/find/${encodeURIComponent(imdbId)}?external_source=imdb_id&api_key=${TMDB_KEY}`,
  );
  // Order matters — prefer tv over movie if both exist (rare but possible).
  if (data.tv_results?.length) return { id: data.tv_results[0].id, kind: "tv" };
  if (data.movie_results?.length) return { id: data.movie_results[0].id, kind: "movie" };
  return null;
}

async function watchProviders(kind, tmdbId) {
  const data = await fetchJson(
    `https://api.themoviedb.org/3/${kind}/${tmdbId}/watch/providers?api_key=${TMDB_KEY}`,
  );
  return pickProviders(data.results?.[REGION], PROVIDER_CAP);
}

// v2 (2026-10-04): watch_titles already carries tmdb_id, so most rows skip the
// /find round-trip. Rejected/dropped titles don't need a platform.
const rows = (await rest(
  "GET",
  "watch_titles?select=id,name,kind,tmdb_id,imdb_id,platform&status=not.in.(rejected,dropped)&or=(tmdb_id.not.is.null,imdb_id.not.is.null)&order=updated_at.desc",
)).map((r) => ({ ...r, title: r.name }));
console.log(`tmdb-watch-providers: scanning ${rows.length} rows (region=${REGION})`);

let resolved = 0, changed = 0, unchanged = 0, kept = 0, missing = 0, errors = 0;
for (const row of rows) {
  let kind, tmdbId, providers;
  try {
    const r = row.tmdb_id ? { id: row.tmdb_id, kind: row.kind === "show" ? "tv" : "movie" } : await resolveTmdbId(row.imdb_id);
    if (!r) { missing++; continue; }
    kind = r.kind; tmdbId = r.id;
    providers = await watchProviders(kind, tmdbId);
    resolved++;
  } catch (e) {
    errors++;
    console.error(`  err  ${row.imdb_id} ${row.title}: ${e.message}`);
    continue;
  }
  const next = providers.join(" / ") || null;
  if ((row.platform || null) === next) {
    unchanged++;
    continue;
  }
  if (next === null) {
    // TMDB has no usable provider for this region — either no region entry at
    // all, or every candidate was filtered as a reseller/transactional variant.
    // Treat that as "no data," not "removed": don't blank a tag for a show
    // that is genuinely still streaming somewhere. Logged as `keep`, never as
    // PATCH — a write we deliberately skip must not read like a committed one.
    console.log(`  keep   #${row.id} ${row.title}: no ${REGION} provider data, keeping "${row.platform}"`);
    kept++;
    continue;
  }
  console.log(`  ${COMMIT ? "PATCH" : "[dry-run]"}  #${row.id} ${row.title}: "${row.platform || "(none)"}" → "${next}"`);
  if (COMMIT) {
    try {
      await rest("PATCH", `watch_titles?id=eq.${row.id}`, { platform: next });
      changed++;
    } catch (e) {
      errors++;
      console.error(`    update failed: ${e.message}`);
    }
  } else {
    changed++;
  }
  // TMDB free tier is generous (~50 req/sec) but be polite.
  await new Promise((r) => setTimeout(r, 50));
}

console.log(
  `\ntmdb-watch-providers: resolved=${resolved} changed=${changed} unchanged=${unchanged} kept=${kept} no-tmdb-match=${missing} errors=${errors}`,
);
if (!COMMIT) console.log("dry-run; re-run with DROP=1 to commit");
