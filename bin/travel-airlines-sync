#!/usr/bin/env node
// travel-airlines-sync — expand airline codes in trip pages and build
// one airline page per carrier with backlinks to trips and flight dates.

"use strict";

const ws = require("../lib/wiki-store.js");
const { localConfig } = require("../lib/instance.cjs");

// A service animal that travels with the user, from
// agent/local/config/travel-wiki.json `service_animal`:
//   { name, wiki_ids: [page ids a trip's "Shared with" line links it by], page }
// Absent, no flight is marked.
const ANIMAL = localConfig("travel-wiki", { service_animal: null }).service_animal || null;
const ANIMAL_NAME = ANIMAL && ANIMAL.name ? String(ANIMAL.name) : "";
const ANIMAL_IDS = ANIMAL && Array.isArray(ANIMAL.wiki_ids) ? ANIMAL.wiki_ids.map(String) : [];
const reEsc = (t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

