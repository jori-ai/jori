#!/usr/bin/env node
/**
 * lint-unguarded-event-send — fail a commit that recommends a dated,
 * place-bound event without gating on where the user will actually be.
 *
 * THE RULE (ops-agent/CLAUDE.md § Travel Timeline & Event Geo-Gating, marked
 * "MANDATORY, no exceptions"): every planner, lane, job, harvester or digest
 * that recommends a dated, place-bound event must gate on `travel in-city`
 * before surfacing it.
 *
 * WHY THIS IS A HOOK AND NOT A PARAGRAPH. Six harvesters get the gate for free
 * from `_common.mjs geoGate`. Every job with its own direct notify had to
 * remember, and twice in one week two different jobs did not: each had a
 * gated harvester path but its own notify step pushed events in the home city
 * while the user was travelling elsewhere.
 *
 * Both were caught after they had already reached the user. Two independent authors
 * making the same omission is the signature of a rule that needs enforcing
 * rather than restating — the same conclusion the fabricated-outage gate and
 * the language-regex lint both reached.
 *
 * The send path now checks (`jori-send-curl --event-city/--event-date`), so
 * this lint exists for the OTHER half of the problem: a job that calls the send
 * path without passing the flags gets no gate at all, and nothing would say so.
 *
 * WHAT IS FLAGGED: a staged playbook or script that calls `jori-send-curl`
 * AND talks about a dated place-bound event, without either the geo flags or an
 * explicit declared exception.
 *
 * DECLARING AN EXCEPTION: put `geo-gate-ok: <reason>` in a comment on or near
 * the send. Same shape as `lang-regex-ok:`, and legitimate — a day-of rush
 * lottery for a show the user is already in town for is gated by its own date
 * logic; an email-only digest reaches the user wherever they are. State which and move on.
 */

import { execFileSync } from "node:child_process";
import fs from "node:fs";

function staged() {
  try {
    const out = execFileSync("git", ["diff", "--cached", "--name-only", "--diff-filter=ACM"], { encoding: "utf8" });
    return out.split("\n").map((s) => s.trim()).filter(Boolean);
  } catch { return []; }
}

// Words that mark a file as being ABOUT dated, place-bound events. Kept narrow
// and venue/format-shaped on purpose: this matches our own job vocabulary,
// never anything the user wrote (Rule #0b).
//
// TWO DISTINCT SIGNALS ARE REQUIRED, not one. A single incidental mention is
// not an event lane — caught immediately, by this lint blocking its own commit:
// a scheduling playbook mentioned a lottery's narrower in-city check in
// passing while describing a presence helper, and had nothing to do with
// events. The same conjunction principle already guards the auto-warranty spam
// fingerprint in ops-agent/CLAUDE.md ("warranty anchor AND offer bait"), and
// for the same reason: precision, so the gate keeps being worth obeying.
// lang-regex-ok: matching Jori's own playbook prose for job-shape detection,
// not interpreting any user language.
const EVENT_WORDS = /\b(concert|showtime|matinee|tickets?|venue|headliner|lineup|festival|exhibit(ion)?|gallery opening|screening|lottery|rush seats|doors at|on sale)\b/gi;
const MIN_EVENT_SIGNALS = 2;

function eventSignals(src) {
  const hits = String(src).match(EVENT_WORDS) || [];
  return new Set(hits.map((h) => h.toLowerCase())).size;
}
// lang-regex-ok: our own CLI's flag syntax.
const HAS_GEO_FLAGS = /--event-city\b/;
// lang-regex-ok: the declared-exception marker, our own convention.
const HAS_EXEMPTION = /geo-gate-ok:/;
// lang-regex-ok: our own CLI name.
const CALLS_SEND = /jori-send-curl/;

const offenders = [];
for (const file of staged()) {
  if (!/\.(md|sh|mjs|js|py)$/.test(file)) continue;
  // The send path itself, the gate's own tests, and the docs describing the
  // rule all legitimately mention both halves.
  if (/bin\/(jori-send-curl|lint-unguarded-event-send)$/.test(file)) continue;
  if (/tests\//.test(file)) continue;
  if (/CLAUDE\.md$|architecture\.md$|-plan\.md$/.test(file)) continue;

  let src;
  try { src = fs.readFileSync(file, "utf8"); } catch { continue; }
  if (!CALLS_SEND.test(src)) continue;
  if (HAS_GEO_FLAGS.test(src) || HAS_EXEMPTION.test(src)) continue;
  if (eventSignals(src) < MIN_EVENT_SIGNALS) continue;

  offenders.push(file);
}

if (!offenders.length) process.exit(0);

console.error("");
console.error("pre-commit: refusing this commit — an event recommendation with no geo-gate.");
console.error("");
for (const f of offenders) console.error(`  ${f}`);
console.error("");
console.error("These call jori-send-curl and talk about dated, place-bound events, but pass");
console.error("neither --event-city/--event-date nor a declared exception. A recommendation for");
console.error("a city the user will not be in is not a recommendation.");
console.error("");
console.error("Two jobs once made exactly this omission and both were caught only after firing:");
console.error("  home-city events, pushed while the user was travelling elsewhere.");
console.error("");
console.error("Fix, whichever fits:");
console.error("  1. Gate the send:");
console.error("       jori-send-curl --event-city <city> --event-date YYYY-MM-DD \\");
console.error("                         [--event-artist \"<name>\"] \"<message>\"");
console.error("     (fail-open: an unknown date never suppresses; a tier-1 headliner bypasses)");
console.error("  2. Declare why it doesn't need one, in a comment near the send:");
console.error("       # geo-gate-ok: email-only digest, reaches the user anywhere");
console.error("");
console.error("See ops-agent/CLAUDE.md § Travel Timeline & Event Geo-Gating.");
console.error("");
process.exit(1);
