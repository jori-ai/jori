#!/usr/bin/env node
"use strict";
/**
 * headliner — the tier-1 "worth traveling anywhere for" artist list. These
 * bypass the city-on-date geo-gate in every event-recommendation lane.
 *
 * Backed by data/tier1-artists.json. Distinct from music-profile.md's
 * taste tiers — this is purely the travel-anywhere bypass set.
 *
 * Usage:
 *   headliner check "<artist or event title>"   # exit 0 if a headliner, 1 if not
 *   headliner list [--json]
 *   headliner add "<artist>"
 *   headliner rm "<artist>"
 *
 * `check` matches case-insensitively as a substring of the normalized input, so
 * "Bruno Mars: Live at MSG" and "An Evening with Sting" both match.
 */

const fs = require("fs");
const path = require("path");
const { installTools } = require("../lib/root.cjs");

// The installation's own list (private data); absent on a fresh install, where
// nothing is a headliner. HEADLINER_FILE points elsewhere (tests).
const FILE = process.env.HEADLINER_FILE || installTools("data/tier1-artists.json");

function load() {
  try { return JSON.parse(fs.readFileSync(FILE, "utf8")); }
  catch { return { artists: [], updated_at: null }; }
}
function save(data) {
  fs.mkdirSync(path.dirname(FILE), { recursive: true });
  data.updated_at = new Date().toISOString().slice(0, 10);
  fs.writeFileSync(FILE, JSON.stringify(data, null, 2) + "\n");
}
function norm(s) {
  return String(s || "")
    .normalize("NFD").replace(/[̀-ͯ]/g, "")  // strip diacritics (Beyoncé → beyonce)
    .toLowerCase()
    .replace(/^the\s+/, "")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

const argv = process.argv.slice(2);
const cmd = argv[0];
const arg = argv[1];
const has = (f) => argv.includes(`--${f}`);

const data = load();

if (cmd === "check") {
  if (!arg) { process.stderr.write("usage: headliner check \"<artist or title>\"\n"); process.exit(2); }
  const input = norm(arg);
  const hit = data.artists.find(a => input.includes(norm(a)));
  if (hit) { console.log(`HEADLINER (${hit})`); process.exit(0); }
  console.log("not a headliner"); process.exit(1);
} else if (cmd === "list") {
  if (has("json")) console.log(JSON.stringify(data.artists, null, 2));
  else data.artists.forEach(a => console.log(a));
} else if (cmd === "add") {
  if (!arg) { process.stderr.write("usage: headliner add \"<artist>\"\n"); process.exit(2); }
  if (data.artists.some(a => norm(a) === norm(arg))) { console.log(`already listed: ${arg}`); process.exit(0); }
  data.artists.push(arg);
  data.artists.sort((a, b) => a.localeCompare(b));
  save(data);
  console.log(`added: ${arg}`);
} else if (cmd === "rm" || cmd === "remove") {
  if (!arg) { process.stderr.write("usage: headliner rm \"<artist>\"\n"); process.exit(2); }
  const before = data.artists.length;
  data.artists = data.artists.filter(a => norm(a) !== norm(arg));
  if (data.artists.length === before) { console.log(`not found: ${arg}`); process.exit(1); }
  save(data);
  console.log(`removed: ${arg}`);
} else {
  process.stderr.write("usage: headliner <check|list|add|rm> ...\n");
  process.exit(2);
}
