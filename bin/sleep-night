#!/usr/bin/env node
// sleep-night — one night's sleep from the phone's last lock / first unlock and
// the Apple Watch's sleep stages. See lib/sleep-night.js.
//
// Usage:
//   sleep-night                     the current night (last night before 14:00 local)
//   sleep-night --night 2026-10-08  a given night (evening date)
//   sleep-night --save              also upsert into sleep_nights; with no --night,
//                                   saves the current night AND the one before it
//                                   (the Watch batch can land many hours late)
//   sleep-night --now               is the user asleep right now (live, from the phone
//                                   rows and the Watch; lib/sleep-night.js asleepNow)
//   sleep-night --gate [--fallback FROM-TO] [--tz ZONE]
//                                   should a ping hold now? exit 0 = asleep, HOLD;
//                                   1 = go (any failure is "go" to a shell
//                                   `if …; then hold; fi`: fail-open).
//                                   FROM-TO = the caller's old quiet hours, used
//                                   whenever there is no usable sleep signal (sensing
//                                   off, no recent phone rows, a stale reading). Reads the
//                                   cron's state file, no network.
//   sleep-night --json
//
// With --save it also writes data/sleep-night-state.json (the current
// night + `asleep_now`, the live reading, + written_at). Every "may Jori ping
// now?" gate reads `asleep_now` through SN.sleepSignal / --gate, so pings follow
// whether the user is asleep, never the clock.

const fs = require("node:fs");
const path = require("node:path");
const SN = require("../lib/sleep-night.js");
const { installTools } = require("../lib/root.cjs");
const STATE = installTools("data/sleep-night-state.json");

// The last message the user typed to Jori (phone or desktop app): proof of being up.
function lastUserMessageMs() {
  try {
    const c = JSON.parse(fs.readFileSync(installTools("data/phone-channel-cursor.json"), "utf8"));
    const ms = Date.parse(c.lastSeenAt);
    return Number.isFinite(ms) ? ms : null;
  } catch { return null; }
}

(async () => {
  const argv = process.argv.slice(2);
  const json = argv.includes("--json");
  const save = argv.includes("--save");
  if (argv.includes("--gate")) {
    const val = (f) => { const i = argv.indexOf(f); return i >= 0 ? argv[i + 1] : undefined; };
    let fallback = null;
    const fb = val("--fallback");
    if (fb) { const [from, to] = fb.split("-").map(Number); if (Number.isFinite(from) && Number.isFinite(to)) fallback = { from, to }; }
    const r = SN.holdForSleep({ tz: val("--tz") || SN.userTz(), fallback });
    console.log(json ? JSON.stringify(r) : `${r.hold ? "hold" : "go"} [${r.source}] ${r.reason}`);
    process.exit(r.hold ? 0 : 1);
  }
  if (argv.includes("--now")) {
    const tz = SN.userTz();
    let night = null;
    try { night = await SN.fetchNight(SN.currentNightOf(tz), { tz }); } catch {}
    const r = await SN.fetchAsleepNow({ tz, night, lastUserMessageMs: lastUserMessageMs() });
    if (json) { console.log(JSON.stringify(r, null, 2)); return; }
    const word = r.asleep === true ? "ASLEEP — pings hold" : r.asleep === false ? "awake — pings may go out" : "unknown — no usable signal: each window uses its old clock hours";
    console.log(`${word}\n  ${r.reason}`);
    return;
  }
  const ni = argv.indexOf("--night");
  let nights;
  if (ni >= 0 && argv[ni + 1]) nights = [argv[ni + 1]];
  else {
    const cur = SN.currentNightOf(SN.userTz());
    nights = save ? [SN.addDays(cur, -1), cur] : [cur];
  }

  const out = [];
  for (const n of nights) {
    const night = await SN.fetchNight(n);
    if (night.fetch_errors) { process.exitCode = 1; console.error(`[sleep-night] ${n}: ${night.fetch_errors.join("; ")}`); }
    if (save && !night.fetch_errors && (night.phone_down_at || night.watch_onset_at)) {
      try { await SN.saveNight(night); night.saved = true; }
      catch (e) { night.save_error = e.message; process.exitCode = 1; }
    }
    out.push(night);
  }
  if (save && ni < 0) {
    const cur = out[out.length - 1];
    if (!cur.fetch_errors) {
      // A failed read leaves the file as it was; after 15 min its live reading is
      // stale, which SN.sleepSignal reads as no usable signal (clock hours).
      const asleepNow = await SN.fetchAsleepNow({ tz: cur.tz, night: cur, lastUserMessageMs: lastUserMessageMs() });
      const tmp = `${STATE}.tmp`;
      fs.writeFileSync(tmp, JSON.stringify({ ...cur, asleep_now: asleepNow, written_at: new Date().toISOString() }, null, 2));
      fs.renameSync(tmp, STATE);
    }
  }

  if (json) { console.log(JSON.stringify(nights.length === 1 ? out[0] : out, null, 2)); return; }
  for (const n of out) {
    const t = (v) => (v ? SN.localHm(Date.parse(v), n.tz) : "—");
    console.log(`Night of ${n.night_of} (${n.tz})${n.saved ? " [saved]" : ""}${n.save_error ? ` [SAVE FAILED: ${n.save_error}]` : ""}`);
    console.log(`  Phone down:   ${t(n.phone_down_at)}${n.phone_down_at && !n.phone_down_exact ? " (bounded — app wasn't running at the lock)" : ""}`);
    console.log(`  Phone up:     ${n.in_bed_now ? "still down" : t(n.phone_up_at)}${n.night_wakes ? `  (${n.night_wakes} brief night check${n.night_wakes > 1 ? "s" : ""})` : ""}`);
    console.log(`  Watch:        ${n.watch_onset_at ? `asleep ${t(n.watch_onset_at)} → ${t(n.watch_wake_at)} (${n.watch_asleep_min} min asleep)` : "not synced yet"}`);
    if (n.latency_min != null) console.log(`  Reading time: ${n.latency_min} min from phone down to asleep`);
    console.log(`  → Sleep ${t(n.sleep_at)} [${n.sleep_source || "—"}]   Wake ${t(n.wake_at)} [${n.wake_source || "—"}]`);
    if (n.max_silence_min > 90) console.log(`  ! no phone rows for ${n.max_silence_min} min inside the night — an unlock could be missing`);
  }
})().catch(e => { console.error(e.message); process.exit(1); });
