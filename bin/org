#!/usr/bin/env node
// org — the assistant's team: who owns which job (lib/org.cjs, system/org.md).
//
//   org [list] [--json]        The chart: the CEO, each role (name, title,
//                              responsibility) and the jobs it owns.
//   org who <job|intent>       Which role owns this job or message intent.
//   org audit [--json]         Jobs no role owns (exit 1 when there are any).
//   org sign-subject <job> <subject>   The subject as that job's email would carry it.
//   org sign-ping <job> <text>         The text as that job's ping would carry it.
//   org sync [--dry-run]       Push the team (names, titles, responsibilities) to the app's
//                              jori_team table, with the roles the user can still add
//                              (enabled = false); turn on the ones the user added in the app
//                              (requested_at); keep and cache the names the user changed there.
//   org adopt <role-id>…       Turn those roles' plugins on (the user added them).
//
// The roster is agent/local/config/org.json. No LLM anywhere in here.
"use strict";
const org = require("../lib/org.cjs");

const [cmd = "list", ...rest] = process.argv.slice(2);
const json = rest.includes("--json") || process.argv.includes("--json");

if (cmd === "list") {
  const c = org.chart();
  if (json) { console.log(JSON.stringify(c, null, 1)); process.exit(0); }
  if (!c.roles.length) { console.log("No roles yet: write agent/local/config/org.json (system/org.md)."); process.exit(0); }
  console.log(`CEO: ${c.ceo || "the user"}`);
  for (const r of c.roles) {
    console.log(`\n${r.name} — ${r.title}${r.chief_of_staff ? " (coordinates the team)" : ""}`);
    if (r.responsibility) console.log(`  ${r.responsibility}`);
    console.log(`  ${r.jobs.length} job(s): ${r.jobs.join(", ") || "none"}`);
  }
  if (c.unassigned.length) console.log(`\nUnassigned (${c.unassigned.length}): ${c.unassigned.join(", ")}`);
  process.exit(0);
}
if (cmd === "who") {
  const name = rest.find((a) => !a.startsWith("--"));
  if (!name) { console.error("org who <job|intent>"); process.exit(64); }
  const r = org.roleFor({ job: name, intent: name });
  if (json) console.log(JSON.stringify(r ? { id: r.id, name: r.name, title: r.title } : null));
  else console.log(r ? `${r.name} (${r.title})` : "unassigned");
  process.exit(r ? 0 : 1);
}
if (cmd === "audit") {
  const c = org.chart();
  // A personal assistant alone (or no team at all) handles every job itself.
  if (c.roles.length <= 1) { if (json) console.log(JSON.stringify({ unassigned: [], solo: true })); else console.log("No team: every job goes through the assistant."); process.exit(0); }
  if (json) console.log(JSON.stringify({ unassigned: c.unassigned }));
  else console.log(c.unassigned.length ? `Unassigned (${c.unassigned.length}): ${c.unassigned.join(", ")}` : "Every job has a role.");
  process.exit(c.unassigned.length ? 1 : 0);
}
if (cmd === "sign-subject" || cmd === "sign-ping") {
  const [job, ...words] = rest.filter((a) => a !== "--json");
  const text = words.join(" ");
  console.log(cmd === "sign-subject" ? org.signSubject(text, { job, intent: job }) : org.signPing(text, { job, intent: job }));
  process.exit(0);
}
if (cmd === "sync") {
  try { require("../lib/load-env.js").loadEnv(); } catch { /* the env may already carry the key */ }
  org.syncTeam({ dryRun: rest.includes("--dry-run") })
    .then((r) => { console.log(JSON.stringify(r)); process.exit(0); })
    .catch((e) => { console.error(`org sync: ${e.message}`); process.exit(1); });
  return;
}
if (cmd === "adopt") {
  const ids = rest.filter((a) => !a.startsWith("--"));
  if (!ids.length) { console.error("org adopt <role-id>…"); process.exit(64); }
  const done = org.adoptRoles(ids);
  console.log(done.length ? `On the team now: ${done.join(", ")}` : "Nothing to turn on (already on the team, or not an installed role).");
  process.exit(0);
}
console.error("usage: org [list|who|audit|sign-subject|sign-ping|sync|adopt]");
process.exit(64);
