    "vietnamese_restaurant": 100, "mexican_restaurant": 100, "indian_restaurant": 100,  # kernel-guard-ok: Google Places primary types, the same for every user
    "mediterranean_restaurant": 100, "french_restaurant": 100, "american_restaurant": 100,  # kernel-guard-ok: Google Places primary types, the same for every user
    "seafood_restaurant": 100, "steak_house": 100, "sushi_restaurant": 100,
