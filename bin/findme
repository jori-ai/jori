#!/usr/bin/env python3
"""Find My CLI — locate devices and people via iCloud Find My.

For the user: queries the Jori app (Supabase) first — live GPS from the phone.
For everyone else: uses iCloud Find My as before.

pyicloud lives in the installation's own venv (agent/findmy-venv/.venv); run
directly without it, this script re-executes under that venv's python.

Config — agent/local/config/findme.json (optional; with none, only the user is
known and nobody is a companion):
  icloud_account       the Find My account (default: instance owner_email)
  people               { "<prsId>": "<name>" } — family members Find My shares
  primary_devices      { "<name, lower case>": "<device-name keyword>" }
  device_overrides     { "<device id prefix>": {"owner"?, "name"?} }
  companion_people     [names] checked by Find My for "with you" at a stop
  generic_place_names  Apple-geocoder area names (a borough, a city) that are
                       not a venue when they come back as a visit's POI name
"""

import sys
import os
import re
import json
import math
import subprocess
import urllib.parse
import urllib.request
from datetime import datetime, timezone, timedelta
from zoneinfo import ZoneInfo

_LIB = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib")
sys.path.insert(0, _LIB)
import places_local  # noqa: E402
import companions as _companions  # noqa: E402

try:
    from pyicloud import PyiCloudService
except ImportError:
    _VENV_PY = os.path.join(places_local.install_root(), "agent", "findmy-venv", ".venv", "bin", "python")
    if (__name__ == "__main__" and os.path.exists(_VENV_PY)
            and os.path.realpath(sys.executable) != os.path.realpath(_VENV_PY)):
        os.execv(_VENV_PY, [_VENV_PY, os.path.abspath(__file__)] + sys.argv[1:])
    PyiCloudService = None  # iCloud commands fail in get_api(); the app and DB paths still work

_INST = places_local.instance()
OWNER_NAME = _INST.get("owner_name") or "the user"
OWNER_ID = _INST.get("owner_id") or "user"
CFG = places_local.local_config("findme", {
    "icloud_account": "", "people": {}, "primary_devices": {}, "device_overrides": {},
    "companion_people": [], "generic_place_names": [],
})


def _home_tz():
    """The installation's home zone (instance tz), else the host's."""
    tz = _INST.get("tz")
    try:
        return ZoneInfo(tz) if tz else datetime.now().astimezone().tzinfo
    except Exception:
        return datetime.now().astimezone().tzinfo


LOCAL_TZ = _home_tz()


def _now_utc():
    return datetime.now(timezone.utc)


def _parse_iso(value):
    """Parse an ISO timestamp to an aware UTC datetime, or None if unusable.

    Returning None for a missing/garbage stamp matters: callers treat "cannot
    date this" as "too old to trust" rather than as "fresh", which is the safe
    direction for anything deciding whether a queued question may still absorb
    one of the user's replies.
    """
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except (ValueError, TypeError):
        return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)

ICLOUD_ACCOUNT = CFG.get("icloud_account") or _INST.get("owner_email") or ""
ENV_FILE = os.path.join(places_local.install_root(), ".env")
import place_naming as _place_naming  # noqa: E402
SUPABASE_URL = _place_naming.SUPABASE_URL  # SUPABASE_URL, else the instance's supabase_project
def _read_env_var(name):
    if os.path.exists(ENV_FILE):
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if line.startswith(f"{name}="):
                    return line.split("=", 1)[1]
    return None
def _read_op_secret(ref):
    # Only attempt op CLI when a service-account token is present. Without it,
    # `op read` falls back to interactive auth, which on a headless host (no
    # Touch ID) pops a master-password prompt — every cron tick. .env is the primary
    # source; op is bootstrap/rotation only.
    if not os.environ.get("OP_SERVICE_ACCOUNT_TOKEN"):
        return None
    try:
        return subprocess.run(["op", "read", ref], capture_output=True, text=True, check=False).stdout.strip() or None
    except FileNotFoundError:
        return None
def _log_secret_failure(secret_name, reason):
    # Append-only JSONL, daily-deduped per (script, secret). Never raises.
    try:
        from datetime import datetime, timezone
        log_path = places_local.data_path("secret-failures.jsonl")
        now = datetime.now(timezone.utc)
        today = now.strftime("%Y-%m-%d")
        if os.path.exists(log_path):
            with open(log_path) as f:
                for line in f.readlines()[-50:]:
                    try:
                        r = json.loads(line)
                        if (r.get("script") == "findme"
                            and r.get("secret") == secret_name
                            and r.get("ts", "").startswith(today)):
                            return
                    except Exception:
                        continue
        record = {
            "ts": now.isoformat(timespec="seconds").replace("+00:00", "Z"),
            "script": "findme",
            "secret": secret_name,
            "reason": reason,
        }
        with open(log_path, "a") as f:
            f.write(json.dumps(record) + "\n")
    except Exception:
        pass
GOOGLE_PLACES_API_KEY = (
    os.environ.get("GOOGLE_PLACES_API_KEY")
    or _read_env_var("GOOGLE_PLACES_API_KEY")
    or (_read_op_secret(os.environ["JORI_PLACES_OP_REF"]) if os.environ.get("JORI_PLACES_OP_REF") else None)
)
if not GOOGLE_PLACES_API_KEY:
    _log_secret_failure(
        "GOOGLE_PLACES_API_KEY",
        "no env var, no .env entry, no SA token"
        if not os.environ.get("OP_SERVICE_ACCOUNT_TOKEN")
        else "no env var, no .env entry; SA token present but op read returned empty",
    )
PENDING_ENRICH_FILE = places_local.data_path("location-pending-enrich.json")
# Stops the resolver drops because Google Places returned zero candidates
# are appended here as one JSONL row each. Surfaces what used to be silent
# gaps (a real supermarket stop missed). Read by
# daily-summary / live-day to render "stop @ lat,lon — unresolved" instead
# of pretending nothing happened.
ENRICH_DROPPED_FILE = places_local.data_path("location-enrich-dropped.jsonl")

# Shared Places-API disk cache (also used by bin/location-segment).
# 7-day TTL — venues don't churn that fast and the resolver only hits Places
# for stops not yet user-confirmed. Without this, every enrich tick re-Places'd
# the same unresolved visits. (2026-05-11)
import hashlib
import time
PLACES_CACHE_DIR = places_local.data_path(".cache", "google-places")
PLACES_CACHE_TTL_SEC = 7 * 24 * 3600


def _places_blocked():
    """True when the Jori Places budget is spent. Never raises: findme runs
    under its own venv and on the location hot path, so a missing or malformed
    guard must read as 'not blocked'."""
    try:
        from places_guard import places_block_reason

        return places_block_reason() is not None
    except Exception:
        return False

def _places_cache_key(prefix, lat, lon, radius_m, max_results, query=""):
    lat_r = round(lat, 4)
    lon_r = round(lon, 4)
    rad_r = int(radius_m / 20) * 20
    raw = f"{prefix}|{lat_r}|{lon_r}|{rad_r}|{max_results}|{query}"
    return hashlib.md5(raw.encode("utf-8")).hexdigest()[:16]

def _places_cache_get(key):
    path = os.path.join(PLACES_CACHE_DIR, f"{key}.json")
    try:
        if not os.path.exists(path):
            return None
        if time.time() - os.path.getmtime(path) > PLACES_CACHE_TTL_SEC:
            return None
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None

def _places_cache_set(key, results):
    try:
        os.makedirs(PLACES_CACHE_DIR, exist_ok=True)
        path = os.path.join(PLACES_CACHE_DIR, f"{key}.json")
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(results, f)
        os.replace(tmp, path)
    except Exception:
        pass

# Known person → prsId mapping (None = the account owner, the user). The family
# members Find My shares come from config `people`.
KNOWN_PEOPLE = {None: OWNER_NAME, **(CFG.get("people") or {})}

# Primary device per person (used for "where is <person>"): a keyword of the
# device name, by lower-case person name. The user's own default is their
# owner id ("<owner_id>'s iPhone").
PRIMARY_DEVICES = {OWNER_NAME.lower(): OWNER_ID, **{str(k).lower(): v for k, v in (CFG.get("primary_devices") or {}).items()}}
# What a query for the user themself reads as.
OWNER_QUERIES = {"me", OWNER_ID.lower(), OWNER_NAME.lower()}

# Named locations — matched by proximity (within 150m). Homes and family homes,
# read from data/named-locations.json, the one list place_naming and
# resolve-day read too (this was once a second literal copy, and missed a
# family home the other list had).
def _load_named_locations():
    path = places_local.data_path("named-locations.json")
    try:
        with open(path) as f:
            d = json.load(f)
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as e:
        print(f"[findme] named-locations.json unreadable: {e}", file=sys.stderr)
        return []
    items = d.get("entries") if isinstance(d, dict) else d
    return [e for e in (items or []) if isinstance(e, dict) and e.get("name")
            and isinstance(e.get("lat"), (int, float)) and isinstance(e.get("lon"), (int, float))]

NAMED_LOCATIONS = _load_named_locations()

def match_named_location(lat, lon, threshold_km=0.15):
    """Return named location if within threshold, else None."""
    for loc in NAMED_LOCATIONS:
        dist = haversine_km(lat, lon, loc["lat"], loc["lon"])
        if dist <= threshold_km:
            return loc
    return None

def _get_password():
    """Get iCloud password from .env file, then keychain."""
    if os.path.exists(ENV_FILE):
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if line.startswith("ICLOUD_PASS="):
                    return line.split("=", 1)[1]
    try:
        return subprocess.check_output(
            ["security", "find-generic-password", "-s", "pyicloud", "-a", ICLOUD_ACCOUNT, "-w"],
            stderr=subprocess.DEVNULL
        ).decode().strip()
    except Exception:
        return None

def _get_supabase_key():
    """Get Supabase service role key from .env."""
    if os.path.exists(ENV_FILE):
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if line.startswith("SUPABASE_SERVICE_ROLE_KEY="):
                    return line.split("=", 1)[1]
    return None

def _get_owner_location_from_app():
    """Get the user's location from the Jori app via Supabase.

    Queries the most recent user message with location metadata.
    Returns dict with lat, lon, ts (epoch ms), accuracy, timezone — or None.
    """
    key = _get_supabase_key()
    if not key:
        return None
    try:
        # Fetch most recent user message (the user's messages have location in metadata)
        url = (
            f"{SUPABASE_URL}/rest/v1/jori_messages"
            "?role=eq.user"
            "&order=created_at.desc"
            "&limit=1"
            "&select=metadata,created_at"
        )
        req = urllib.request.Request(url, headers={
            "apikey": key,
            "Authorization": f"Bearer {key}",
            "Accept": "application/json",
        })
        with urllib.request.urlopen(req, timeout=5) as resp:
            rows = json.loads(resp.read())
        if not rows:
            return None
        meta = rows[0].get("metadata") or {}
        lat = meta.get("latitude")
        lon = meta.get("longitude")
        if not lat or not lon:
            return None
        # Parse the location timestamp if available, else use message created_at
        loc_ts_str = meta.get("location_timestamp")
        if loc_ts_str:
            try:
                loc_dt = datetime.fromisoformat(loc_ts_str.replace("Z", "+00:00"))
                ts_ms = int(loc_dt.timestamp() * 1000)
            except Exception:
                ts_ms = int(datetime.fromisoformat(rows[0]["created_at"].replace("Z", "+00:00")).timestamp() * 1000)
        else:
            ts_ms = int(datetime.fromisoformat(rows[0]["created_at"].replace("Z", "+00:00")).timestamp() * 1000)
        return {
            "lat": float(lat),
            "lon": float(lon),
            "ts": ts_ms,
            "accuracy": meta.get("location_accuracy", "unknown"),
            "timezone": meta.get("timezone") or _INST.get("tz") or "UTC",
            "source": "gandalf-app",
        }
    except Exception:
        return None

def get_api():
    if PyiCloudService is None:
        print("ERROR: pyicloud is not installed (agent/findmy-venv)", file=sys.stderr)
        sys.exit(1)
    if not ICLOUD_ACCOUNT:
        print("ERROR: no Find My account (config findme icloud_account or instance owner_email)", file=sys.stderr)
        sys.exit(1)
    password = _get_password()
    try:
        api = PyiCloudService(ICLOUD_ACCOUNT, password=password, with_family=True)
        # Don't check requires_2fa — it's unreliable when password is provided.
        # Instead, try to access devices directly. If session is truly invalid, it'll throw.
        try:
            _ = api.devices
        except Exception:
            print("ERROR: iCloud session expired. Run: icloud --username " + ICLOUD_ACCOUNT + " --locate", file=sys.stderr)
            sys.exit(1)
        return api
    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

def owner_name(prs_id):
    return KNOWN_PEOPLE.get(prs_id, prs_id or "Unknown")

def format_time(ts):
    if not ts:
        return "?"
    try:
        dt = datetime.fromtimestamp(ts / 1000)
        now = datetime.now()
        diff = now - dt
        mins = int(diff.total_seconds() / 60)
        if mins < 1:
            return "just now"
        if mins < 60:
            return f"{mins}m ago"
        hours = mins // 60
        if hours < 24:
            return f"{hours}h ago"
        return dt.strftime("%b %d %H:%M")
    except:
        return "?"

def haversine_km(lat1, lon1, lat2, lon2):
    R = 6371
    dlat = math.radians(lat2 - lat1)
    dlon = math.radians(lon2 - lon1)
    a = math.sin(dlat/2)**2 + math.cos(math.radians(lat1)) * math.cos(math.radians(lat2)) * math.sin(dlon/2)**2
    return R * 2 * math.asin(math.sqrt(a))

def reverse_geocode(lat, lon, structured=False):
    """Best-effort reverse geocode using Nominatim."""
    try:
        import urllib.request
        url = f"https://nominatim.openstreetmap.org/reverse?lat={lat}&lon={lon}&format=json&zoom=18&addressdetails=1"
        req = urllib.request.Request(url, headers={"User-Agent": "findme-cli/1.0"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read())
            addr = data.get("address", {})
            house = addr.get("house_number", "")
            road = addr.get("road", "")
            neighbourhood = addr.get("neighbourhood") or addr.get("suburb") or addr.get("quarter", "")
            city = addr.get("city") or addr.get("town") or addr.get("village", "")
            state = addr.get("state", "")
            country = addr.get("country", "")
            postcode = addr.get("postcode", "")
            # Build street address
            street = f"{house} {road}".strip() if road else ""
            if structured:
                result = {}
                if street: result["address"] = street
                if neighbourhood: result["neighbourhood"] = neighbourhood
                if city: result["city"] = city
                if state: result["state"] = state
                if postcode: result["postcode"] = postcode
                if country and country not in ("United States", "United States of America"):
                    result["country"] = country
                return result
            # Build short location string
            parts = [p for p in [city, state] if p]
            if country and country not in ("United States", "United States of America"):
                parts.append(country)
            return ", ".join(parts) if parts else f"{lat:.4f},{lon:.4f}"
    except:
        if structured:
            return {"address": f"{lat:.4f},{lon:.4f}"}
        return f"{lat:.4f},{lon:.4f}"

# Override owner/name for specific devices (by device ID prefix): a family
# member's device on the user's account, a spare phone kept at home as a
# controller. Config `device_overrides`.
DEVICE_OVERRIDES = dict(CFG.get("device_overrides") or {})

def norm(s):
    """Normalize curly quotes to ASCII for matching."""
    return s.replace("\u2018", "'").replace("\u2019", "'").replace("\u201c", '"').replace("\u201d", '"').lower()

def device_label(d):
    """Format device label avoiding "Sam's Sam's iPhone"."""
    name = d["name"]
    owner = d["owner"]
    if norm(owner) in norm(name):
        return name
    return f"{owner}'s {name}"

def get_devices(api):
    """Get all devices with location, grouped by owner."""
    results = []
    for dev in api.devices:
        c = dev._content
        loc = c.get("location")
        if not loc or not loc.get("latitude"):
            continue
        dev_id = c.get("id", "")
        override = next((v for k, v in DEVICE_OVERRIDES.items() if dev_id.startswith(k)), None)
        entry = {
            "name": c.get("name", "?"),
            "model": c.get("deviceDisplayName", c.get("modelDisplayName", "?")),
            "class": c.get("deviceClass", "?"),
            "owner": owner_name(c.get("prsId")),
            "prsId": c.get("prsId"),
            "lat": loc["latitude"],
            "lon": loc["longitude"],
            "ts": loc.get("timeStamp", 0),
            "battery": c.get("batteryLevel", -1),
            "batteryStatus": c.get("batteryStatus", ""),
            "fmlyShare": c.get("fmlyShare", False),
        }
        if override:
            if "owner" in override:
                entry["owner"] = override["owner"]
            if "name" in override:
                entry["name"] = override["name"]
        results.append(entry)
    return results

def _owner_device_from_app(app_loc):
    """Convert Jori app location to a device-like dict for unified output."""
    return {
        "name": "Jori App (iPhone)",
        "model": "iPhone",
        "class": "iPhone",
        "owner": OWNER_NAME,
        "prsId": None,
        "lat": app_loc["lat"],
        "lon": app_loc["lon"],
        "ts": app_loc["ts"],
        "battery": -1,
        "batteryStatus": "",
        "fmlyShare": False,
        "_source": "gandalf-app",
    }

def cmd_locate(args, as_json=False):
    """Locate a person or device."""
    query = " ".join(args).lower().strip() if args else ""

    # For the user specifically, try the Jori app first (live GPS from phone)
    owner_from_app = None
    if not query or query in OWNER_QUERIES | {"all", ""}:
        app_loc = _get_owner_location_from_app()
        if app_loc:
            owner_from_app = _owner_device_from_app(app_loc)

    # For the user only — return app location without hitting iCloud at all
    if query in OWNER_QUERIES and owner_from_app:
        matched = [owner_from_app]
        _print_devices(matched, as_json)
        return

    api = get_api()
    devices = get_devices(api)

    if not query or query in OWNER_QUERIES | {"all"}:
        # Show primary device per person
        if query == "all":
            matched = devices
        else:
            matched = []
            seen_owners = set()

            # Use Jori app location for the user if available
            if owner_from_app:
                matched.append(owner_from_app)
                seen_owners.add(OWNER_NAME.lower())

            for d in devices:
                owner = d["owner"].lower()
                if owner in seen_owners:
                    continue
                prim = PRIMARY_DEVICES.get(owner)
                if prim and prim in norm(d["name"]) and d["class"] == "iPhone":
                    matched.append(d)
                    seen_owners.add(owner)
            # Add any owners we haven't seen yet (pick first iPhone)
            for d in devices:
                owner = d["owner"].lower()
                if owner not in seen_owners and d["class"] == "iPhone":
                    matched.append(d)
                    seen_owners.add(owner)
    else:
        # Search by person name or device name
        matched = [d for d in devices if query in norm(d["name"]) or query in d["owner"].lower()]
        if not matched:
            matched = [d for d in devices if any(w in norm(d["name"]) or w in d["owner"].lower() for w in query.split())]

    if not matched:
        if as_json:
            print(json.dumps({"error": f"No device found matching '{query}'"}))
        else:
            print(f"No device found matching '{query}'")
        return

    _print_devices(matched, as_json)

def _print_devices(matched, as_json=False):
    """Print device location results in human or JSON format."""
    if as_json:
        out = []
        for d in matched:
            named = match_named_location(d["lat"], d["lon"])
            if named:
                geo = {"address": named.get("address") or "", "place": named["name"]}
            else:
                geo = reverse_geocode(d["lat"], d["lon"], structured=True)
            entry = {
                "name": d["name"],
                "model": d["model"],
                "owner": d["owner"],
                "lat": d["lat"],
                "lon": d["lon"],
                "updated": format_time(d["ts"]),
                "battery": f"{d['battery']:.0%}" if d["battery"] >= 0 else None,
                "source": d.get("_source", "findmy"),
            }
            entry.update(geo)
            out.append(entry)
        print(json.dumps(out, indent=2))
    else:
        for d in matched:
            loc_str = reverse_geocode(d["lat"], d["lon"])
            bat = f" ({d['battery']:.0%} battery)" if d["battery"] >= 0 else ""
            age = format_time(d["ts"])
            source = " [via Jori app]" if d.get("_source") == "gandalf-app" else ""
            label = device_label(d)
            print(f"{label} ({d['model']})")
            print(f"  {loc_str} — {age}{bat}{source}")
            print()

def cmd_near(args, as_json=False):
    """Find devices near a location or near each other."""
    api = get_api()
    devices = get_devices(api)
    # Group by owner, pick primary or first iPhone
    people = {}
    # Use Jori app for the user first
    app_loc = _get_owner_location_from_app()
    if app_loc:
        people[OWNER_NAME] = _owner_device_from_app(app_loc)
    for d in devices:
        owner = d["owner"]
        if owner in people:
            continue
        prim = PRIMARY_DEVICES.get(owner.lower(), "")
        if owner not in people or (prim and prim.lower() in d["name"].lower()):
            people[owner] = d

    results = []
    owners = list(people.values())
    for i, a in enumerate(owners):
        for b in owners[i+1:]:
            dist = haversine_km(a["lat"], a["lon"], b["lat"], b["lon"])
            results.append((a["owner"], b["owner"], dist))

    results.sort(key=lambda x: x[2])
    if as_json:
        print(json.dumps([{"a": a, "b": b, "distance_km": round(d, 1)} for a, b, d in results], indent=2))
    else:
        for a, b, dist in results:
            if dist < 1:
                print(f"{a} and {b}: {dist*1000:.0f}m apart")
            else:
                print(f"{a} and {b}: {dist:.1f}km apart")

def cmd_list(as_json=False):
    """List all devices."""
    api = get_api()
    devices = get_devices(api)
    if as_json:
        print(json.dumps([{
            "name": d["name"], "model": d["model"], "owner": d["owner"],
            "lat": d["lat"], "lon": d["lon"], "updated": format_time(d["ts"]),
            "battery": f"{d['battery']:.0%}" if d["battery"] >= 0 else None,
        } for d in devices], indent=2))
    else:
        by_owner = {}
        for d in devices:
            by_owner.setdefault(d["owner"], []).append(d)
        for owner, devs in sorted(by_owner.items()):
            print(f"{owner}:")
            for d in devs:
                age = format_time(d["ts"])
                bat = f" {d['battery']:.0%}" if d["battery"] >= 0 else ""
                print(f"  {d['name']} ({d['model']}) — {age}{bat}")
            print()

def _parse_date_range(args):
    """Parse date args into (start_iso, end_iso) for Supabase query."""
    from datetime import timedelta
    today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)

    if not args or args[0].lower() == "today":
        start = today
    elif args[0].lower() == "yesterday":
        start = today - timedelta(days=1)
    else:
        try:
            start = datetime.strptime(args[0], "%Y-%m-%d")
        except ValueError:
            start = today

    end = start + timedelta(days=1)
    return start.isoformat() + "Z", end.isoformat() + "Z"

def _query_location_history(start_iso, end_iso):
    """Query Supabase location_history for a date range."""
    key = _get_supabase_key()
    if not key:
        print("ERROR: No Supabase key", file=sys.stderr)
        sys.exit(1)
    try:
        url = (
            f"{SUPABASE_URL}/rest/v1/location_history"
            f"?arrived_at=gte.{start_iso}"
            f"&arrived_at=lte.{end_iso}"
            f"&order=arrived_at.asc"
            f"&select=*"
        )
        req = urllib.request.Request(url, headers={
            "apikey": key,
            "Authorization": f"Bearer {key}",
            "Accept": "application/json",
        })
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read())
    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return []

MOVEMENT_EVIDENCE_PAD_MIN = 10  # widen the raw-sample query beyond the exact
# visit boundary -- sparse GPS (5-20 min gaps between pings is normal) routinely
# lands the samples that would reveal drift just outside [arrived_at, departed_at],
# starving the check of the evidence it exists to find (2026-07-24: a 24-min
# Chatelaillon market stop had exactly 1 raw sample inside its own boundary --
# the other 3 landed 10s-5min outside it -- so len(samples) < 3 returned None and
# the ask went out as a confident bakery/lunch hypothesis with no "just walking
# around" option, even though the raw track showed ~200m of drift at ~0.5 km/h).

MOVEMENT_EVIDENCE_BROWSE_RADIUS_M = 60.0  # absolute GPS drift from the sample
# centroid, NOT a radius/duration ratio like location-segment's dwell/browse
# split. A slow multi-stop wander (market stalls, browsing shopfronts) keeps
# roughly the same physical footprint the longer it runs, so a ratio actively
# UNDERweights long slow wanders -- the Chatelaillon case above ratios to
# ~4.4 m/min, under location-segment's 5.0 m/min browse cutoff, despite the user
# confirming it was pure wandering. 60m sits comfortably above the ~15-40m
# accuracy_m these samples typically report, so it flags real movement, not
# GPS noise around a single fixed table.

def _movement_evidence(arrived_at, departed_at, visit_id=None):
    """Independent GPS-sample check for a visit window, used to keep
    findme enrich from asking about a "stop" that was actually continuous
    movement (2026-07-22: a 15-min walk on Ile-d'Aix was queued as a stop,
    and the location-enrich playbook then invented an unsupported "waiting
    for the ferry" narrative around it). Looks at raw breadcrumb rows
    inside a window padded by MOVEMENT_EVIDENCE_PAD_MIN around
    [arrived_at, departed_at] and reports the dominant on-device `activity`,
    total path length, and spatial drift (`cluster_radius_m` / `pattern`:
    "browse" when the drift or activity signal says wandering, else
    "dwell"). Returns None when there's too little raw-sample signal to say
    anything -- callers must treat that as "no evidence either way", never
    as confirmation of a stationary stop.
    """
    from datetime import timedelta
    try:
        arr_dt = datetime.fromisoformat(arrived_at.replace("Z", "+00:00"))
        dep_dt = datetime.fromisoformat(departed_at.replace("Z", "+00:00"))
    except Exception:
        return None
    pad = timedelta(minutes=MOVEMENT_EVIDENCE_PAD_MIN)
    try:
        rows = _query_location_history(
            (arr_dt - pad).isoformat().replace("+00:00", "Z"),
            (dep_dt + pad).isoformat().replace("+00:00", "Z"),
        )
    except Exception:
        return None
    # Exclude only the visit row being evaluated, not every segment_type="visit"
    # row in the padded window. A slow wander routinely logs several short
    # ADJACENT visit rows (2026-07-24: the Chatelaillon window had a second,
    # 1-min "visit" 10s after the target's departed_at) -- blanket-excluding
    # segment_type=="visit" threw those samples away too, leaving only 2 raw
    # points and tripping the len(samples) < 3 floor right back into None.
    # When visit_id isn't given (e.g. ad-hoc CLI use), fall back to the old
    # blanket exclusion.
    samples = [
        r for r in rows
        if (r.get("id") != visit_id if visit_id else r.get("segment_type") != "visit")
        and r.get("activity") and r.get("latitude") is not None
    ]
    if len(samples) < 3:
        return None
    samples.sort(key=lambda r: r.get("arrived_at") or "")
    activities = [s["activity"] for s in samples]
    dominant_activity = max(set(activities), key=activities.count)
    path_m = 0.0
    for i in range(1, len(samples)):
        path_m += haversine_km(
            samples[i - 1]["latitude"], samples[i - 1]["longitude"],
            samples[i]["latitude"], samples[i]["longitude"],
        ) * 1000
    try:
        dur_min = (dep_dt - arr_dt).total_seconds() / 60
    except Exception:
        dur_min = None
    avg_speed_kmh = round((path_m / 1000) / (dur_min / 60), 1) if dur_min else None
    clat = sum(s["latitude"] for s in samples) / len(samples)
    clon = sum(s["longitude"] for s in samples) / len(samples)
    cluster_radius_m = max(
        (haversine_km(clat, clon, s["latitude"], s["longitude"]) * 1000 for s in samples),
        default=0.0,
    )
    is_browse = (
        cluster_radius_m > MOVEMENT_EVIDENCE_BROWSE_RADIUS_M
        or dominant_activity in ("walking", "running", "cycling", "driving")
    )
    return {
        "dominant_activity": dominant_activity,
        "sample_count": len(samples),
        "path_length_m": round(path_m),
        "avg_speed_kmh": avg_speed_kmh,
        "cluster_radius_m": round(cluster_radius_m),
        "pattern": "browse" if is_browse else "dwell",
    }

def _ask_gate(v, dry_run=False):
    """bin/ask-gate's verdict for visit `v`: may we ask about it yet?

    Refuses a slice of a stay he never left (`same-stay`, marked non-stop
    unless dry_run) and a stop with no point away from it since it ended
    (`no-departure`, left alone and re-judged next run). Raw fixes, not rows.
    Fail-open: any error returns {"ask": True}.
    """
    cmd = [os.path.join(os.path.dirname(os.path.abspath(__file__)), "ask-gate"),
           "--visit", v["id"], "--json"]
    if not dry_run:
        cmd.append("--apply")
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=45)
        return json.loads(out.stdout or "{}") or {"ask": True}
    except Exception as e:
        print(f"[findme enrich] ask-gate failed for {v['id'][:8]}: {e}", file=sys.stderr)
        return {"ask": True}

def _passage_check(v, dry_run=False):
    """Ask bin/stop-passage whether visit `v` was a stop at all.

    Returns the verdict dict when it was a PASSAGE (part of a walk), else None.
    With dry_run the row is left alone; otherwise stop-passage marks it
    non-stop itself, so both ask paths share one writer. Fail-open: any error,
    timeout or non-passage verdict returns None and the caller asks as before.
    """
    cmd = [os.path.join(os.path.dirname(os.path.abspath(__file__)), "stop-passage"),
           "--visit", v["id"], "--json"]
    if not dry_run:
        cmd.append("--apply")
    try:
        # 150 s: the phone photo probe waits up to 30 s and the evidence step
        # may make one model call (stop-passage header).
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=150)
        res = json.loads(out.stdout or "{}")
    except Exception as e:
        print(f"[findme enrich] stop-passage failed for {v['id'][:8]}: {e}", file=sys.stderr)
        return None
    # `calendar` (named from his calendar), `evidence` (he already said or
    # showed where he was) and `hold` (waiting on the phone's or the library's
    # photos) are not questions either — see stop-passage's header.
    if res.get("verdict") in ("calendar", "evidence", "hold"):
        return res
    if res.get("verdict") != "passage":
        return None
    if not dry_run and not res.get("applied"):
        return None  # not written (protected row) — leave it to the normal path
    return res

def _interpret_segments(segments):
    """Interpret raw segments into a narrative timeline.

    Groups transit waypoints between visits, infers transport mode from
    distance/speed, calculates durations, and produces a list of events:
      [{type: "stay", place, arrived, departed, duration_min, city}, ...]
      [{type: "travel", mode, from_place, to_place, departed, arrived, distance_km, duration_min}, ...]
    """
    from datetime import timedelta

    # Separate visits and transits
    visits = [s for s in segments if s.get("segment_type") == "visit"]
    if not visits:
        return []

    # Drop visits confirmed as non-stops (data blips / brief pauses the user rejected)
    visits = [v for v in visits if v.get("place_type") != "non-stop"]
    if not visits:
        return []

    events = []
    for i, v in enumerate(visits):
        # Add a travel event between consecutive visits
        if i > 0:
            prev = visits[i - 1]
            prev_lat, prev_lon = prev["latitude"], prev["longitude"]
            curr_lat, curr_lon = v["latitude"], v["longitude"]
            dist = haversine_km(prev_lat, prev_lon, curr_lat, curr_lon)

            # Travel time: from previous departure to current arrival
            try:
                dep_dt = datetime.fromisoformat((prev.get("departed_at") or prev["arrived_at"]).replace("Z", "+00:00"))
                arr_dt = datetime.fromisoformat(v["arrived_at"].replace("Z", "+00:00"))
                travel_min = max(0, (arr_dt - dep_dt).total_seconds() / 60)
            except:
                travel_min = 0

            # Collect transit waypoints between these two visits for activity info
            transit_activities = []
            for t in segments:
                if t.get("segment_type") != "transit":
                    continue
                try:
                    t_dt = datetime.fromisoformat(t["arrived_at"].replace("Z", "+00:00"))
                    if dep_dt <= t_dt <= arr_dt and t.get("activity"):
                        transit_activities.append(t["activity"])
                except:
                    pass

            # Infer transport mode
            dominant_activity = max(set(transit_activities), key=transit_activities.count) if transit_activities else "unknown"
            if dist < 0.5:
                mode = "walked"
            elif dist < 2 and dominant_activity == "walking":
                mode = "walked"
            elif dist > 50:
                # Long distance — could be train, flight, or long drive
                speed_kmh = dist / (travel_min / 60) if travel_min > 0 else 0
                if speed_kmh > 200:
                    mode = "flew"
                elif speed_kmh > 80:
                    mode = "took the train"  # faster than typical driving
                else:
                    mode = "drove"
            elif dominant_activity == "walking":
                mode = "walked"
            elif dominant_activity in ("driving", "unknown"):
                mode = "drove"
            elif dominant_activity == "cycling":
                mode = "cycled"
            elif dominant_activity == "running":
                mode = "ran"
            else:
                mode = "traveled"

            from_place = prev.get("place_name") or prev.get("address") or f"{prev_lat:.4f},{prev_lon:.4f}"
            to_place = v.get("place_name") or v.get("address") or f"{curr_lat:.4f},{curr_lon:.4f}"

            events.append({
                "type": "travel",
                "mode": mode,
                "from_place": from_place,
                "to_place": to_place,
                "departed": prev.get("departed_at") or prev["arrived_at"],
                "arrived": v["arrived_at"],
                "distance_km": round(dist, 1),
                "duration_min": round(travel_min),
            })

        # Add the visit as a stay event
        place = v.get("place_name") or v.get("address") or f"{v['latitude']:.4f},{v['longitude']:.4f}"
        try:
            arr_dt = datetime.fromisoformat(v["arrived_at"].replace("Z", "+00:00"))
            if v.get("departed_at"):
                dep_dt = datetime.fromisoformat(v["departed_at"].replace("Z", "+00:00"))
                dur_min = (dep_dt - arr_dt).total_seconds() / 60
            else:
                dur_min = (datetime.now(arr_dt.tzinfo) - arr_dt).total_seconds() / 60
        except:
            dur_min = 0

        events.append({
            "type": "stay",
            "place": place,
            "arrived": v["arrived_at"],
            "departed": v.get("departed_at"),
            "duration_min": round(dur_min),
            "city": v.get("city", ""),
            "place_type": v.get("place_type", ""),
            "companions": v.get("companions") or [],
        })

    return events

def _format_duration(minutes):
    """Format minutes as 'Xh Ym' or 'Ym'."""
    if minutes < 1:
        return "<1m"
    h = int(minutes // 60)
    m = int(minutes % 60)
    if h > 0 and m > 0:
        return f"{h}h {m}m"
    elif h > 0:
        return f"{h}h"
    else:
        return f"{m}m"

def _format_distance(km):
    """Format distance in miles."""
    mi = km * 0.621371
    if mi < 0.1:
        return ""
    if mi < 1:
        return f"{mi:.1f} mi"
    return f"{mi:.0f} mi"

def cmd_history(args, as_json=False):
    """Show location history timeline."""
    # Check for --narrative flag
    narrative = "--narrative" in args
    if narrative:
        args = [a for a in args if a != "--narrative"]

    start_iso, end_iso = _parse_date_range(args)
    segments = _query_location_history(start_iso, end_iso)

    if not segments:
        if as_json:
            print(json.dumps({"segments": [], "events": [], "summary": "No location data for this date."}))
        else:
            print("No location data for this date.")
        return

    events = _interpret_segments(segments)

    if as_json:
        print(json.dumps({
            "segments": segments,
            "events": events,
            "date": args[0] if args else "today",
        }, indent=2))
        return

    # Human-readable timeline
    date_label = args[0].capitalize() if args else "Today"
    print(f"{date_label}'s Timeline:")
    print()

    total_walked_km = 0
    total_traveled_km = 0
    places_visited = set()

    for ev in events:
        if ev["type"] == "stay":
            # Format: "  09:45 - 11:20  Blue Bottle Coffee [1h 35m]"
            try:
                arr = datetime.fromisoformat(ev["arrived"].replace("Z", "+00:00")).astimezone(LOCAL_TZ).strftime("%H:%M")
            except:
                arr = "?"
            if ev.get("departed"):
                try:
                    dep = datetime.fromisoformat(ev["departed"].replace("Z", "+00:00")).astimezone(LOCAL_TZ).strftime("%H:%M")
                except:
                    dep = "?"
            else:
                dep = "now  "
            dur = _format_duration(ev["duration_min"])
            companions = ev.get("companions") or []
            comp_str = f" with {', '.join(companions)}" if companions else ""
            print(f"  {arr} - {dep}  {ev['place']}{comp_str}  [{dur}]")
            places_visited.add(ev["place"])

        elif ev["type"] == "travel":
            # Format: "     └─ walked 10m (0.3 mi)"  or  "     └─ drove 25m (12 mi)"
            dur = _format_duration(ev["duration_min"])
            dist = _format_distance(ev["distance_km"])
            dist_str = f" ({dist})" if dist else ""
            print(f"     └─ {ev['mode']} {dur}{dist_str}")

            if ev["mode"] == "walked":
                total_walked_km += ev["distance_km"]
            total_traveled_km += ev["distance_km"]

    print()
    walked_mi = total_walked_km * 0.621371
    traveled_mi = total_traveled_km * 0.621371
    parts = [f"{len(places_visited)} places"]
    if walked_mi > 0.1:
        parts.append(f"{walked_mi:.1f} mi walked")
    if traveled_mi > walked_mi + 0.5:
        parts.append(f"{traveled_mi:.0f} mi total travel")
    print(f"  Summary: {', '.join(parts)}")

def cmd_activity(args, as_json=False):
    """Show current activity (what the user is doing right now)."""
    key = _get_supabase_key()
    if not key:
        print("ERROR: No Supabase key", file=sys.stderr)
        sys.exit(1)
    try:
        # Query most recent segment (open visit preferred)
        url = (
            f"{SUPABASE_URL}/rest/v1/location_history"
            "?order=arrived_at.desc"
            "&limit=1"
            "&select=*"
        )
        req = urllib.request.Request(url, headers={
            "apikey": key,
            "Authorization": f"Bearer {key}",
            "Accept": "application/json",
        })
        with urllib.request.urlopen(req, timeout=10) as resp:
            rows = json.loads(resp.read())
    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return

    if not rows:
        msg = "No location data available."
        if as_json:
            print(json.dumps({"status": "unknown", "message": msg}))
        else:
            print(msg)
        return

    seg = rows[0]
    place = seg.get("place_name") or seg.get("address") or f"{seg['latitude']:.4f},{seg['longitude']:.4f}"
    activity = seg.get("activity", "unknown")
    arrived = seg.get("arrived_at", "")
    departed = seg.get("departed_at")

    try:
        arr_dt = datetime.fromisoformat(arrived.replace("Z", "+00:00"))
        age = format_time(int(arr_dt.timestamp() * 1000))
    except:
        age = "?"

    if as_json:
        print(json.dumps(seg, indent=2))
    else:
        status = activity.capitalize()
        if seg.get("segment_type") == "visit" and not departed:
            print(f"{status} at {place} since {age}")
        elif seg.get("segment_type") == "transit":
            print(f"{status} (in transit) since {age}")
        else:
            print(f"Last known: {status} at {place} ({age})")

