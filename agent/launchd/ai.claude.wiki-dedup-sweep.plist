<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Monthly full-corpus wiki duplicate sweep (the 6th at 02:20 local).
  Playbook / rationale: agent/ops-agent/jobs/wiki-dedup-sweep.md

  A launchd USER agent, not crontab, and not a webhook dispatch either — for two
  separate reasons:

  1. KEYCHAIN. The sweep forks one `claude -p` per cluster to judge it. A
     cron-launched `claude -p` runs outside the Aqua session, cannot unlock the
     login keychain holding the Max credentials, prints "Not logged in" and
     exits 0. Same constraint that moved the improvement family
     here (see run-ephemeral-opus.sh's header, and the 2026-07-02 miss).

  2. NO AGENT TURN TO EARN. The first wiring went cron -> webhook -> ops-agent
     turn -> job-run, copying the shape of jobs that need an agent to reason.
     This one does not: the playbook's entire instruction was "run this command
     and ack." Two live dispatches (2026-07-29) cost ~$0.65 each in Sonnet turns
     to type one bash line, and the second turn decided on its own not to run it
     at all. A binary that emails its own report needs no agent in front of it.

  Install:
    render it (never cp: the paths are __JORI_TOOLS__ / __HOME__ placeholders):
    source agent/scripts/lib/launchd-render.sh
    launchd_render_plist agent/launchd/ai.claude.wiki-dedup-sweep.plist ~/Library/LaunchAgents/ai.claude.wiki-dedup-sweep.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.claude.wiki-dedup-sweep.plist
  Run once, now:
    launchctl kickstart -k gui/$(id -u)/ai.claude.wiki-dedup-sweep
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.claude.wiki-dedup-sweep</string>
    <key>ProgramArguments</key>
    <array>
        <string>__JORI_TOOLS__/bin/wiki-dedup-sweep</string>
        <string>run</string>
        <string>--email</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__JORI_TOOLS__/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__JORI_TOOLS__/agent/ops-agent</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>6</integer>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__JORI_TOOLS__/data/logs/wiki-dedup-sweep-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__JORI_TOOLS__/data/logs/wiki-dedup-sweep-launchd.log</string>
</dict>
</plist>
