<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  location-enrich-compose — ON-DEMAND launchd user agent (no schedule of its own).
  Playbook: agent/ops-agent/jobs/location-enrich.md

  The schedule stays in cron: agent/scripts/trigger-location-enrich.sh runs the
  gate every 15 min and, only when a stop needs a new ask, runs
  `launchctl kickstart gui/$(id -u)/ai.claude.location-enrich-compose`. The compose
  step's second rung is a tool-less `claude -p` on the Max subscription
  (lib/max-judge.js), and only the GUI session can unlock the keychain holding
  that credential — from cron it prints "Not logged in".

  Install (launchd-kick.sh also self-installs it on the first failed kick):
    agent/launch-agents/install.sh ai.claude.location-enrich-compose
    (renders __JORI_HOME__ / __JORI_TOOLS__ / __HOME__, then launchctl bootstrap)
  Run once, now:
    launchctl kickstart gui/$(id -u)/ai.claude.location-enrich-compose
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.claude.location-enrich-compose</string>
    <key>ProgramArguments</key>
    <array>
        <string>__JORI_TOOLS__/bin/cron-run</string>
        <string>--label</string>
        <string>location-enrich-compose</string>
        <string>--</string>
        <string>/bin/bash</string>
        <string>__JORI_TOOLS__/agent/scripts/run-location-enrich-compose.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:__HOME__/.local/node/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__JORI_TOOLS__/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__JORI_TOOLS__</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__JORI_TOOLS__/data/logs/location-enrich-compose-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__JORI_TOOLS__/data/logs/location-enrich-compose-launchd.log</string>
</dict>
</plist>
