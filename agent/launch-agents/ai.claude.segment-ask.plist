<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  segment-ask — ON-DEMAND launchd user agent (no schedule of its own).

  Cron keeps the schedule: agent/scripts/trigger-segment-ask.sh only runs
  `launchctl kickstart gui/$(id -u)/ai.claude.segment-ask`. The job itself
  (run-segment-ask.sh) reaches stop-passage → stop-evidence, whose fallback
  and photo-looking steps are `claude -p` on the Max subscription, and only the
  GUI session can unlock the keychain holding that credential — from cron it
  prints "Not logged in" (verified 2026-10-08).

  Install (launchd-kick.sh also self-installs it on the first failed kick):
    agent/launch-agents/install.sh ai.claude.segment-ask
    (renders __JORI_HOME__ / __JORI_TOOLS__ / __HOME__, then launchctl bootstrap)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.claude.segment-ask</string>
    <key>ProgramArguments</key>
    <array>
        <string>__JORI_TOOLS__/bin/cron-run</string>
        <string>--label</string>
        <string>segment-ask</string>
        <string>--</string>
        <string>/bin/bash</string>
        <string>__JORI_TOOLS__/agent/scripts/run-segment-ask.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:__HOME__/.local/node/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__JORI_TOOLS__/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__JORI_TOOLS__</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__JORI_TOOLS__/data/logs/segment-ask-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__JORI_TOOLS__/data/logs/segment-ask-launchd.log</string>
</dict>
</plist>
