<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- com.apple.developer.usernotifications.communication REMOVED 2026-06-27:
	     we no longer upcast pushes into communication notifications (it broke the
	     plain AirPods announce and tripped ITMS-90894). Plain notifications only. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
