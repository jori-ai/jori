<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Family Controls needs Apple's approval: it lives in
	     JoriUsageMonitor-ScreenTime.entitlements (JORI_USAGE_MONITOR_ENTITLEMENTS). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(JORI_APP_GROUP)</string>
	</array>
</dict>
</plist>
