<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.siri</key>
	<true/>
	<!-- Communication notifications (restored 2026-11-05): with this, the
	     NotificationService extension's INSendMessageIntent upcast turns a push
	     into a message from the assistant, which Siri announces on AirPods and
	     CarPlay like iMessage. Requires NSUserActivityTypes = INSendMessageIntent
	     in Info.plist (ITMS-90894) and the Communication Notifications capability
	     on the App ID. History: removed 2026-06-27 when announce stopped working
	     with it; see apps/companion/CODE-SIGNING.md. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<!-- Lets urgent proactive pings break through Driving/DND Focus. Gated:
	     only pushes sent with --urgent carry interruption-level time-sensitive. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Shared keychain group so the JoriIntents extension (separate
	     process) can read the same Supabase auth session the app wrote, and
	     insert reply/"ask Jori" messages as the authenticated user. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(JORI_BUNDLE_ID).shared</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array>
		<string>health-records</string>
	</array>
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<!-- The App Group is shared with the JoriUsageMonitor extension. Family
	     Controls (Screen Time) needs Apple's approval, so it lives in
	     Jori-ScreenTime.entitlements, which an installation selects with
	     JORI_APP_ENTITLEMENTS. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(JORI_APP_GROUP)</string>
	</array>
</dict>
</plist>
