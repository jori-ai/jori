<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(JORI_DISPLAY_NAME)</string>
	<key>CFBundleName</key>
	<string>$(JORI_DISPLAY_NAME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(JORI_URL_SCHEME).auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(JORI_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<!-- What this build is (SupabaseConfig.swift, `Install`): each value is a
	     build setting from Config/Jori.xcconfig, overridden by an
	     installation's Config/Installation.xcconfig. -->
	<key>JoriStoragePrefix</key>
	<string>$(JORI_STORAGE_PREFIX)</string>
	<key>JoriKeyTagPrefix</key>
	<string>$(JORI_KEY_TAG_PREFIX)</string>
	<key>JoriURLScheme</key>
	<string>$(JORI_URL_SCHEME)</string>
	<key>JoriAppGroup</key>
	<string>$(JORI_APP_GROUP)</string>
	<key>JoriKeychainGroup</key>
	<string>$(JORI_KEYCHAIN_GROUP)</string>
	<key>JoriSupabaseURL</key>
	<string>$(JORI_SUPABASE_URL)</string>
	<key>JoriSupabaseAnonKey</key>
	<string>$(JORI_SUPABASE_ANON_KEY)</string>
	<key>JoriAttachmentsBucket</key>
	<string>$(JORI_ATTACHMENTS_BUCKET)</string>
	<key>JoriLegacyName</key>
	<string>$(JORI_LEGACY_NAME)</string>
	<key>JoriSigningPurchase</key>
	<string>$(JORI_SIGNING_PURCHASE)</string>
	<key>JoriSigningApprove</key>
	<string>$(JORI_SIGNING_APPROVE)</string>
	<key>JoriWikiURL</key>
	<string>$(JORI_WIKI_URL)</string>
	<key>JoriTradeApprovalURL</key>
	<string>$(JORI_TRADE_APPROVAL_URL)</string>
	<key>JoriTradeApprovalNamespace</key>
	<string>$(JORI_TRADE_APPROVAL_NAMESPACE)</string>
	<key>JoriTradeApprovalLabel</key>
	<string>$(JORI_TRADE_APPROVAL_LABEL)</string>
	<key>JoriLocationDeviceId</key>
	<string>$(JORI_LOCATION_DEVICE_ID)</string>
	<key>JoriFeatures</key>
	<string>$(JORI_FEATURES)</string>
	<!--
	  The Memory tab loads the in-repo wiki HTTP browser at JORI_WIKI_URL
	  (typically an unqualified hostname on Tailscale / home LAN).
	  NSAllowsLocalNetworking permits plaintext HTTP to .local / loopback /
	  unqualified hostnames without opening up arbitrary internet traffic.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Siri usage description retained for the "Summon Jori" App Shortcut
	     (App Intents). The SiriKit messaging declarations (NSUserActivityTypes =
	     INSendMessageIntent) were removed: they reclassified the app as a
	     messaging provider once Siri was authorized, which broke the plain
	     AirPods announcement. -->
	<key>NSSiriUsageDescription</key>
	<string>Lets you talk to Jori with Siri — "Hey Siri, Summon Jori".</string>
	<!-- iOS launch screen: the Jori face on its navy, centred at 160 pt, the
	     same place SplashView (DesignSystem.swift) draws it, so the hand-over
	     from the system launch image has no seam. macOS ignores the key. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>JoriBlue</string>
		<key>UIImageName</key>
		<string>JoriFace</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
