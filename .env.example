# Jori environment — copy to `.env` (gitignored) and fill in, or run
# `./bin/jori init`, which writes it for you. process-manager.mjs loads this
# file into every process it starts (supervisors, Claude sessions, MCP servers
# whose configs use ${VAR} placeholders); cron and launchd scripts read it too.
#
# Identity (owner name, emails, time zone, project ids) lives in
# agent/local/instance.json (template: examples/local/instance.example.json).
# Each identity key also has a JORI_* variable below that overrides it —
# handy for tests or a second host; you don't need both.
#
# [required] the stack does not start or misbehaves without it
# [optional] a feature is off until you set it
# [override] has a working default; set it only to change that

# ─── Where Jori lives ──────────────────────────────────────────────────
# [required] Absolute path of this checkout (no trailing slash). Defaults to
# $HOME/Dev/jori; the MCP configs (agent/supervisor/chat-mcp-config.json,
# agent/ops-*-agent/.mcp.json) expand ${JORI_HOME}, so keep it set here.
JORI_HOME=
# [override] The per-installation dir (default: $JORI_HOME/agent/local).
# JORI_LOCAL_DIR=
# [override] The dir Claude Code sessions start from, which names the
# auto-memory dir ~/.claude/projects/<slug>/memory (default: ~/Dev/jori).
# JORI_PROJECT_DIR=
# [override] Data dir for a few hum helpers (default: $JORI_HOME/data).
# JORI_DATA_DIR=
# [override] Root the launchd templates render against (default: JORI_HOME).
# JORI_LAUNCHD_ROOT=

# ─── Anthropic auth (pick ONE) ───────────────────────────────────────────
# The supervisors run `claude -p` on a Claude Code login (Max subscription)
# and hide ANTHROPIC_API_KEY from those children on purpose. Authenticate
# `claude` once on this host. The API key is for direct API callers such as
# `jori review-pr`; when it is set, jori-cost-report treats costs as
# API-billed rather than subscription estimates.
# [optional]
ANTHROPIC_API_KEY=
# [optional] Separate, budget-capped key for the wiki's API fallback when the
# subscription is exhausted (lib/api-fallback.mjs).
# JORI_WIKI_API_KEY=
# [override] Model ids (defaults in agent/config/models.env).
# JORI_MODEL_OPUS=
# JORI_MODEL_SONNET=

# ─── Webhook channel ─────────────────────────────────────────────────────
# [required] Bearer token the supervisors' webhooks check. `jori init` writes
# a random one to secrets/webhook-token, which scripts read first; this
# variable is the fallback.
WEBHOOK_TOKEN=

# ─── Identity (overrides agent/local/instance.json) ──────────────────────
# JORI_OWNER_NAME=            # how the agents address you   (owner_name)
# JORI_OWNER_ID=              # identifier form, e.g. "alex" (owner_id)
# JORI_OWNER_EMAIL=           # your primary email           (owner_email)
# JORI_AGENT_FROM_EMAIL=      # From: of agent-sent mail     (agent_email)
# JORI_DOMAIN=                # your domain                  (domain)
# JORI_TZ=                    # IANA zone; default: host's   (tz)
# JORI_HOST=                  # this host's name             (host)
# JORI_OWNER=                 # GitHub user/org of your fork (github_owner)
# JORI_SUPABASE_PROJECT=      # Supabase project ref         (supabase_project)
# JORI_GCP_PROJECT=           # GCP project for Gmail push   (gcp_project)

# ─── Supabase (phone channel, companion apps, push) ──────────────────────
# [optional] Without these the phone channel and companion apps are off.
# SUPABASE_URL defaults to https://<supabase_project>.supabase.co.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# [optional] Public anon key; preferred home: agent/local/config/supabase.json.
SUPABASE_ANON_KEY=
# [optional] Management API token for the Supabase MCP server.
SUPABASE_ACCESS_TOKEN=
# [override] Chat recall's Supabase URL, when different from SUPABASE_URL.
# JORI_SUPABASE_URL=

# ─── Gmail (push intake, triage) ─────────────────────────────────────────
# [optional] OAuth client for agent/scripts/gmail-auth.mjs; see
# docs/integrations/gmail.md.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# [override] Public host Pub/Sub pushes to (default: gmail-push.<domain>).
# JORI_PUSH_HOST=
# [optional] Keyring password for the gog Google CLI (calendar, tasks).
# GOG_KEYRING_PASSWORD=

# ─── Outbound mail and messaging ─────────────────────────────────────────
# [optional] SMTP2Go API key for bin/email-send (docs/integrations/smtp.md).
SMTP2GO_API_KEY=
# [optional] Your own WhatsApp number, for bin/whatsapp-send.
# WHATSAPP_OWNER_NUMBER=
# [optional] APNs push for the companion app (or agent/local/config/apns.json).
# JORI_APNS_KEY_ID=
# JORI_APNS_TEAM_ID=
# JORI_APNS_BUNDLE_ID=

# ─── Local LLM (Ollama) ──────────────────────────────────────────────────
# [override] Local classification and embeddings.
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=gemma3:1b
LOCAL_EMBED_MODEL=nomic-embed-text

# ─── Judgment service (docs/jev.md) ──────────────────────────────────────
# [optional] Without it the Jev gates stay in their local/shadow paths.
# TYPESAFE_API_KEY=

# ─── Memory wiki over the network ────────────────────────────────────────
# [optional] Cloudflare Access in front of the wiki server (lib/wiki-access.js).
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=

# ─── Optional installation CLIs (see bin/_ext/.gitkeep) ──────────────────
# JORI_WEATHER_BIN=           # JSON weather for the weather sensor
# JORI_TRAVEL_BIN=            # itinerary CLI: is the user in <city> on <date>? (event geo-gate)
# JORI_HEADLINER_BIN=         # must-see-performer check that bypasses the geo-gate
# JORI_CI_SIGNING_TARGETS=    # repo:workflow pairs bin/ci-keychain-lock-audit checks

# ─── Operator switches (leave unset normally) ────────────────────────────
# JORI_INFRA_PROBE=1          # allow system-channel sends from an unsandboxed probe
# JORI_PRECHECK_BYPASS=1      # let a chat send skip the outbound precheck
# JORI_P1_ALERT_GATE=1        # bypass the P1 alert gate in jori-send-curl
# JORI_ALERT_NO_DEDUP=1       # send a repeated system alert anyway
# Test seams (override state-file paths): JORI_SEND_SPOOL, JORI_PING_QUEUE,
# JORI_PING_MEDIA_FILE, JORI_REPLY_FILE_DIR, JORI_SUPERSEDED_REPLIES,
# JORI_FORK_COST_LEDGER, JORI_CHOICE_HANDLERS, JORI_CONTEXT_OVERLAY.
# Set by the stack itself, never here: JORI_ROOT, JORI_TOOLS,
# JORI_INSTALL, JORI_INSTALL_TOOLS, JORI_KERNEL_SUBDIR, JORI_AGENT_ID,
# JORI_PHONE_PRIMARY, JORI_DISPATCH_URL, JORI_JOB, JORI_JOB_CHAIN,
# JORI_TASK_ID, JORI_TRIAGE_ACTOR, JORI_FORK_CONNECTOR_DENY,
# JORI_FORK_SKILL_SETTINGS.

# ─── Telemetry ───────────────────────────────────────────────────────────
# [override] One anonymous first-run install ping (no PII, no raw IP; payload
# in apps/telemetry/README.md). `jori init` asks and writes on|off here;
# change it any time with `jori telemetry on|off`.
JORI_TELEMETRY=on
# Hard kill switch: set to 1 in the environment and no ping is ever sent,
# whatever JORI_TELEMETRY says (CI, ephemeral installs).
# JORI_NO_TELEMETRY=1
# A fork's own deployment of apps/telemetry/.
# JORI_TELEMETRY_URL=https://jori-telemetry.vercel.app/install
# [optional] Private operator telemetry: lets `jori-cost-report --push`
# (task usage-push) send per-day usage rollups to the hosted /usage endpoint.
# Not anonymous, so the endpoint refuses it without a token. Leave unset unless
# you run your own apps/telemetry deployment. Falls back to STATS_TOKEN.
# JORI_USAGE_TOKEN=
# JORI_USAGE_URL=

# ─── Sanitize guard (contributors) ───────────────────────────────────────
# Path to your private identity-pattern list for .tools/sanitize-guard.py
# (default: agent/local/sanitize-patterns.json; template:
# examples/sanitize-patterns.example.json).
# JORI_SANITIZE_PATTERNS=
